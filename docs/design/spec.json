  "scale": {
    "value": 1.5,
    "status": "confirmed",
    "evidence": "At 1.5 the unrotated measurements land on whole logical px: tape 113.0 x 33.1, stripe pitch 16.0, toolbar button 40.04 x 40.04, toolbar icons 16 x 16 (B). At 1.25 they do not (135.6, 39.8, 19.2, 48.06); at 2.0 they are 84.75, 24.85, 12.0, 30.04 (less round). Paper width is 362.9 at 1.5, which matches the 360 minimum width decision; at 2.0 it would be 272. Geometry alone cannot separate 1.5 from 2.0, so the choice rests on that and on 150% being the stated assumption.",
    "mockup_px_per_logical_px": 1.5
  },
  "paper_tilt_deg": {
    "value": 1.5,
    "measured": "all four fitted edges give 1.50 (hover and idle)",
    "direction": "clockwise"
  },
  "text_tilt_deg": {
    "value": 1.45,
    "text_is_tilted": true,
    "flag": "The text is NOT level. Baselines slope at 1.45 deg (1.55 on one body line) with the paper, and every line's left ink edge sits at the same distance from the paper's tilted left edge (u = 32 to 34 logical px). The whole text block is rotated with the paper, so the plan's 'only the paper path is tilted' case does not hold. STEP_BY_STEP Step 3: check Slint transform-rotation support for a subtree containing a TextInput in the software renderer before building the note component."
  },
  "paper_corner_radius_px": {
    "value": 1,
    "note": "Measured 1.18 (hover) and 0.76 (idle) mockup px: effectively square corners (a 1 px AA rounding). Do not round the paper corners."
  },
