import { Theme } from "theme.slint";
import { BlockData, RuleData, RunData } from "block.slint";
import { PaperTheme } from "paper-theme.slint";
import { Paper, Tapes } from "paper.slint";
import { TextLayer } from "text.slint";

export { BlockData, BlockKind, RuleData, RunData } from "block.slint";
export { Theme } from "theme.slint";
import { Toolbar, ToolbarMetrics } from "toolbar.slint";
import { WindowHandles } from "resize-zones.slint";
import { ScrollBar, ScrollMetrics } from "scroll.slint";

export component NoteWindow inherits Window {
    // Taskbar button text and thumbnail tooltip: the note's title, or "Washi" when empty.
    in property <string> window-title: "Washi";
    in property <bool> pinned: false;
    in property <image> app-icon;
    title: window-title;
    always-on-top: pinned;
    icon: app-icon;
    // The window is the paper plus a fixed transparent margin on every side.
    no-frame: true;
    background: transparent;
    preferred-width: PaperTheme.paper-default-width + 2 * PaperTheme.margin;
    preferred-height: PaperTheme.paper-default-height + 2 * PaperTheme.margin;
    min-width: PaperTheme.paper-min-width + 2 * PaperTheme.margin;
    min-height: PaperTheme.paper-min-height + 2 * PaperTheme.margin;

    /// The note's stored text, kept by the app; `blocks` is the same text split into styled blocks.
    in property <string> text;
    in property <[BlockData]> blocks;
    /// The same text as upright words on the tilted baseline (shown at rest), laid out by Rust.
    in property <[RunData]> runs;
    /// Underlines, strike-throughs and list bullets, to be drawn with the words.
    in property <[RuleData]> rules;
    /// The formats of the paragraph holding the caret (the toolbar buttons' active state).
    in property <bool> fmt-bold: false;
    in property <bool> fmt-italic: false;
    in property <bool> fmt-underline: false;
    in property <bool> fmt-strike: false;
    in property <bool> fmt-list: false;
    /// Format the paragraph holding the caret: 0 bold, 1 italic, 2 underline, 3 strike, 4 list
    /// (a toolbar button or its shortcut).
    callback format(int);
    /// A text field took the focus: the caret is in this block.
    callback focus-entered(int);
    /// The paper (window minus margins) changed size: Rust lays the words out again.
    callback paper-resized(length, length);
    changed width => { root.paper-resized(root.width - 2 * root.margin, root.height - 2 * root.margin); }
    changed height => { root.paper-resized(root.width - 2 * root.margin, root.height - 2 * root.margin); }
    /// 1 at rest (words on the tilted baseline), 0 while editing (level).
    out property <float> text-tilt-scale: text-layer.tilt-scale;
    /// The block whose field has the focus (-1 none). Rust clears it when it replaces the blocks.
    in-out property <int> text-focused-block <=> text-layer.focused-block;
    /// Suspended (covered, minimized): the look must not change, so no redraw is asked for.
    in property <bool> suspended: false;
    in-out property <int> text-resync: 0;
    /// Block `i` was edited to this text.
    callback block-edited(int, string, int);
    /// Enter, Backspace, Delete, Up or Down in block `i` at the caret offset; true when taken.
    callback block-key(int, string, int) -> bool;
    /// Rust asks a block to take the focus (block, caret offset, request counter).
    in-out property <int> focus-block: -1;
    in-out property <int> focus-offset: 0;
    in-out property <int> focus-serial: 0;
    /// The text's height (Rust lays it out) and how far it is scrolled up; the wheel changes it.
    in property <length> content-height;
    in-out property <length> scroll-y: 0px;
    /// The height of the text area (it ends above the toolbar band).
    out property <length> text-view-height: text-view.height;
    /// The caret moved to this byte offset of this block (Rust keeps it in view).
    callback caret-moved(int, int);
    property <length> max-scroll: max(0px, root.content-height - text-view.height);
    changed max-scroll => { if (root.scroll-y > root.max-scroll) { root.scroll-y = root.max-scroll; } }
    /// Opacity of the scrollbar (0 unless hovered and the text overflows).
    out property <float> scrollbar-opacity: scrollbar.bar-opacity;
    /// Right click on the paper, in window coordinates.
    callback context-menu(length, length);
    /// The mouse moved over the paper (the app wakes from suspension).
    callback pointer-moved();
    /// The user pressed the pink tape or the top margin: the platform drags the window.
    callback start-move();
    /// The user pressed a resize zone (0 north, then clockwise: see resize-zones.slint).
    callback start-resize(int);
    callback new-note();
    callback close-note();
    callback delete-note();
    /// The toolbar's image button was clicked.
    callback insert-image();
    /// Ctrl+V: true when the note took it because the clipboard held a picture.
    callback paste-image() -> bool;
    out property <int> last-focused-block <=> text-layer.last-focused;

    // The toolbar shows while the pointer is over the note (anywhere, text included) or holds one
    // of its buttons. Keyboard focus never shows it. The band is reserved either way.
    out property <float> toolbar-opacity: toolbar.opacity;
    out property <bool> toolbar-visible: toolbar.visible;
    property <length> margin: PaperTheme.margin;
    /// The transparent margin around the paper (Rust keeps the paper on screen, not the margin).
    out property <length> window-margin: PaperTheme.margin;
    property <angle> tilt: PaperTheme.paper-tilt;
    // The paper's untilted box in the window (the margin on every side).
    property <length> paper-top: PaperTheme.margin;
    property <length> paper-bottom: root.height - PaperTheme.margin;

    // Shadow and paper (the look: see paper.slint). Behind everything.
    Paper { width: root.width; height: root.height; }

    // The whole note: it holds everything, so `has-hover` stays true over the editor and the
    // toolbar too (ADR 0001). The editor ignores the right button, so a right click anywhere
    // reaches this.
    paper-touch := TouchArea {
        scroll-event(e) => {
            if (root.max-scroll <= 0px) { return reject; }
            root.scroll-y = max(0px, min(root.max-scroll, root.scroll-y - e.delta-y));
            accept
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.pointer-moved(); }
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }

        FocusScope {
            key-pressed(e) => {
                if (e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt) {
                    if (e.text == "n" || e.text == "\u{e}") { root.new-note(); return accept; }
                    if (e.text == "w" || e.text == "\u{17}") { root.close-note(); return accept; }
                    if (e.text == "d" || e.text == "\u{4}") { root.delete-note(); return accept; }
                    if ((e.text == "v" || e.text == "\u{16}") && root.paste-image()) { return accept; }
                    if (e.text == "b" || e.text == "\u{2}") { root.format(0); return accept; }
                    if (e.text == "i" || e.text == "\u{9}") { root.format(1); return accept; }
                    if (e.text == "u" || e.text == "\u{15}") { root.format(2); return accept; }
                }
                if (e.modifiers.control && e.modifiers.shift && !e.modifiers.alt) {
                    if (e.text == "x" || e.text == "X" || e.text == "\u{18}") { root.format(3); return accept; }
                    if (e.text == "l" || e.text == "L" || e.text == "\u{c}") { root.format(4); return accept; }
                }
                reject
            }

            // The text area ends where the toolbar band begins, so text never sits under the toolbar.
            // The text layer is laid out in the paper's frame (fixed insets from its top-left corner).
            text-view := Rectangle {
                x: root.margin;
                y: root.paper-top;
                width: root.width - 2 * root.margin;
                // The tilted band's top edge rises by half the paper width times sin(tilt) at the left;
                // text may not reach into it, and a level clip cannot follow the tilt.
                height: root.paper-bottom - ToolbarMetrics.band-height - Theme.text-bottom-gap - root.paper-top - (root.width - 2 * root.margin) / 2 * root.tilt.sin();
                clip: true;

                text-layer := TextLayer {
                    x: 0px;
                    y: -root.scroll-y;
                    width: root.width - 2 * root.margin;
                    // at least the text's height, or the blocks' layout would squeeze them together
                    height: max(root.paper-bottom - root.paper-top, root.content-height);
                    blocks: root.blocks;
                    runs: root.runs;
                    rules: root.rules;
                    focus-entered(i) => { root.focus-entered(i); }
                    suspended: root.suspended;
                    resync: root.text-resync;
                    focus-block: root.focus-block;
                    focus-offset: root.focus-offset;
                    focus-serial: root.focus-serial;
                    paste-image => { return root.paste-image(); }
                    block-edited(i, t, c) => { root.block-edited(i, t, c); }
                    block-key(i, k, o) => { return root.block-key(i, k, o); }
                    caret-moved(i, o) => { root.caret-moved(i, o); }
                }
            }
        }

        // The scrollbar: level, in the right inset of the text area, over the text.
        scrollbar := ScrollBar {
            x: root.margin + root.width - 2 * root.margin - ScrollMetrics.bar-right;
            y: root.paper-top;
            width: ScrollMetrics.bar-width;
            height: text-view.height;
            view: text-view.height;
            content: root.content-height;
            offset: root.scroll-y;
            shown: paper-touch.has-hover;
        }

        // Invisible grips for moving and resizing (inside paper-touch, so hovering them keeps the
        // toolbar up). Above the editor; none of them reaches into the text area.
        WindowHandles {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            start-move => { root.start-move(); }
            start-resize(d) => { root.start-resize(d); }
            right-click(x, y) => { root.context-menu(x, y); }
            pointer-over => { root.pointer-moved(); }
        }

        // Drawn in the paper's frame, which tilts with the paper. Above the editor, so its buttons
        // get the clicks while shown; while hidden it takes no part in hit testing at all.
        toolbar := Toolbar {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            paper-x: root.margin;
            paper-y: root.paper-top;
            paper-w: root.width - 2 * root.margin;
            paper-h: root.height - 2 * root.margin;
            tilt: root.tilt;
            bold-active: root.fmt-bold;
            italic-active: root.fmt-italic;
            underline-active: root.fmt-underline;
            strike-active: root.fmt-strike;
            list-active: root.fmt-list;
            activated(k) => { if (k < 5) { root.format(k); } else { root.insert-image(); } }
            opacity: (paper-touch.has-hover || self.any-pressed) ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: ToolbarMetrics.fade; easing: ease-out; }
        }
    }

    // The tapes lie over the paper.
    Tapes { width: root.width; height: root.height; }
}
