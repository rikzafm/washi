import { Theme } from "theme.slint";
import { BlockData } from "block.slint";
import { TextLayer } from "text.slint";

export { BlockData, BlockKind } from "block.slint";

// Walking-skeleton note: unstyled paper. Real styling arrives with the paper/theme tickets.
export component NoteWindow inherits Window {
    // Taskbar button text and thumbnail tooltip: the note's title, or "Washi" when empty.
    in property <string> window-title: "Washi";
    in property <bool> pinned: false;
    in property <image> app-icon;
    title: window-title;
    always-on-top: pinned;
    icon: app-icon;
    preferred-width: 431px;
    preferred-height: 451px;
    min-width: 200px;
    min-height: 200px;
    background: #fdfaf0;

    /// The note's stored text, kept by the app; `blocks` is the same text split into styled blocks.
    in property <string> text;
    in property <[BlockData]> blocks;
    /// Block `i` was edited to this text.
    callback block-edited(int, string);
    /// Right click on the paper, in window coordinates.
    callback context-menu(length, length);
    /// The mouse moved over the paper (the app wakes from suspension).
    callback pointer-moved();
    callback new-note();
    callback close-note();
    callback delete-note();

    // Behind the editor: the paper and tapes. The editor ignores the right button, so a
    // right click anywhere reaches this.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.pointer-moved(); }
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }
    }

    FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt) {
                if (e.text == "n" || e.text == "\u{e}") { root.new-note(); return accept; }
                if (e.text == "w" || e.text == "\u{17}") { root.close-note(); return accept; }
                if (e.text == "d" || e.text == "\u{4}") { root.delete-note(); return accept; }
            }
            reject
        }

        // The text sits on the paper: the window minus the fixed margin on every side.
        TextLayer {
            x: Theme.window-margin;
            y: Theme.window-margin;
            width: root.width - 2 * Theme.window-margin;
            height: root.height - 2 * Theme.window-margin;
            blocks: root.blocks;
            block-edited(i, t) => { root.block-edited(i, t); }
        }
    }
}
