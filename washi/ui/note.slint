import { Theme } from "theme.slint";
import { BlockData, MarkerData, RuleData, RunData, SelRect } from "block.slint";
import { PaperTheme } from "paper-theme.slint";
import { Paper, Tapes } from "paper.slint";
import { TextLayer } from "text.slint";

export { BlockData, BlockKind, MarkerData, RuleData, RunData } from "block.slint";
export { Theme } from "theme.slint";
export { CaptionPiece, ImageViewerWindow } from "viewer.slint";
export { DropdownMenuWindow, DropdownNoteItem } from "dropdown.slint";
export { AllNotesWindow, AllNoteItem } from "all-notes.slint";
export { DeleteNoteDialog } from "delete-dialog.slint";
export { PaletteEntry, PickerPalette } from "color-picker.slint";
import { Toolbar, ToolbarMetrics, MenuButton } from "toolbar.slint";
import { ColorPicker, ColorPickerNav, PickerPalette } from "color-picker.slint";
import { WindowHandles } from "resize-zones.slint";
import { ScrollBar, ScrollMetrics } from "scroll.slint";

export component NoteWindow inherits Window {
    /// Dropdown menu active state and callback.
    in-out property <bool> dropdown-open: false;
    callback open-dropdown();
    out property <bool> menu-button-active: menu-btn.active;
    out property <bool> menu-button-highlighted: menu-btn.highlighted;
    out property <bool> menu-button-shown: root.dropdown-open || paper-touch.has-hover || menu-btn.has-hover;
    out property <float> menu-button-opacity: menu-btn.opacity;
    out property <length> menu-button-x: menu-btn.center-x - ToolbarMetrics.menu-button-width / 2;
    out property <length> menu-button-y: menu-btn.center-y - ToolbarMetrics.menu-button-height / 2;
    out property <length> menu-button-width: ToolbarMetrics.menu-button-width;
    out property <length> menu-button-height: ToolbarMetrics.menu-button-height;

    // Taskbar button text and thumbnail tooltip: the note's title, or "Washi" when empty.
    in property <string> window-title: "Washi";
    in property <bool> pinned: false;
    /// Fade the text into the paper above the toolbar (false: cut it cleanly).
    in property <bool> fade-edge: true;
    in property <image> app-icon;
    title: window-title;
    always-on-top: pinned;
    icon: app-icon;
    // The window is the paper plus a fixed transparent margin on every side.
    no-frame: true;
    background: transparent;
    preferred-width: PaperTheme.paper-default-width + 2 * PaperTheme.margin;
    preferred-height: PaperTheme.paper-default-height + 2 * PaperTheme.margin;
    min-width: PaperTheme.paper-min-width + 2 * PaperTheme.margin;
    min-height: PaperTheme.paper-min-height + 2 * PaperTheme.margin;

    /// The note's stored text, kept by the app; `blocks` is the same text split into styled blocks.
    in property <string> text;
    in property <[BlockData]> blocks;
    /// The same text as upright words on the tilted baseline (shown at rest), laid out by Rust.
    in property <[RunData]> runs;
    /// Underlines, strike-throughs and list bullets, to be drawn with the words.
    in property <[RuleData]> rules;
    /// The wash of the selection (Rust): a level box for each line it touches.
    in property <[SelRect]> sel-rects;
    /// A selected picture's frame and its resize grip (Rust): two level boxes, or none.
    in property <[SelRect]> image-handles;
    /// A right click on the text, in the text layer's frame (sent just before `context-menu`).
    callback text-right-click(length, length);
    /// The markers behind colored text, and where the selection's wash meets them (Rust).
    in property <[MarkerData]> markers;
    in property <[SelRect]> marker-wash;
    /// Ctrl+A: Rust sets the selection to the whole note.
    callback select-all();
    /// The formats of the selection, or of what is typed at the caret (the toolbar buttons' active state).
    in property <bool> fmt-bold: false;
    in property <bool> fmt-italic: false;
    in property <bool> fmt-underline: false;
    in property <bool> fmt-strike: false;
    in property <bool> fmt-list: false;
    /// Format the selected text (0 bold, 1 italic, 2 underline, 3 strike), or the paragraph holding
    /// the caret (4 list): a toolbar button or its shortcut.
    callback format(int);
    /// The ink and marker index of the selection (marker -1 mixed); drive the "A" button and the rings.
    in property <int> fmt-ink: 0;
    in property <int> fmt-marker: 0;
    /// The color popover is open. It closes on Escape, a click elsewhere, losing the focus,
    /// minimising, resizing and typing; opening it never moves the focus.
    in-out property <bool> picker-open: false;
    /// The swatch the keyboard has reached: -1 none (no ring), 0..9 an ink dot, 10..19 a marker chip.
    in-out property <int> picker-focus: -1;
    changed picker-open => { if (!root.picker-open) { root.picker-focus = -1; } }
    /// The popover's caption: the summary of the selection's colors, or the hovered swatch's name.
    out property <string> picker-caption: color-picker.caption;
    /// The "A" button is filled while the popover is open or the selection has a color (-1, mixed,
    /// counts: some of it is colored).
    out property <bool> color-button-filled: root.picker-open || root.fmt-ink != 0 || root.fmt-marker != 0;
    /// A swatch was picked (0..9), or Clear: Rust applies it to the selection.
    callback pick-ink(int);
    callback pick-marker(int);
    callback clear-color();
    /// A text field took the focus: the caret is in this block.
    callback focus-entered(int);
    /// The paper (window minus margins) changed size: Rust lays the words out again.
    callback paper-resized(length, length);
    changed width => { root.picker-open = false; root.paper-resized(root.width - 2 * root.margin, root.height - 2 * root.margin); }
    changed height => { root.picker-open = false; root.paper-resized(root.width - 2 * root.margin, root.height - 2 * root.margin); }
    /// 1 at rest (words on the tilted baseline), 0 while editing (level).
    out property <float> text-tilt-scale: text-layer.tilt-scale;
    /// The block whose field has the focus (-1 none). Rust clears it when it replaces the blocks.
    in-out property <int> text-focused-block <=> text-layer.focused-block;
    changed text-focused-block => { if (root.text-focused-block < 0) { root.picker-open = false; } }
    /// Suspended (covered, minimized): the look must not change, so no redraw is asked for.
    in property <bool> suspended: false;
    changed suspended => { if (root.suspended) { root.picker-open = false; } }
    in property <float> pitch-scale: 1;
    in-out property <int> text-resync: 0;
    /// Block `i` was edited to this text.
    callback block-edited(int, string, int);
    /// Enter, Backspace, Delete, Up or Down in block `i` at the caret offset; true when taken.
    callback block-key(int, string, int) -> bool;
    /// Rust asks a block to take the focus (block, caret offset, request counter).
    in-out property <int> focus-block: -1;
    in-out property <int> focus-offset: 0;
    in-out property <int> focus-serial: 0;
    /// With that request: the selection's other end (-1 none), and whether the fields draw their
    /// own selection (false while a selection across blocks is drawn from `sel-rects`).
    in-out property <int> focus-anchor: -1;
    in-out property <bool> wash: true;
    /// The note owns the pointer (see text.slint): Rust turns these into the selection.
    callback pointer-down(length, length, bool);
    callback pointer-drag(length, length);
    callback pointer-up();
    /// The text's height (Rust lays it out) and how far it is scrolled up; the wheel changes it.
    in property <length> content-height;
    in-out property <length> scroll-y: 0px;
    in-out property <bool> scrolling: false;
    callback scroll-activity();
    changed scroll-y => {
        if (root.max-scroll > 0px && !scrollbar.dragging && !root.suspended) {
            root.scrolling = true;
            root.scroll-activity();
        }
    }
    property <length> tilt-allowance: abs((root.width - 2 * root.margin) / 2 * root.tilt.sin());
    /// The height of the text area (it ends above the toolbar band).
    out property <length> text-view-height: root.paper-bottom - root.paper-top - ToolbarMetrics.band-height - Theme.text-bottom-gap - 2 * root.tilt-allowance;
    /// Where the text layer's top is in the text area (minus the scroll): a pointer's place in the
    /// text area is its place in the layer plus this.
    out property <length> text-layer-y: text-layer.y;
    /// The caret moved to this byte offset of this block, the selection's other end at the last
    /// (Rust keeps the caret in view and shows the selection's formats).
    callback caret-moved(int, int, int);
    // What the note scrolls through: the app's layout, or the edit fields if they run longer.
    property <length> content: max(root.content-height, text-layer.fields-bottom);
    property <length> max-scroll: max(0px, root.content - root.text-view-height);
    changed max-scroll => { if (root.scroll-y > root.max-scroll) { root.scroll-y = root.max-scroll; } }
    /// Opacity of the scrollbar (0 unless actively scrolling, hovered, or dragged while overflowing).
    out property <float> scrollbar-opacity: scrollbar.bar-opacity;
    out property <length> scrollbar-thumb-x: scrollbar.thumb-x;
    out property <length> scrollbar-thumb-y: scrollbar.thumb-y;
    /// Right click on the paper, in window coordinates.
    callback context-menu(length, length);
    /// The mouse moved over the paper (the app wakes from suspension).
    callback pointer-moved();
    /// The user pressed either tape: the platform drags the window.
    callback start-move();
    /// The user pressed a resize zone (0 north, then clockwise: see resize-zones.slint).
    callback start-resize(int);
    callback new-note();
    callback close-note();
    callback delete-note();
    /// The toolbar's image button was clicked.
    callback insert-image();
    /// Ctrl+C: copy image block to clipboard.
    callback copy-image(int) -> bool;
    /// Ctrl+X: cut image block to clipboard.
    callback cut-image(int) -> bool;
    /// Ctrl+V: true when the note took it because the clipboard held a picture.
    callback paste-image() -> bool;
    /// The selection across blocks as plain lines, to copy it.
    callback range-text() -> string;
    /// Copy the range (rich HTML and plain text).
    callback copy-range() -> bool;
    /// Cut the range (rich HTML and plain text).
    callback cut-range() -> bool;
    /// Paste rich content into the range.
    callback paste-range() -> bool;
    /// Replace the selection across blocks by this text.
    callback range-replace(string);
    /// A key over a selection across blocks (its text, Shift held): 0 not taken, 1 taken without a
    /// change, 2 replaced the selection.
    callback range-key(string, bool) -> int;
    out property <int> last-focused-block <=> text-layer.last-focused;

    // The toolbar shows while the pointer is over the note (anywhere, text included) or holds one
    // of its buttons. Keyboard focus never shows it. The band is reserved either way.
    out property <float> toolbar-opacity: toolbar.opacity;
    out property <bool> toolbar-visible: toolbar.visible;
    property <length> margin: PaperTheme.margin;
    /// The transparent margin around the paper (Rust keeps the paper on screen, not the margin).
    out property <length> window-margin: PaperTheme.margin;
    property <angle> tilt: PaperTheme.paper-tilt;
    // The paper's untilted box in the window (the margin on every side).
    property <length> paper-top: PaperTheme.margin;
    property <length> paper-bottom: root.height - PaperTheme.margin;

    // Shadow and paper (the look: see paper.slint). Behind everything.
    Paper { width: root.width; height: root.height; }

    // The whole note: it holds everything, so `has-hover` stays true over the editor and the
    // toolbar too (ADR 0001). The editor ignores the right button, so a right click anywhere
    // reaches this.
    paper-touch := TouchArea {
        scroll-event(e) => {
            if (root.max-scroll <= 0px) { return reject; }
            root.scroll-y = max(0px, min(root.max-scroll, root.scroll-y - e.delta-y));
            root.scrolling = true;
            root.scroll-activity();
            accept
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.pointer-moved(); }
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }

        FocusScope {
            // While the popover is open its keys are taken here, before the focused text field sees
            // them: the field keeps the focus, the caret and the range, and the popover has no
            // focus of its own (its hit areas never take it). Space and Enter pick only once an
            // arrow has put the focus ring on a swatch; before that they stay plain typing.
            capture-key-pressed(e) => {
                if (!root.picker-open || e.modifiers.control || e.modifiers.alt || e.modifiers.meta || e.modifiers.shift) { return reject; }
                if (e.text == Key.LeftArrow || e.text == Key.RightArrow || e.text == Key.UpArrow || e.text == Key.DownArrow) {
                    root.picker-focus = ColorPickerNav.step(root.picker-focus, e.text);
                    return accept;
                }
                if ((e.text == Key.Return || e.text == " ") && root.picker-focus >= 0) {
                    if (root.picker-focus < 10) { root.pick-ink(root.picker-focus); } else { root.pick-marker(root.picker-focus - 10); }
                    return accept;
                }
                reject
            }
            key-pressed(e) => {
                if (e.text == Key.Escape && root.picker-open) { root.picker-open = false; return accept; }
                if (e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt) {
                    if (e.text == "n" || e.text == "\u{e}") { root.new-note(); return accept; }
                    if (e.text == "w" || e.text == "\u{17}") { root.close-note(); return accept; }
                    if (e.text == "d" || e.text == "\u{4}") { root.delete-note(); return accept; }
                    if ((e.text == "v" || e.text == "\u{16}") && root.paste-image()) { return accept; }
                    if (e.text == "b" || e.text == "\u{2}") { root.format(0); return accept; }
                    if (e.text == "i" || e.text == "\u{9}") { root.format(1); return accept; }
                    if (e.text == "u" || e.text == "\u{15}") { root.format(2); return accept; }
                }
                if (e.modifiers.control && e.modifiers.shift && !e.modifiers.alt) {
                    if (e.text == "x" || e.text == "X" || e.text == "\u{18}") { root.format(3); return accept; }
                    if (e.text == "l" || e.text == "L" || e.text == "\u{c}") { root.format(4); return accept; }
                }
                reject
            }

            // The text area ends where the toolbar band begins, so text never sits under the toolbar.
            // The text layer is laid out in the paper's frame (fixed insets from its top-left corner).
            text-view := Rectangle {
                x: root.margin;
                // The tilted paper's top edge rises by half the paper width times sin(tilt) at the left.
                // The clip starts at the highest point of the tilted top edge so images and text can reach the tilted edge.
                y: root.paper-top - root.tilt-allowance;
                width: root.width - 2 * root.margin;
                // The tilted band's top edge rises by the same amount at the left;
                // text may not reach into it, and a level clip cannot follow the tilt.
                height: root.paper-bottom - ToolbarMetrics.band-height - Theme.text-bottom-gap - self.y - root.tilt-allowance;
                clip: true;

                text-layer := TextLayer {
                    x: 0px;
                    y: -root.scroll-y - (text-view.y - root.paper-top);
                    width: root.width - 2 * root.margin;
                    // at least the text's height, or the blocks' layout would squeeze them together
                    height: max(root.paper-bottom - root.paper-top, root.content);
                    paper-w: root.width - 2 * root.margin;
                    paper-h: root.height - 2 * root.margin;
                    tilt: root.tilt;
                    scroll-y: root.scroll-y;
                    pitch-scale: root.pitch-scale;
                    blocks: root.blocks;
                    runs: root.runs;
                    rules: root.rules;
                    sel-rects: root.sel-rects;
                    image-handles: root.image-handles;
                    layer-right-click(x, y) => { root.text-right-click(x, y); }
                    markers: root.markers;
                    marker-wash: root.marker-wash;
                    select-all => { root.select-all(); }
                    focus-entered(i) => { root.focus-entered(i); }
                    suspended: root.suspended;
                    resync: root.text-resync;
                    focus-block: root.focus-block;
                    focus-offset: root.focus-offset;
                    focus-serial: root.focus-serial;
                    focus-anchor: root.focus-anchor;
                    wash: root.wash;
                    pointer-down(x, y, shift) => { root.picker-open = false; root.pointer-down(x, y, shift); }
                    pointer-drag(x, y) => { root.pointer-drag(x, y); }
                    pointer-up => { root.pointer-up(); }
                    right-click(x, y) => { root.context-menu(x, y); }
                    pointer-moved => { root.pointer-moved(); }
                    paste-image => { return root.paste-image(); }
                    copy-image(i) => { return root.copy-image(i); }
                    cut-image(i) => { return root.cut-image(i); }
                    range-text => { return root.range-text(); }
                    copy-range => { return root.copy-range(); }
                    cut-range => { return root.cut-range(); }
                    paste-range => { return root.paste-range(); }
                    range-replace(t) => { root.picker-open = false; root.range-replace(t); }
                    range-key(k, s) => { return root.range-key(k, s); }
                    block-edited(i, t, c) => { root.picker-open = false; root.block-edited(i, t, c); }
                    block-key(i, k, o) => { return root.block-key(i, k, o); }
                    caret-moved(i, o, a) => { root.caret-moved(i, o, a); }
                }

                // Where more text lies below, the last line fades into the paper instead of being cut
                // in half by the clip. (Touches pass through: it is not a TouchArea.)
                Rectangle {
                    y: parent.height - 56px;
                    height: 56px;
                    visible: root.fade-edge && root.scroll-y < root.max-scroll - 1px;
                    // A smoothstep ramp (eased at both ends) so there is no visible start or edge.
                    background: @linear-gradient(180deg,
                        PaperTheme.paper-color.transparentize(1.0) 0%,
                        PaperTheme.paper-color.transparentize(0.98) 12.5%,
                        PaperTheme.paper-color.transparentize(0.9) 25%,
                        PaperTheme.paper-color.transparentize(0.75) 37.5%,
                        PaperTheme.paper-color.transparentize(0.5) 50%,
                        PaperTheme.paper-color.transparentize(0.25) 62.5%,
                        PaperTheme.paper-color.transparentize(0.1) 75%,
                        PaperTheme.paper-color.transparentize(0.02) 87.5%,
                        PaperTheme.paper-color 100%);
                }
            }
        }

        // Invisible grips for moving and resizing (inside paper-touch, so hovering them keeps the
        // toolbar up). Above the editor; none of them reaches into the text area.
        WindowHandles {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            start-move => { root.picker-open = false; root.start-move(); }
            start-resize(d) => { root.picker-open = false; root.start-resize(d); }
            right-click(x, y) => { root.picker-open = false; root.context-menu(x, y); }
            pointer-over => { root.pointer-moved(); }
        }

        // The scrollbar: drawn in the paper's frame (like the toolbar), hugging its right edge.
        scrollbar := ScrollBar {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            paper-w: root.width - 2 * root.margin;
            paper-h: root.height - 2 * root.margin;
            view: root.text-view-height;
            content: root.content;
            offset <=> root.scroll-y;
            scrolling: root.scrolling;
            pressed => { root.picker-open = false; }
            right-click(x, y) => { root.picker-open = false; root.context-menu(x, y); }
            pointer-over => { root.pointer-moved(); }
        }

        // Drawn in the paper's frame, which tilts with the paper. Above the editor, so its buttons
        // get the clicks while shown; while hidden it takes no part in hit testing at all.
        toolbar := Toolbar {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            paper-x: root.margin;
            paper-y: root.paper-top;
            paper-w: root.width - 2 * root.margin;
            paper-h: root.height - 2 * root.margin;
            tilt: root.tilt;
            bold-active: root.fmt-bold;
            italic-active: root.fmt-italic;
            underline-active: root.fmt-underline;
            strike-active: root.fmt-strike;
            list-active: root.fmt-list;
            picker-open: root.picker-open;
            color-active: root.fmt-ink != 0 || root.fmt-marker != 0;
            ink-color: PickerPalette.ink(root.fmt-ink);
            marker-color: PickerPalette.marker(root.fmt-marker);
            activated(k) => {
                if (k == 4) { root.picker-open = !root.picker-open; return; }
                root.picker-open = false;
                if (k < 4) { root.format(k); } else if (k == 5) { root.format(4); } else { root.insert-image(); }
            }
            opacity: (paper-touch.has-hover || self.any-pressed || root.dropdown-open) ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: ToolbarMetrics.fade; easing: ease-out; }
        }

        // The top-right "..." trigger button for the dropdown menu
        menu-btn := MenuButton {
            f: toolbar.f;
            du: (root.width - 2 * root.margin) / 2px - ToolbarMetrics.menu-button-right-inset / 1px;
            dv: -(root.height - 2 * root.margin) / 2px + ToolbarMetrics.menu-button-top-inset / 1px;
            active: root.dropdown-open;
            clicked => { root.open-dropdown(); }
            opacity: (paper-touch.has-hover || self.has-hover || self.pressed || root.dropdown-open) ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: ToolbarMetrics.fade; easing: ease-out; }
        }
    }

    // The color popover: above the toolbar band, in the paper's frame, over the editor.
    color-picker := ColorPicker {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        paper-x: root.margin;
        paper-y: root.paper-top;
        paper-w: root.width - 2 * root.margin;
        paper-h: root.height - 2 * root.margin;
        tilt: root.tilt;
        open: root.picker-open;
        focus-index: root.picker-focus;
        ink: root.fmt-ink;
        marker: root.fmt-marker;
        pick-ink(i) => { root.pick-ink(i); }
        pick-marker(i) => { root.pick-marker(i); }
        clear => { root.clear-color(); }
        dismiss => { root.picker-open = false; }
    }

    // The tapes lie over the paper.
    Tapes { width: root.width; height: root.height; }
}
