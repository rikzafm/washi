import { Theme } from "theme.slint";
import { BlockData, RunData } from "block.slint";
import { TextLayer } from "text.slint";

export { BlockData, BlockKind, RunData } from "block.slint";
export { Theme } from "theme.slint";

// Walking-skeleton note: unstyled paper. Real styling arrives with the paper/theme tickets.
import { Toolbar, ToolbarMetrics } from "toolbar.slint";

export component NoteWindow inherits Window {
    // Taskbar button text and thumbnail tooltip: the note's title, or "Washi" when empty.
    in property <string> window-title: "Washi";
    in property <bool> pinned: false;
    in property <image> app-icon;
    title: window-title;
    always-on-top: pinned;
    icon: app-icon;
    preferred-width: 431px;
    preferred-height: 451px;
    min-width: 200px;
    min-height: 200px;
    background: #FFFFFD;

    /// The note's stored text, kept by the app; `blocks` is the same text split into styled blocks.
    in property <string> text;
    in property <[BlockData]> blocks;
    /// The same text as upright words on the tilted baseline (shown at rest), laid out by Rust.
    in property <[RunData]> runs;
    /// The paper (window minus margins) changed size: Rust lays the words out again.
    callback paper-resized(length, length);
    changed width => { root.paper-resized(root.width - 2 * root.margin, root.height - 2 * root.margin); }
    changed height => { root.paper-resized(root.width - 2 * root.margin, root.height - 2 * root.margin); }
    /// 1 at rest (words on the tilted baseline), 0 while editing (level).
    out property <float> text-tilt-scale: text-layer.tilt-scale;
    /// The block whose field has the focus (-1 none). Rust clears it when it replaces the blocks.
    in-out property <int> text-focused-block <=> text-layer.focused-block;
    /// Block `i` was edited to this text.
    callback block-edited(int, string);
    /// Right click on the paper, in window coordinates.
    callback context-menu(length, length);
    /// The mouse moved over the paper (the app wakes from suspension).
    callback pointer-moved();
    callback new-note();
    callback close-note();
    callback delete-note();

    // The toolbar shows while the pointer is over the note (anywhere, text included) or holds one
    // of its buttons. Keyboard focus never shows it. The band is reserved either way.
    out property <float> toolbar-opacity: toolbar.opacity;
    out property <bool> toolbar-visible: toolbar.visible;
    property <length> margin: 40px;
    property <angle> tilt: 1.5deg;

    // The whole note: it holds everything, so `has-hover` stays true over the editor and the
    // toolbar too (ADR 0001). The editor ignores the right button, so a right click anywhere
    // reaches this.
    paper-touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.pointer-moved(); }
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }

        FocusScope {
            key-pressed(e) => {
                if (e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt) {
                    if (e.text == "n" || e.text == "\u{e}") { root.new-note(); return accept; }
                    if (e.text == "w" || e.text == "\u{17}") { root.close-note(); return accept; }
                    if (e.text == "d" || e.text == "\u{4}") { root.delete-note(); return accept; }
                }
                reject
            }

            // The text area ends where the toolbar band begins, so text never sits under the toolbar.
            // The text layer is laid out in the paper's frame (fixed insets from its top-left corner).
            Rectangle {
                x: root.margin;
                y: root.margin;
                width: root.width - 2 * root.margin;
                height: root.height - 2 * root.margin - ToolbarMetrics.band-height;
                clip: true;

                text-layer := TextLayer {
                    x: 0px;
                    y: 0px;
                    width: root.width - 2 * root.margin;
                    height: root.height - 2 * root.margin;
                    blocks: root.blocks;
                    runs: root.runs;
                    block-edited(i, t) => { root.block-edited(i, t); }
                }
            }
        }
        // Drawn in the paper's frame, which tilts with the paper. Above the editor, so its buttons
        // get the clicks while shown; while hidden it takes no part in hit testing at all.
        toolbar := Toolbar {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            paper-x: root.margin;
            paper-y: root.margin;
            paper-w: root.width - 2 * root.margin;
            paper-h: root.height - 2 * root.margin;
            tilt: root.tilt;
            opacity: (paper-touch.has-hover || self.any-pressed) ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: ToolbarMetrics.fade; easing: ease-out; }
        }
    }
}
