// The note's physical look: a paper drawn live as a tilted rectangle (so the tilt is exactly
// 1.5 deg at any size), the soft shadow drawn from the same shape, and the two washi tapes.
// Both components fill the window; the paper sits in the window minus PaperTheme.margin.
import { PaperTheme } from "paper-theme.slint";
import { TapePalette, TapeShape, StripedShape } from "settings-widgets.slint";

// Points of the paper, which is turned by the tilt around its own center.
export global PaperGeometry {
    property <float> cs: PaperTheme.paper-tilt.cos();
    property <float> sn: PaperTheme.paper-tilt.sin();

    // (lx, ly) is measured from the paper's center (cx, cy) along the paper's own axes.
    pure public function x(cx: length, cy: length, lx: length, ly: length) -> length {
        return cx + lx * cs - ly * sn;
    }
    pure public function y(cx: length, cy: length, lx: length, ly: length) -> length {
        return cy + lx * sn + ly * cs;
    }
    // Position along the paper's vertical axis for a window point (x, y).
    pure public function v(cx: length, cy: length, x: length, y: length) -> length {
        return -(x - cx) * sn + (y - cy) * cs;
    }
    // The same, for a rectangle with a tilt of its own (`cs` and `sn` are the cosine and sine of it):
    // the Font manager's slip shares the note's scroll bar.
    pure public function x-tilted(cx: length, cy: length, lx: length, ly: length, cs: float, sn: float) -> length {
        return cx + lx * cs - ly * sn;
    }
    pure public function y-tilted(cx: length, cy: length, lx: length, ly: length, cs: float, sn: float) -> length {
        return cy + lx * sn + ly * cs;
    }
    pure public function v-tilted(cx: length, cy: length, x: length, y: length, cs: float, sn: float) -> length {
        return -(x - cx) * sn + (y - cy) * cs;
    }
    pure function pt-tilted(cx: length, cy: length, lx: length, ly: length, cs: float, sn: float) -> string {
        return (x-tilted(cx, cy, lx, ly, cs, sn) / 1px) + " " + (y-tilted(cx, cy, lx, ly, cs, sn) / 1px);
    }
    pure public function quad-tilted(cx: length, cy: length, hw: length, hh: length, cs: float, sn: float) -> string {
        return "M " + pt-tilted(cx, cy, -hw, -hh, cs, sn) + " L " + pt-tilted(cx, cy, hw, -hh, cs, sn)
            + " L " + pt-tilted(cx, cy, hw, hh, cs, sn) + " L " + pt-tilted(cx, cy, -hw, hh, cs, sn) + " Z";
    }
    pure function pt(cx: length, cy: length, lx: length, ly: length) -> string {
        return (x(cx, cy, lx, ly) / 1px) + " " + (y(cx, cy, lx, ly) / 1px);
    }
    // Outline of the tilted rectangle of half size (hw, hh) around (cx, cy).
    pure public function quad(cx: length, cy: length, hw: length, hh: length) -> string {
        return "M " + pt(cx, cy, -hw, -hh) + " L " + pt(cx, cy, hw, -hh) + " L " + pt(cx, cy, hw, hh)
            + " L " + pt(cx, cy, -hw, hh) + " Z";
    }
}

export component Paper {
    in property <length> cx: root.width / 2;
    in property <length> cy: root.height / 2;
    in property <length> paper-w: root.width - 2 * PaperTheme.margin;
    in property <length> paper-h: root.height - 2 * PaperTheme.margin;
    /// Draw the note's stacked shadow (Settings draws its own).
    in property <bool> shadow: true;

    for growth[i] in PaperTheme.shadow-growths: Path {
        visible: root.shadow;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: PaperGeometry.quad(
            root.cx, root.cy + PaperTheme.shadow-offset-y,
            root.paper-w / 2 + growth, root.paper-h / 2 + growth);
        fill: PaperTheme.shadow-colors[i];
    }

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: PaperGeometry.quad(root.cx, root.cy, root.paper-w / 2, root.paper-h / 2);
        fill: PaperTheme.paper-color;
    }
}

// One tape: a pre-rotated image of fixed size, centered on a point given in the paper's frame
// relative to the paper's center.
component Tape {
    in property <image> source;
    in property <length> center-x;
    in property <length> center-y;
    width: img.source.width / PaperTheme.tape-image-scale * 1px;
    height: img.source.height / PaperTheme.tape-image-scale * 1px;
    x: root.center-x - root.width / 2;
    y: root.center-y - root.height / 2;
    img := Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
    }
}

// The two tapes, pinned at fixed offsets from the paper's top-left and bottom-right corners.
// Colorway 0 (pink and blue) is the measured image; the others are drawn as striped shapes
// (`shape`, from `settings/tape.rs`) in the Tape color palette.
export component Tapes {
    /// The note's Tape color: an index into `TapePalette`.
    in property <int> style: 0;
    in property <TapeShape> shape;
    property <length> cx: root.width / 2;
    property <length> cy: root.height / 2;
    property <length> hw: (root.width - 2 * PaperTheme.margin) / 2;
    property <length> hh: (root.height - 2 * PaperTheme.margin) / 2;
    property <length> pink-x: PaperGeometry.x(root.cx, root.cy, -root.hw + PaperTheme.tape-pink-offset-u, -root.hh + PaperTheme.tape-pink-offset-v);
    property <length> pink-y: PaperGeometry.y(root.cx, root.cy, -root.hw + PaperTheme.tape-pink-offset-u, -root.hh + PaperTheme.tape-pink-offset-v);
    property <length> blue-x: PaperGeometry.x(root.cx, root.cy, root.hw + PaperTheme.tape-blue-offset-u, root.hh + PaperTheme.tape-blue-offset-v);
    property <length> blue-y: PaperGeometry.y(root.cx, root.cy, root.hw + PaperTheme.tape-blue-offset-u, root.hh + PaperTheme.tape-blue-offset-v);

    if root.style <= 0 : Tape {
        source: @image-url("assets/tape-pink.png");
        center-x: root.pink-x;
        center-y: root.pink-y;
    }

    if root.style <= 0 : Tape {
        source: @image-url("assets/tape-blue.png");
        center-x: root.blue-x;
        center-y: root.blue-y;
    }

    if root.style > 0 : StripedShape {
        x: root.pink-x - root.shape.w / 2;
        y: root.pink-y - root.shape.h / 2;
        shape: root.shape;
        base: TapePalette.a-light[root.style];
        stripe: TapePalette.a-deep[root.style];
    }

    if root.style > 0 : StripedShape {
        x: root.blue-x - root.shape.w / 2;
        y: root.blue-y - root.shape.h / 2;
        shape: root.shape;
        base: TapePalette.b-light[root.style];
        stripe: TapePalette.b-deep[root.style];
    }
}
