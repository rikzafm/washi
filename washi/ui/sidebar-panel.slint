// The Sidebar's panel shape, shared by the All notes Sidebar and the Settings page's Sidebar so the
// two cannot drift apart: only what is drawn on the panel differs. Window px, in the strip the
// Sidebar adds left of the Paper. The panel's backdrop (its Theme) is drawn by `SidebarBackdrop`.

import { Theme } from "theme.slint";
import { Frame, TRect } from "toolbar.slint";
import { PaperTheme } from "paper-theme.slint";

export global SidebarPanel {
    /// The strip the Sidebar adds to the left of the Paper.
    out property <length> strip: 282px;
    /// The panel: 270 wide, centred at x = 143 in the strip (left edge 8, right edge 278).
    out property <float> width: 270.0;
    out property <float> cx: 143.0;
    out property <float> radius: 22.0;
    out property <angle> tilt: -1.0deg;
    out property <color> fill: #D6DBE2;
    /// A row or Tab on the panel: inset `pad` from both sides (`item-w` wide, its left edge `item-u`
    /// from the panel's centre). Its label is inset `label-inset` more (`label-w` wide, from `label-u`).
    out property <float> pad: 12.0;
    out property <float> item-w: root.width - 2.0 * root.pad;
    out property <float> item-u: -root.width / 2.0 + root.pad;
    out property <float> label-inset: 16.0;
    out property <float> label-w: root.item-w - 2.0 * root.label-inset;
    out property <float> label-u: root.item-u + root.label-inset;

    // The Sidebar layout rule (Settings › Appearance › Sidebar). The rule is the same for both
    // Sidebars; its values are shared or each Sidebar's own ("Same for both sidebars").
    // Height mode: 0 Match note, 1 Fit content. Anchor: 0 Top, 1 Middle, 2 Bottom.

    /// The panel's height: the Paper's (Match note), or its content's but never taller than the
    /// Paper (Fit content).
    public pure function panel-h(paper-h: float, content-h: float, height-mode: int) -> float {
        return height-mode == 1 ? min(content-h, paper-h) : paper-h;
    }
    /// The panel's top edge, given the Paper's top and height: against the Paper's top, centred on
    /// it, or against its bottom. (In Match note every anchor gives the Paper's top.)
    public pure function panel-top(paper-top: float, paper-h: float, panel-h: float, anchor: int) -> float {
        return anchor == 0 ? paper-top
            : anchor == 2 ? paper-top + paper-h - panel-h
            : paper-top + (paper-h - panel-h) / 2.0;
    }
}

/// One copy of a label's light text shadow, offset from the label (px).
export struct HaloOffset {
    dx: float,
    dy: float,
}

/// The Sidebar Themes (Settings › Appearance), as the panels take them: the dropdown order.
export global SidebarThemes {
    out property <[string]> names: ["Default", "Transparent", "Paper", "Liquid glass"];
    out property <int> default: 0;
    out property <int> transparent: 1;
    out property <int> paper: 2;
    out property <int> glass: 3;
    /// The Transparent theme's soft light text shadow: copies of each label drawn under it, a pixel
    /// out all round, so the dark ink reads on any wallpaper.
    out property <[HaloOffset]> halo: [
        { dx: 1, dy: 0 }, { dx: -1, dy: 0 }, { dx: 0, dy: 1 }, { dx: 0, dy: -1 },
        { dx: 1, dy: 1 }, { dx: -1, dy: 1 }, { dx: 1, dy: -1 }, { dx: -1, dy: -1 },
    ];
    out property <color> halo-color: rgba(255, 255, 253, 0.55);

    /// The text-shadow copies a label gets in `theme` (none outside Transparent).
    public pure function halo-for(theme: int) -> [HaloOffset] {
        return theme == root.transparent ? root.halo : [];
    }
}

/// A label on a Sidebar with its light text shadow: the `halo` copies (`SidebarThemes.halo-for`:
/// none outside Transparent) in `SidebarThemes.halo-color`, then the label itself. Placed and sized
/// like a Text, window px (its own text's size unless given one). Each copy sits its offset away
/// along the axes `cs`/`sn`: the window's by default, or a tilted frame's.
export component HaloText inherits Rectangle {
    in property <string> text;
    in property <length> font-size;
    in property <int> font-weight;
    in property <length> letter-spacing;
    /// The label's color.
    in property <color> ink: #2B2F36;
    in property <TextVerticalAlignment> vertical-alignment: top;
    in property <TextOverflow> overflow: clip;
    in property <[HaloOffset]> halo: [];
    in property <float> cs: 1.0;
    in property <float> sn: 0.0;

    width: label.preferred-width;
    height: label.preferred-height;

    for o in root.halo : Text {
        x: (o.dx * root.cs - o.dy * root.sn) * 1px;
        y: (o.dx * root.sn + o.dy * root.cs) * 1px;
        width: root.width;
        height: root.height;
        text: root.text;
        font-family: Theme.handwriting;
        font-size: root.font-size * Theme.ui-fit;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        color: SidebarThemes.halo-color;
        vertical-alignment: root.vertical-alignment;
        overflow: root.overflow;
    }

    label := Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.text;
        font-family: Theme.handwriting;
        font-size: root.font-size * Theme.ui-fit;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        color: root.ink;
        vertical-alignment: root.vertical-alignment;
        overflow: root.overflow;
    }
}

/// The panel's backdrop in `theme`: a `SidebarPanel.width` by `ph` rounded rectangle centred on the
/// tilted frame `f` (the panel's centre). Default is the slate fill; Transparent draws nothing; Paper
/// is the Note's paper with its shadow (no tape); Liquid glass is faked (no real blur): a translucent
/// white with a soft vertical gradient, a bright 1px rim and a faint shadow.
export component SidebarBackdrop inherits Rectangle {
    in property <Frame> f;
    in property <float> ph;
    in property <int> theme: SidebarThemes.default;

    property <float> pw: SidebarPanel.width;
    property <float> u0: -root.pw / 2.0;
    property <float> v0: -root.ph / 2.0;
    // The frame the drop shadows hang from: the panel's, dropped straight down.
    property <Frame> drop: {
        w: root.f.w,
        h: root.f.h,
        cx: root.f.cx,
        cy: root.f.cy + PaperTheme.shadow-offset-y / 1px,
        cs: root.f.cs,
        sn: root.f.sn,
    };

    x: 0px;
    y: 0px;
    width: root.f.w * 1px;
    height: root.f.h * 1px;

    // Paper: the Note's own stacked shadow.
    // (Each layer is a `for` straight under the backdrop: TRects wrapped in a conditional Rectangle
    // were not drawn.)
    for i in (root.theme == SidebarThemes.paper ? PaperTheme.shadow-growths.length : 0) : TRect {
        property <float> growth: PaperTheme.shadow-growths[i] / 1px;
        f: root.drop;
        u0: root.u0 - self.growth;
        v0: root.v0 - self.growth;
        w: root.pw + 2.0 * self.growth;
        h: root.ph + 2.0 * self.growth;
        r: max(0.0, SidebarPanel.radius + self.growth);
        fill: PaperTheme.shadow-colors[i];
    }

    // Liquid glass: a faint shadow, as rings just outside the edge (a filled shadow would show
    // through the translucent glass and grey it), dropped 2px.
    for k in (root.theme == SidebarThemes.glass ? 3 : 0) : TRect {
        property <float> growth: [1.0, 2.5, 4.0][k];
        f: {
            w: root.f.w,
            h: root.f.h,
            cx: root.f.cx,
            cy: root.f.cy + 2.0,
            cs: root.f.cs,
            sn: root.f.sn,
        };
        u0: root.u0 - self.growth;
        v0: root.v0 - self.growth;
        w: root.pw + 2.0 * self.growth;
        h: root.ph + 2.0 * self.growth;
        r: SidebarPanel.radius + self.growth;
        fill: transparent;
        stroke: [#0000001A, #00000010, #00000008][k];
        stroke-width: 1.5px;
    }

    if root.theme == SidebarThemes.default || root.theme == SidebarThemes.paper : TRect {
        f: root.f;
        u0: root.u0;
        v0: root.v0;
        w: root.pw;
        h: root.ph;
        r: SidebarPanel.radius;
        fill: root.theme == SidebarThemes.paper ? PaperTheme.paper-color : SidebarPanel.fill;
    }

    // The glass: a translucent white, lighter towards the top. The software renderer fills a Path
    // with a gradient's flat average, so the gradient is stacked bands from the top, each a little
    // shorter and adding a little white (1.5 levels a band on the desk: no visible step).
    if root.theme == SidebarThemes.glass : TRect {
        f: root.f;
        u0: root.u0;
        v0: root.v0;
        w: root.pw;
        h: root.ph;
        r: SidebarPanel.radius;
        fill: rgba(255, 255, 255, 0.38);
    }

    for k in (root.theme == SidebarThemes.glass ? 8 : 0) : TRect {
        f: root.f;
        u0: root.u0;
        v0: root.v0;
        w: root.pw;
        h: root.ph * (8 - k) / 9.0;
        r: SidebarPanel.radius;
        fill: rgba(255, 255, 255, 0.06);
    }

    // The rim: a bright 1px highlight just inside the edge.
    if root.theme == SidebarThemes.glass : TRect {
        f: root.f;
        u0: root.u0 + 0.5;
        v0: root.v0 + 0.5;
        w: root.pw - 1.0;
        h: root.ph - 1.0;
        r: SidebarPanel.radius - 0.5;
        fill: transparent;
        stroke: rgba(255, 255, 255, 0.9);
        stroke-width: 1px;
    }
}
