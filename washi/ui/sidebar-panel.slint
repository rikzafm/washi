// The Sidebar's panel shape, shared by the All notes Sidebar and the Settings page's Sidebar so the
// two cannot drift apart: only what is drawn on the panel differs. Window px, in the strip the
// Sidebar adds left of the Paper.

export global SidebarPanel {
    /// The strip the Sidebar adds to the left of the Paper.
    out property <length> strip: 282px;
    /// The panel: 270 wide, centred at x = 143 in the strip (left edge 8, right edge 278).
    out property <float> width: 270.0;
    out property <float> cx: 143.0;
    out property <float> radius: 22.0;
    out property <angle> tilt: -1.0deg;
    out property <color> fill: #D6DBE2;

    // The Sidebar layout rule (Settings › Appearance › Sidebar), one for both Sidebars.
    // Height mode: 0 Match note, 1 Fit content. Anchor: 0 Top, 1 Middle, 2 Bottom.

    /// The panel's height: the Paper's (Match note), or its content's but never taller than the
    /// Paper (Fit content).
    public pure function panel-h(paper-h: float, content-h: float, height-mode: int) -> float {
        return height-mode == 1 ? min(content-h, paper-h) : paper-h;
    }
    /// The panel's top edge, given the Paper's top and height: against the Paper's top, centred on
    /// it, or against its bottom. (In Match note every anchor gives the Paper's top.)
    public pure function panel-top(paper-top: float, paper-h: float, panel-h: float, anchor: int) -> float {
        return anchor == 0 ? paper-top
            : anchor == 2 ? paper-top + paper-h - panel-h
            : paper-top + (paper-h - panel-h) / 2.0;
    }
}
