// Building blocks shared by the Settings tabs and the Sidebar.
//
// The Settings page is laid out in the Paper's tilted frame (like All notes): glyphs and controls stay
// upright, only their positions follow the 1.5 degree tilt. Everything below takes a `PaperFrame` and
// positions in "paper coordinates": `a` px from the Paper's left edge, `b` px from its top edge, which
// is how the mockup's CSS numbers read. Heights that depend on the text (a wrapping hint, the preview
// note) are measured from the real Text items, so the Paper always grows to what is laid out.

import { Theme } from "theme.slint";
import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { Frame, Tilt, TRect } from "toolbar.slint";
import { PaperTheme } from "paper-theme.slint";

/// A tilted frame and the size of the (untilted) rectangle it is centred on.
export struct PaperFrame {
    f: Frame,
    pw: float,
    ph: float,
}

/// A striped tape (or chip, or dotted rule) as path commands inside a `w` by `h` box (computed in
/// `settings/tape.rs`).
export struct TapeShape {
    outline: string,
    stripes: string,
    w: length,
    h: length,
}

export global PX {
    /// Path commands of the segment between two points given in paper coordinates.
    public pure function seg(p: PaperFrame, a1: float, b1: float, a2: float, b2: float) -> string {
        return "M " + (x(p, a1, b1) / 1px) + " " + (y(p, a1, b1) / 1px) + " L " + (x(p, a2, b2) / 1px) + " " + (y(p, a2, b2) / 1px) + " ";
    }
    /// Path commands of a circle of radius `r` about (`a`, `b`) in paper coordinates.
    public pure function ring(p: PaperFrame, a: float, b: float, r: float) -> string {
        return "M " + (x(p, a, b) / 1px - r) + " " + (y(p, a, b) / 1px) + " a " + r + " " + r + " 0 1 0 " + 2 * r + " 0 a " + r + " " + r + " 0 1 0 " + -2 * r + " 0 ";
    }
    /// Path commands of the line through three points given in paper coordinates.
    public pure function line3(p: PaperFrame, a1: float, b1: float, a2: float, b2: float, a3: float, b3: float) -> string {
        return "M " + (x(p, a1, b1) / 1px) + " " + (y(p, a1, b1) / 1px)
            + " L " + (x(p, a2, b2) / 1px) + " " + (y(p, a2, b2) / 1px)
            + " L " + (x(p, a3, b3) / 1px) + " " + (y(p, a3, b3) / 1px);
    }

    public pure function x(p: PaperFrame, a: float, b: float) -> length {
        return Tilt.x(p.f, -p.pw / 2.0 + a, -p.ph / 2.0 + b) * 1px;
    }
    public pure function y(p: PaperFrame, a: float, b: float) -> length {
        return Tilt.y(p.f, -p.pw / 2.0 + a, -p.ph / 2.0 + b) * 1px;
    }
}

export global TextMetrics {
    /// Shadows Into Light's line height (ascent + descent) over its font size: what a browser calls
    /// `line-height: normal`. The mockup's `line-height: 1.2` is `1.2 / natural` of this.
    out property <float> natural: 1.6064;
}

/// The four tape colorways of the Tape color picker (the mockup's hexes): each tape is a light base
/// with deeper stripes.
export global TapePalette {
    out property <[string]> names: ["Pink + blue", "Yellow + green", "Lavender + peach", "Slate + rose"];
    out property <[color]> a-deep: [#F7BFCD, #F3D98A, #CDBFEC, #B9C0CC];
    out property <[color]> a-light: [#FCDDE5, #FAEDC2, #E6DFF6, #DDE1E8];
    out property <[color]> b-deep: [#B1D9E5, #B5DDB7, #F7CBAA, #E9A9B6];
    out property <[color]> b-light: [#D7EDF3, #DDF0DD, #FBE5D5, #F5D3DA];
}

/// What `Turned.lines` is asked: one text, how it is set out in its box and where the box is.
export struct TurnSpec {
    text: string,
    family: string,
    size: float,
    bold: bool,
    pf: PaperFrame,
    /// The box's top-left in paper coordinates, and its size.
    a: float,
    b: float,
    w: float,
    h: float,
    line-factor: float,
    /// Added after every character, px.
    spacing: float,
    /// 0 never, 1 at word breaks, 2 anywhere.
    wrap: int,
    /// 0 left, 1 centre, 2 right; vertically 0 top, 1 centre, 2 bottom.
    align: int,
    valign: int,
    elide: bool,
    /// Changes with the font, so the lines are made again.
    epoch: float,
    /// Screen px per logical px.
    scale: float,
}

/// A line of text drawn turned onto the tilt (white ink in a picture), in the box's parent's px.
export struct TurnedLine {
    img: image,
    x: length,
    y: length,
    w: length,
    h: length,
}

/// The Settings page's text drawn on the tilt of its Paper, by Rust (`ui_text.rs`). No lines means
/// there is no turned drawing for this text, and `PText` shows the level one.
export global Turned {
    pure callback lines(TurnSpec) -> [TurnedLine];
}

/// A text with its top-left at paper coordinates (`a`, `b`). It is drawn turned by the Paper's tilt
/// (`Turned`) and, where that is not possible, level at its tilted place.
export component PText inherits Rectangle {
    in property <PaperFrame> pf;
    in property <float> a;
    in property <float> b;
    /// Slint sets a glyph about a pixel higher than a browser does on the same line box.
    in property <float> nudge: 1.0;
    in property <string> text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    in property <string> font-family: Theme.handwriting;
    in property <color> ink: #2B2F36;
    in property <TextWrap> wrap: TextWrap.no-wrap;
    in property <TextOverflow> overflow: TextOverflow.clip;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    in property <TextVerticalAlignment> vertical-alignment: TextVerticalAlignment.top;
    in property <float> line-height-factor: 1.0;
    in property <length> letter-spacing: 0px;
    /// What the text takes up unwrapped, and wrapped into `width`.
    out property <length> text-w: probe.preferred-width;
    out property <length> text-h: probe.preferred-height;
    /// Drawn turned (not the level text).
    out property <bool> drawn: root.turned.length > 0;

    property <[TurnedLine]> turned: Turned.lines({
        text: root.text,
        family: root.font-family,
        size: root.font-size / 1px,
        bold: root.font-weight >= 600,
        pf: root.pf,
        a: root.a,
        b: root.b + root.nudge,
        w: root.width / 1px,
        h: root.height / 1px,
        line-factor: root.line-height-factor,
        spacing: root.letter-spacing / 1px,
        wrap: root.wrap == TextWrap.word-wrap ? 1 : root.wrap == TextWrap.char-wrap ? 2 : 0,
        align: root.horizontal-alignment == TextHorizontalAlignment.center ? 1 : root.horizontal-alignment == TextHorizontalAlignment.right ? 2 : 0,
        valign: root.vertical-alignment == TextVerticalAlignment.center ? 1 : root.vertical-alignment == TextVerticalAlignment.bottom ? 2 : 0,
        elide: root.overflow == TextOverflow.elide,
        epoch: Theme.text-epoch,
        scale: 1px / 1phx,
    });

    x: PX.x(root.pf, root.a, root.b + root.nudge);
    y: PX.y(root.pf, root.a, root.b + root.nudge);
    width: probe.preferred-width;
    height: probe.preferred-height;

    // The level text: it measures the box, and is what shows when nothing is drawn turned.
    probe := Text {
        width: root.width;
        height: root.height;
        text: root.text;
        font-family: root.font-family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.turned.length > 0 || root.text == "" ? transparent : root.ink;
        wrap: root.wrap;
        overflow: root.overflow;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: root.vertical-alignment;
        line-height-factor: root.line-height-factor;
        letter-spacing: root.letter-spacing;
    }

    for line in root.turned : Image {
        x: line.x - root.x;
        y: line.y - root.y;
        width: line.w;
        height: line.h;
        source: line.img;
        colorize: root.ink;
        image-fit: fill;
    }
}

/// An upright box whose top-left is at paper coordinates (`a`, `b`) in the Paper's own (tilted) axes.
/// The box itself stays level, so it is placed by its centre: the tilt's error is then spread evenly
/// over both ends instead of piling up at the far one.
export component PBox inherits Rectangle {
    in property <PaperFrame> pf;
    in property <float> a;
    in property <float> b;
    x: PX.x(root.pf, root.a + root.width / 2px, root.b + root.height / 2px) - root.width / 2;
    y: PX.y(root.pf, root.a + root.width / 2px, root.b + root.height / 2px) - root.height / 2;
}

/// A tilted (rounded) rectangle at paper coordinates (`a`, `b`), `w` by `h`.
export component PRect inherits TRect {
    in property <PaperFrame> pf;
    in property <float> a;
    in property <float> b;
    f: root.pf.f;
    u0: -root.pf.pw / 2.0 + root.a;
    v0: -root.pf.ph / 2.0 + root.b;
}

/// A soft shadow under a tilted rectangle, as a few stacked copies (the renderer has no blur on a
/// tilted shape). `spread` and `blur` are the CSS box-shadow numbers.
export component PShadow inherits Rectangle {
    in property <PaperFrame> pf;
    in property <float> a;
    in property <float> b;
    in property <float> w;
    in property <float> h;
    in property <float> r: 0;
    in property <float> dy: 0;
    in property <float> spread: 0;
    in property <float> blur: 12;
    in property <float> alpha: 0.3;
    x: 0px;
    y: 0px;
    width: root.pf.f.w * 1px;
    height: root.pf.f.h * 1px;

    // A gaussian edge of sigma `blur / 2` is a mix of hard edges at its quantiles: one copy per
    // eighth, each a eighth of the opacity.
    for k in 8 : PRect {
        property <float> g: root.spread + root.blur / 2.0 * [1.534, 0.887, 0.489, 0.157, -0.157, -0.489, -0.887, -1.534][k];
        pf: root.pf;
        a: root.a - g;
        b: root.b + root.dy - g;
        w: root.w + 2.0 * g;
        h: root.h + 2.0 * g;
        r: max(0.0, root.r + g);
        fill: rgba(40, 50, 70, root.alpha / 7.6);
    }
}

/// A soft shadow behind a level rounded box (the renderer draws no blur), as `PShadow` does it: the
/// box is the parent's, the CSS box-shadow numbers are the properties.
export component UShadow inherits Rectangle {
    in property <float> r: 0;
    in property <float> dy: 0;
    in property <float> spread: 0;
    in property <float> blur: 12;
    in property <float> alpha: 0.3;
    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    for k in 8 : Rectangle {
        property <float> g: root.spread + root.blur / 2.0 * [1.534, 0.887, 0.489, 0.157, -0.157, -0.489, -0.887, -1.534][k];
        x: -g * 1px;
        y: (root.dy - g) * 1px;
        width: root.width + 2 * g * 1px;
        height: root.height + 2 * g * 1px;
        border-radius: max(0.0, root.r + g) * 1px;
        background: rgba(40, 50, 70, root.alpha / 7.6);
    }
}

/// The dotted 2px rule of a row (`shape` is the dots along the tilt, from `tape.rs`), starting at
/// paper coordinates (`a`, `b`).
export component PRule inherits Path {
    // The dotted rules are not drawn; the 2px they take in the layout stays.
    visible: false;
    in property <PaperFrame> pf;
    in property <float> a;
    in property <float> b;
    in property <TapeShape> shape;
    x: PX.x(root.pf, root.a, root.b) - 2px;
    y: PX.y(root.pf, root.a, root.b) - 2px;
    width: root.shape.w;
    height: root.shape.h;
    viewbox-width: root.shape.w / 1px;
    viewbox-height: root.shape.h / 1px;
    commands: root.shape.outline;
    fill: #C9CCD2;
}

/// A strip of washi tape (or a chip): a light base with deeper stripes, and the tape's little shadow.
export component StripedShape inherits Rectangle {
    in property <TapeShape> shape;
    in property <color> base;
    in property <color> stripe;
    in property <bool> shadow: true;
    width: root.shape.w;
    height: root.shape.h;

    if root.shadow : Path {
        y: 1px;
        width: root.width;
        height: root.height;
        viewbox-width: root.shape.w / 1px;
        viewbox-height: root.shape.h / 1px;
        commands: root.shape.outline;
        fill: rgba(40, 50, 70, 0.15);
    }

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.shape.w / 1px;
        viewbox-height: root.shape.h / 1px;
        commands: root.shape.outline;
        fill: root.base;
    }

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.shape.w / 1px;
        viewbox-height: root.shape.h / 1px;
        commands: root.shape.stripes;
        fill: root.stripe;
    }
}

/// A tape centred on paper coordinates (`a`, `b`).
export component VTape inherits StripedShape {
    in property <PaperFrame> pf;
    in property <float> a;
    in property <float> b;
    x: PX.x(root.pf, root.a, root.b) - root.shape.w / 2;
    y: PX.y(root.pf, root.a, root.b) - root.shape.h / 2;
}

/// A row of a tab: the label (and an optional hint under it) at the left, the control (the children)
/// at the right, a dotted rule along the bottom. Mockup: `min-height: 56`, a 2px dotted bottom border,
/// the label and hint on 26.4px lines. `y` is the row's top; `total` is its height with the rule, which
/// grows with a wrapping label or hint.
export component SettingRow inherits Rectangle {
    in property <PaperFrame> pf;
    in property <float> row-y;
    in property <string> label;
    in property <string> hint;
    in property <bool> rule: true;
    in property <TapeShape> dots;
    in property <float> label-size: 22;
    /// Line pitch of the label and hint in px; -1 is 26.4 with a hint and the font's own without.
    in property <float> lh: -1;
    in property <float> min-h: 56;
    /// Space above the row's content (the Uninstall row's padding).
    in property <float> pad-top: 0;
    /// Break the hint anywhere (a path), not at spaces.
    in property <bool> break-all: false;
    in property <bool> bold-label: false;

    property <float> pitch: root.lh > 0 ? root.lh : (root.hint != "" ? 26.4 : 0.0);
    property <float> label-w: 448.0 - ctl.preferred-width / 1px - 16.0;
    property <float> label-h: label-t.text-h / 1px;
    property <float> hint-h: root.hint == "" ? 0.0 : hint-t.text-h / 1px;
    property <float> block-h: root.label-h + root.hint-h;
    out property <float> content-h: max(root.min-h, root.block-h);
    out property <float> total: root.pad-top + root.content-h + (root.rule ? 2.0 : 0.0);
    property <float> top: root.row-y + root.pad-top;
    x: 0px;
    y: 0px;
    width: root.pf.f.w * 1px;
    height: root.pf.f.h * 1px;

    label-t := PText {
        pf: root.pf;
        a: 36.0;
        b: root.top + (root.content-h - root.block-h) / 2.0;
        nudge: root.pitch > 0 ? 2.0 : 1.0;
        width: root.label-w * 1px;
        text: root.label;
        font-size: root.label-size * 1px * Theme.ui-fit;
        font-weight: root.bold-label ? 700 : 400;
        wrap: word-wrap;
        line-height-factor: root.pitch > 0 ? root.pitch / (root.label-size * TextMetrics.natural) : 1.0;
    }

    hint-t := PText {
        pf: root.pf;
        a: 36.0;
        b: root.top + (root.content-h - root.block-h) / 2.0 + root.label-h;
        nudge: 4.5;
        width: root.label-w * 1px;
        visible: root.hint != "";
        text: root.hint;
        font-size: 18px * Theme.ui-fit;
        ink: #5B616B;
        wrap: root.break-all ? TextWrap.char-wrap : TextWrap.word-wrap;
        line-height-factor: root.pitch > 0 ? root.pitch / (18.0 * TextMetrics.natural) : 1.0;
    }

    // The control, right-aligned at the content's edge and centred on the row.
    ctl := HorizontalLayout {
        spacing: 6px;
        x: PX.x(root.pf, 484.0 - self.preferred-width / 2px, root.top + root.content-h / 2.0) - self.preferred-width / 2;
        y: PX.y(root.pf, 484.0 - self.preferred-width / 2px, root.top + root.content-h / 2.0) - self.preferred-height / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        @children
    }

    if root.rule : PRule {
        pf: root.pf;
        a: 36.0;
        b: root.top + root.content-h;
        shape: root.dots;
    }
}

/// Room around a control's box for its turned drawing to swing into.
export global TiltPad {
    out property <length> pad: 6px;
}

/// What a control draws its tilted look in: a scene the size of its box plus `TiltPad` all round (a
/// tilted shape reaches past its level box), with the frame to draw in. Put it first in the control;
/// shapes and texts take `pf: scene.pf` and are placed by coordinates from the scene's top-left, so
/// a control's own point (x, y) is at `TiltPad.pad / 1px + x`.
export component TiltScene inherits Rectangle {
    in property <angle> tilt: PaperTheme.paper-tilt;
    /// The control's own size.
    in property <length> box-w;
    in property <length> box-h;
    out property <PaperFrame> pf: {
        f: {
            w: self.width / 1px,
            h: self.height / 1px,
            cx: self.width / 2px,
            cy: self.height / 2px,
            cs: root.tilt.cos(),
            sn: root.tilt.sin(),
        },
        pw: self.width / 1px,
        ph: self.height / 1px,
    };
    x: -TiltPad.pad;
    y: -TiltPad.pad;
    width: root.box-w + 2 * TiltPad.pad;
    height: root.box-h + 2 * TiltPad.pad;
}

/// A level box of text turned by `tilt` about the box's centre (a label inside a control).
export component TiltLabel inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    in property <color> ink: #2B2F36;
    in property <TextOverflow> overflow: TextOverflow.clip;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    in property <TextVerticalAlignment> vertical-alignment: TextVerticalAlignment.center;
    in property <angle> tilt: PaperTheme.paper-tilt;

    scene := TiltScene {
        tilt: root.tilt;
        box-w: root.width;
        box-h: root.height;
        PText {
            pf: scene.pf;
            a: TiltPad.pad / 1px;
            b: TiltPad.pad / 1px;
            nudge: 0.0;
            width: root.width;
            height: root.height;
            text: root.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            ink: root.ink;
            overflow: root.overflow;
            horizontal-alignment: root.horizontal-alignment;
            vertical-alignment: root.vertical-alignment;
        }
    }
}

/// The design's toggle: a 52x30 rounded track and a 20px knob.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> accessible-name;
    in property <angle> tilt: PaperTheme.paper-tilt;
    callback toggled();
    width: 52px;
    height: 30px;
    accessible-role: switch;
    accessible-checked: root.checked;
    accessible-label: root.accessible-name;

    property <float> pad: TiltPad.pad / 1px;
    property <float> knob-a: root.checked ? 27.0 : 5.0;
    animate knob-a { duration: 150ms; easing: ease-out; }

    scene := TiltScene {
        tilt: root.tilt;
        box-w: root.width;
        box-h: root.height;
        // the track (an outline when it is off), then the knob
        PRect {
            pf: scene.pf;
            a: root.pad;
            b: root.pad;
            w: 52.0;
            h: 30.0;
            r: 10.0;
            fill: root.checked ? #2B2F36 : #8B919A;
        }

        if !root.checked : PRect {
            pf: scene.pf;
            a: root.pad + 1.5;
            b: root.pad + 1.5;
            w: 49.0;
            h: 27.0;
            r: 8.5;
            fill: #E8E8E6;
        }

        PRect {
            pf: scene.pf;
            a: root.pad + root.knob-a;
            b: root.pad + 5.0;
            w: 20.0;
            h: 20.0;
            r: 7.0;
            fill: root.checked ? #FFFFFD : #8B919A;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

/// The design's `.btn.seg`: a 40px pill with the label's own width plus 14px each side.
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    /// Dark when chosen (a segment of a group).
    in property <bool> chosen: false;
    /// White with a red outline and red text (the Uninstall entry).
    in property <bool> outlined: false;
    /// Filled red with light text (the Uninstall confirm).
    in property <bool> filled: false;
    in property <angle> tilt: PaperTheme.paper-tilt;
    callback clicked();
    out property <length> natural-w: label.text-w + 28px;
    width: root.natural-w;
    height: 40px;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.text;
    accessible-enabled: root.enabled;

    property <float> pad: TiltPad.pad / 1px;

    scene := TiltScene {
        tilt: root.tilt;
        box-w: root.width;
        box-h: root.height;
        PRect {
            pf: scene.pf;
            a: root.pad;
            b: root.pad;
            w: root.width / 1px;
            h: 40.0;
            r: 10.8;
            fill: root.outlined ? transparent : root.filled ? (area.pressed ? #96201A : #B3261E)
                : root.chosen ? #2B2F36
                : (area.has-hover || area.pressed) ? #E6E6E3 : #F0F0EE;
        }

        // the outline is the shape's own stroke: stacked shapes would show through at half opacity
        if root.outlined : PRect {
            pf: scene.pf;
            a: root.pad + 0.75;
            b: root.pad + 0.75;
            w: root.width / 1px - 1.5;
            h: 38.5;
            r: 10.05;
            fill: #FFFFFD;
            stroke: #B3261E;
            stroke-width: 1.5px;
        }

        label := PText {
            pf: scene.pf;
            a: root.pad + (root.width - self.text-w) / 2px;
            b: root.pad + (root.height - self.text-h) / 2px;
            nudge: 0.0;
            text: root.text;
            font-size: 20px * Theme.ui-fit;
            ink: (root.filled || root.chosen) ? #FFFFFD : (root.outlined ? #B3261E : #2B2F36);
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// A key cap or value chip (`.key`): 19px text with 10px each side, at least 40 wide, 36 tall.
export component KeyCap inherits Rectangle {
    in property <string> text;
    in property <bool> dark: false;
    in property <angle> tilt: PaperTheme.paper-tilt;
    out property <length> natural-w: max(40px, label.text-w + 20px);
    width: root.natural-w;
    height: 36px;

    property <float> pad: TiltPad.pad / 1px;

    scene := TiltScene {
        tilt: root.tilt;
        box-w: root.width;
        box-h: root.height;
        PRect {
            pf: scene.pf;
            a: root.pad;
            b: root.pad;
            w: root.width / 1px;
            h: 36.0;
            r: 8.0;
            fill: root.dark ? #2B2F36 : #F0F0EE;
        }

        label := PText {
            pf: scene.pf;
            a: root.pad + (root.width - self.text-w) / 2px;
            b: root.pad + (root.height - self.text-h) / 2px;
            nudge: 0.0;
            text: root.text;
            font-size: 19px * Theme.ui-fit;
            ink: root.dark ? #FFFFFD : #2B2F36;
        }
    }
}

/// A Resource use tile: a value over its caption (the mockup's 10px padding, 26px value on 28.6px,
/// 17px caption on 27px).
export component StatTile inherits Rectangle {
    in property <string> value;
    in property <string> caption;
    in property <angle> tilt: PaperTheme.paper-tilt;
    width: 106px;
    height: 75.6px;
    accessible-role: text;
    accessible-label: root.caption + ": " + root.value;

    property <float> pad: TiltPad.pad / 1px;

    scene := TiltScene {
        tilt: root.tilt;
        box-w: root.width;
        box-h: root.height;
        PRect {
            pf: scene.pf;
            a: root.pad;
            b: root.pad;
            w: 106.0;
            h: 75.6;
            r: 10.8;
            fill: #F0F0EE;
        }

        PText {
            pf: scene.pf;
            a: root.pad;
            b: root.pad + 10.0;
            nudge: 0.0;
            width: 106px;
            height: 28.6px;
            text: root.value;
            font-size: 26px * Theme.ui-fit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        PText {
            pf: scene.pf;
            a: root.pad;
            b: root.pad + 38.6;
            nudge: 0.0;
            width: 106px;
            height: 27px;
            text: root.caption;
            font-size: 17px * Theme.ui-fit;
            ink: #5B616B;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// A section heading ("Storage", "Resource use"): 24px bold on a 38px line.
export component SectionHeading inherits PText {
    width: 448px;
    height: 38px;
    font-size: 24px * Theme.ui-fit;
    font-weight: 700;
    vertical-alignment: center;
}

/// A closed dropdown (the mockup's `.ddb`): the chosen option and a chevron, 236 by 44. With
/// `chips`, two tape chips come before the label.
export component PickerButton inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    in property <bool> chips: false;
    in property <TapeShape> chip-shape;
    in property <color> chip-a-base;
    in property <color> chip-a-stripe;
    in property <color> chip-b-base;
    in property <color> chip-b-stripe;
    /// Greyed out and deaf to clicks when false.
    in property <bool> enabled: true;
    in property <angle> tilt: PaperTheme.paper-tilt;
    callback clicked();
    width: 236px;
    height: 44px;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-expanded: root.open;
    accessible-enabled: root.enabled;

    property <float> pad: TiltPad.pad / 1px;
    property <float> mid: root.pad + root.height / 2px;
    property <float> chev: root.pad + root.width / 1px - 28.0;

    scene := TiltScene {
        tilt: root.tilt;
        box-w: root.width;
        box-h: root.height;
        PRect {
            pf: scene.pf;
            a: root.pad;
            b: root.pad;
            w: root.width / 1px;
            h: root.height / 1px;
            r: 10.8;
            fill: hit.has-hover ? #E6E6E3 : #F0F0EE;
        }

        if root.chips : VTape {
            pf: scene.pf;
            a: root.pad + 12.0 + self.shape.w / 2px;
            b: root.mid;
            shape: root.chip-shape;
            base: root.chip-a-base;
            stripe: root.chip-a-stripe;
            shadow: false;
        }

        if root.chips : VTape {
            pf: scene.pf;
            a: root.pad + 46.0 + self.shape.w / 2px;
            b: root.mid;
            shape: root.chip-shape;
            base: root.chip-b-base;
            stripe: root.chip-b-stripe;
            shadow: false;
        }

        PText {
            pf: scene.pf;
            a: root.pad + (root.chips ? 80.0 : 12.0);
            b: root.pad;
            nudge: 0.0;
            width: root.width - (root.chips ? 80px : 12px) - 38px;
            height: root.height;
            text: root.text;
            font-size: 21px * Theme.ui-fit;
            vertical-alignment: center;
            overflow: elide;
        }

        // The chevron: a 24-unit icon drawn at 16px, stroke 2.2 units.
        Path {
            width: scene.width;
            height: scene.height;
            viewbox-width: self.width / 1px;
            viewbox-height: self.height / 1px;
            commands: PX.line3(scene.pf, root.chev + 4.0, root.mid - 2.0, root.chev + 8.0, root.mid + 2.0, root.chev + 12.0, root.mid - 2.0);
            stroke: #2B2F36;
            stroke-width: 1.47px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
    }

    hit := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// An option of an open list (the mockup's `.ddi`, 42px tall).
export component ListItem inherits Rectangle {
    in property <string> text;
    in property <bool> chosen;
    in property <bool> chips: false;
    in property <TapeShape> chip-shape;
    in property <color> chip-a-base;
    in property <color> chip-a-stripe;
    in property <color> chip-b-base;
    in property <color> chip-b-stripe;
    in property <angle> tilt: PaperTheme.paper-tilt;
    callback clicked();
    height: 42px;

    property <float> pad: TiltPad.pad / 1px;
    property <float> mid: root.pad + root.height / 2px;

    scene := TiltScene {
        tilt: root.tilt;
        box-w: root.width;
        box-h: root.height;
        if item-hit.has-hover || root.chosen : PRect {
            pf: scene.pf;
            a: root.pad;
            b: root.pad;
            w: root.width / 1px;
            h: 42.0;
            r: 8.0;
            fill: #F0F0EE;
        }

        if root.chips : VTape {
            pf: scene.pf;
            a: root.pad + 10.0 + self.shape.w / 2px;
            b: root.mid;
            shape: root.chip-shape;
            base: root.chip-a-base;
            stripe: root.chip-a-stripe;
            shadow: false;
        }

        if root.chips : VTape {
            pf: scene.pf;
            a: root.pad + 46.0 + self.shape.w / 2px;
            b: root.mid;
            shape: root.chip-shape;
            base: root.chip-b-base;
            stripe: root.chip-b-stripe;
            shadow: false;
        }

        PText {
            pf: scene.pf;
            a: root.pad + (root.chips ? 82.0 : 10.0);
            b: root.pad;
            nudge: 0.0;
            width: root.width - (root.chips ? 82px : 10px) - 10px;
            height: root.height;
            text: root.text;
            font-size: 21px * Theme.ui-fit;
            font-weight: root.chosen ? 700 : 400;
            vertical-alignment: center;
        }
    }

    item-hit := TouchArea {
        mouse-cursor: pointer;
        accessible-role: list-item;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

/// The open list's panel (the mockup's `.ddl`): white, 10.8px corners, a soft double shadow, 6px padding.
export component ListPanel inherits Rectangle {
    width: 260px;
    border-radius: 10.8px;
    background: #FFFFFD;

    // The mockup's `0 14px 24px -8px` and `0 2px 5px` shadows.
    UShadow {
        r: 10.8;
        dy: 14;
        spread: -8;
        blur: 24;
        alpha: 0.4;
    }

    UShadow {
        r: 10.8;
        dy: 2;
        blur: 5;
        alpha: 0.15;
    }

    Rectangle {
        border-radius: 10.8px;
        background: #FFFFFD;
    }

    @children
}
