// Design tokens: fixed logical values measured from the mockups (docs/design/spec.json),
// never proportions of the note size.

export global Theme {
    // The text lies tilted with the paper (PaperTheme.paper-tilt) at rest, clockwise.
    out property <angle> text-tilt: 1.45deg;
    // Without tilted editing (Settings › General) the text settles flat over this long when editing
    // starts, and back when it ends.
    out property <duration> settle: 120ms;
    out property <duration> settle-in: 90ms;
    // Another note shown in the same window (All Notes): its text settles in from a little lower
    // and from half-faded over this long. It never starts blank, so the switch never flashes.
    out property <duration> switch-settle: 200ms;
    out property <length> switch-drop: 6px;
    out property <float> switch-from-opacity: 0.45;
    // All Notes opening: the sidebar slides out from behind the paper's left edge.
    out property <duration> sidebar-intro: 220ms;
    out property <length> sidebar-intro-shift: 28px;
    out property <float> sidebar-intro-from: 0.2;
    // At rest the text is drawn in pieces at most this wide, each on the tilted baseline.
    out property <length> step-width: 16px;

    out property <color> ink: #2B2F36;
    // The text and strike-through of a ticked check item, and its tick.
    out property <color> ink-done: #6B6F76;
    out property <color> check-tick: #1F9D55;
    out property <color> check-box: #8B919A;
    // How far a check item's text is indented for its box (the same as LIST_INDENT in src/textflow.rs).
    in-out property <length> check-indent: 26px;
    // Select all: the wash over every word of the note.
    out property <color> selection: #BAD3FC;
    // A selection in a field: the same blue, see-through, over the words (drawn under the field).
    out property <color> selection-over: #6FA2F566;
    // The "Note Something...." hint of an empty note: light, subtle gray.
    out property <color> ink-hint: #B4B9C0;
    // The note text's family and the other font-dependent numbers below are set from Rust, on every
    // window, from the active font (src/fonts); the values here are the Default font's.
    in-out property <string> handwriting: "Shadows Into Light";
    // UI text is drawn at its size times this: clamp(Default font's average advance / the Font in use's, 0.70, 1.0) over a sample of UI labels, so a wide font takes the room the Default font took. 1 for the Default font. Note text never uses it. Set from Rust with the font.
    in-out property <float> ui-fit: 1;
    // Extra space after every character of a note's text, in em of its size (Settings › Font &
    // Style › Letter spacing; 0 is the font's own). The app sets it from the saved choice, and
    // src/textflow.rs lays the lines out with the same spacing.
    in-out property <float> letter-spacing-em: 0;
    // Bumped by the app after every scale change of a window showing a note (`reshape_text_soon`, src/note_window.rs). The
    // note's words and edit fields read it in their font size (times zero), so a change makes Slint
    // shape them again. Slint keeps text shaped while the window briefly had the monitor's own scale
    // at startup (before the UI size goes back on top) and drew it that big.
    in-out property <int> text-epoch: 0;
    // The edit fields' face: the handwriting's advances, no outlines, a lower ascent and descent
    // (made with `tools/fonts.py blank`; see `caret-line-em`). The fields only place the caret and the selection.
    in-out property <string> caret-font: "Washi Caret";

    // The caret the note draws (the fields' own is hidden, see TextLayer).
    out property <length> caret-width: 1px;

    // Text block: inset from the paper edges (paper's own frame).
    out property <length> text-inset-left: 32px;
    out property <length> text-inset-right: 40px;
    out property <length> text-inset-top: 38.2px;
    // Space kept clear between the text area and the toolbar band's top edge.
    out property <length> text-bottom-gap: 4px;

    // Natural line height of the handwriting font in em: (ascent + descent) / units per em.
    in-out property <float> handwriting-line-em: 1.6064;
    // The advance of a space in the handwriting (461 / 1024 em, every face).
    in-out property <float> lead-em: 0.450195;
    // How far a glyph reaches back past its origin at most (176 / 1024 em, the j), and a little.
    in-out property <float> lean-room: 0.2;
    // Room below a word's line box for its descenders, in em (the face descends 0.43 em below its
    // baseline, which sits less than that above the bottom of a line at the note's pitches).
    in-out property <float> descender-room: 0.5;
    // How far an italic glyph leans out past its advance, in em (Washi's italic is a 0.25 shear).
    in-out property <float> italic-overhang: 0.3;
    // The same for the edit fields' face: its ascent and descent are cut down to 961 / 1024 em
    // (`tools/fonts.py blank`). A field's caret and selection are as tall as the larger of the line
    // pitch and the face's ascent + descent; the handwriting's own (1.6064 em) is taller than the
    // body and heading pitch, so the caret stuck out of its line and was cut at the field's top and
    // bottom edge, off-center on a paragraph's first and last line. Under every pitch, the caret
    // is the line box itself on every line.
    out property <float> caret-line-em: 0.938477;

    // Title
    in-out property <length> title-size: 37.3px;
    in-out property <length> title-pitch: 60px;
    // Space above the first heading / first body block
    in-out property <length> heading-gap: 10px;
    in-out property <length> body-gap: 8.1px;
    // Heading (bold face)
    in-out property <length> heading-size: 24px;
    in-out property <length> heading-pitch: 34px;
    // Body
    in-out property <length> body-size: 22.65px;
    in-out property <length> body-pitch: 33px;
}
