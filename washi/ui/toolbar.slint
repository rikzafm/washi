// The formatting toolbar: eight visual buttons (B, I, U, ab, A, list, check, image), and the list
// button's flyout (bulleted or numbered), in the band reserved at the
// bottom of the paper. Geometry is measured from the hover mockup (docs/design/spec.json,
// layout.toolbar), in logical px in the paper's own (untilted) frame. The glyph fonts come from
// docs/design/fonts.md (ticket 03).
//
// Slint's software renderer cannot rotate elements, but the paper is tilted 1.5 degrees, so the
// toolbar tilts with it: shapes are Paths whose points are rotated about the paper's center, and
// glyphs (text cannot be rotated) are placed at their rotated cell centers.
import "../../fonts/Gelasio-Bold.ttf";
import "../../fonts/Gelasio-Regular.ttf";
import "../../fonts/NotoSerif-Italic.ttf";
import "../../fonts/NotoSerif-Regular.ttf";

export global ToolbarMetrics {
    /// Height of the band at the bottom of the paper. Always reserved, shown or not. Taller than
    /// `button-top-above-bottom` (40): the text ends `Theme.text-bottom-gap` above the band, so with
    /// 44 it stops 8 px clear of the buttons (at 38 a cut line of text sat on top of them).
    out property <length> band-height: 44px;
    /// Fade in (quick, so the toolbar answers the pointer at once) and out (gentler, so it does not
    /// blink away when the pointer brushes past the edge).
    out property <duration> fade: 100ms;
    out property <duration> fade-out: 160ms;
    out property <length> button-size: 32px;
    out property <length> button-radius: 8.6px;
    /// Where the first button's left edge and the top of every button sit, in the paper frame.
    out property <length> first-button-x: 23.2px;
    out property <length> button-top-above-bottom: 40px;
    /// Distance between the centers of two neighbouring cells.
    out property <length> pitch: 42.667px;
    out property <color> ink-active: #2B2F36;
    out property <color> ink-muted: #8B919A;
    out property <color> button-fill: #F0F0EE;
    /// The check button when its paragraph is a check item: a pale green fill and a green tick.
    out property <color> check-fill: #DDEFE5;
    out property <color> check-green: #1F8A4C;
    /// How long the list button is held down before its flyout opens.
    out property <duration> list-hold: 400ms;
    /// The list flyout: two 40 px choices in a white body above the band, a tail at the button.
    out property <length> flyout-choice: 40px;
    out property <length> flyout-pad: 6px;
    out property <length> flyout-gap: 10px;
    out property <length> flyout-radius: 12px;
    out property <length> flyout-tail-width: 14px;
    out property <length> flyout-tail-height: 7px;
    out property <color> flyout-fill: #FFFFFD;
    out property <color> flyout-border: #ECECE8;
    out property <color> flyout-shadow: #2B2F360A;
    out property <color> focus-ring: #6FA2F5;
    /// Top-right menu button metrics.
    out property <length> menu-button-width: 28px;
    out property <length> menu-button-height: 24px;
    out property <length> menu-button-radius: 7px;
    out property <length> menu-button-top-inset: 22px;
    out property <length> menu-button-right-inset: 26px;
}

/// The paper's frame: its center in window px and the sine and cosine of its tilt.
export struct Frame {
    w: float,
    h: float,
    cx: float,
    cy: float,
    cs: float,
    sn: float,
}

/// Rotation about the paper center: `du`, `dv` are px in the untilted paper frame, measured from
/// the paper's center (u right, v down). The result is window px.
export global Tilt {
    public pure function x(f: Frame, du: float, dv: float) -> float {
        return f.cx + du * f.cs - dv * f.sn;
    }
    public pure function y(f: Frame, du: float, dv: float) -> float {
        return f.cy + du * f.sn + dv * f.cs;
    }
}

/// A tilted rectangle with rounded corners (radius `r` = 0 gives a plain one).
export component TRect inherits Path {
    in property <Frame> f;
    in property <float> u0;
    in property <float> v0;
    in property <float> w;
    in property <float> h;
    in property <float> r: 0;
    width: root.f.w * 1px;
    height: root.f.h * 1px;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    // start on the top edge, go clockwise
    MoveTo {
        x: Tilt.x(root.f, root.u0 + root.r, root.v0);
        y: Tilt.y(root.f, root.u0 + root.r, root.v0);
    }

    LineTo {
        x: Tilt.x(root.f, root.u0 + root.w - root.r, root.v0);
        y: Tilt.y(root.f, root.u0 + root.w - root.r, root.v0);
    }

    ArcTo {
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
        x: Tilt.x(root.f, root.u0 + root.w, root.v0 + root.r);
        y: Tilt.y(root.f, root.u0 + root.w, root.v0 + root.r);
    }

    LineTo {
        x: Tilt.x(root.f, root.u0 + root.w, root.v0 + root.h - root.r);
        y: Tilt.y(root.f, root.u0 + root.w, root.v0 + root.h - root.r);
    }

    ArcTo {
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
        x: Tilt.x(root.f, root.u0 + root.w - root.r, root.v0 + root.h);
        y: Tilt.y(root.f, root.u0 + root.w - root.r, root.v0 + root.h);
    }

    LineTo {
        x: Tilt.x(root.f, root.u0 + root.r, root.v0 + root.h);
        y: Tilt.y(root.f, root.u0 + root.r, root.v0 + root.h);
    }

    ArcTo {
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
        x: Tilt.x(root.f, root.u0, root.v0 + root.h - root.r);
        y: Tilt.y(root.f, root.u0, root.v0 + root.h - root.r);
    }

    LineTo {
        x: Tilt.x(root.f, root.u0, root.v0 + root.r);
        y: Tilt.y(root.f, root.u0, root.v0 + root.r);
    }

    ArcTo {
        radius-x: root.r;
        radius-y: root.r;
        sweep: true;
        x: Tilt.x(root.f, root.u0 + root.r, root.v0);
        y: Tilt.y(root.f, root.u0 + root.r, root.v0);
    }

    Close { }
}

/// A filled triangle through three tilted points.
component TTri inherits Path {
    in property <Frame> f;
    in property <float> u0;
    in property <float> v0;
    in property <float> u1;
    in property <float> v1;
    in property <float> u2;
    in property <float> v2;
    width: root.f.w * 1px;
    height: root.f.h * 1px;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    MoveTo { x: Tilt.x(root.f, root.u0, root.v0); y: Tilt.y(root.f, root.u0, root.v0); }
    LineTo { x: Tilt.x(root.f, root.u1, root.v1); y: Tilt.y(root.f, root.u1, root.v1); }
    LineTo { x: Tilt.x(root.f, root.u2, root.v2); y: Tilt.y(root.f, root.u2, root.v2); }
    Close { }
}

/// A text glyph centered at a (tilted) cell center, `dx`, `dy` logical px of fine adjustment.
component Glyph inherits Text {
    in property <Frame> f;
    in property <float> du;
    in property <float> dv;
    in property <float> dx: 0;
    in property <float> dy: 0;
    x: (Tilt.x(root.f, root.du, root.dv) + root.dx) * 1px - self.width / 2;
    y: (Tilt.y(root.f, root.du, root.dv) + root.dy) * 1px - self.height / 2;
    width: 60px;
    height: 60px;
    horizontal-alignment: center;
    vertical-alignment: center;
}

/// The hit area of a button, at its (tilted) cell center.
component Hit inherits TouchArea {
    in property <Frame> f;
    in property <float> du;
    in property <float> dv;
    x: Tilt.x(root.f, root.du, root.dv) * 1px - self.width / 2;
    y: Tilt.y(root.f, root.du, root.dv) * 1px - self.height / 2;
    width: ToolbarMetrics.button-size;
    height: ToolbarMetrics.button-size;
    mouse-cursor: pointer;
}

/// A dot (or a circle outline) centered at a tilted point.
export component Dot inherits Rectangle {
    in property <Frame> f;
    in property <float> du;
    in property <float> dv;
    in property <length> d: 2px;
    x: Tilt.x(root.f, root.du, root.dv) * 1px - self.width / 2;
    y: Tilt.y(root.f, root.du, root.dv) * 1px - self.height / 2;
    width: root.d;
    height: root.d;
    border-radius: root.d / 2;
}

/// A polyline through tilted points, as a stroked Path with round joins and caps.
component Line5 inherits Path {
    in property <Frame> f;
    in property <float> u0;
    in property <float> v0;
    in property <float> u1;
    in property <float> v1;
    in property <float> u2;
    in property <float> v2;
    in property <float> u3;
    in property <float> v3;
    in property <float> u4;
    in property <float> v4;
    width: root.f.w * 1px;
    height: root.f.h * 1px;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    stroke-line-join: round;
    stroke-line-cap: round;
    MoveTo {
        x: Tilt.x(root.f, root.u0, root.v0);
        y: Tilt.y(root.f, root.u0, root.v0);
    }

    LineTo {
        x: Tilt.x(root.f, root.u1, root.v1);
        y: Tilt.y(root.f, root.u1, root.v1);
    }

    LineTo {
        x: Tilt.x(root.f, root.u2, root.v2);
        y: Tilt.y(root.f, root.u2, root.v2);
    }

    LineTo {
        x: Tilt.x(root.f, root.u3, root.v3);
        y: Tilt.y(root.f, root.u3, root.v3);
    }

    LineTo {
        x: Tilt.x(root.f, root.u4, root.v4);
        y: Tilt.y(root.f, root.u4, root.v4);
    }
}

/// A polyline through three tilted points, as a stroked Path with round joins and caps.
component Line3 inherits Path {
    in property <Frame> f;
    in property <float> u0;
    in property <float> v0;
    in property <float> u1;
    in property <float> v1;
    in property <float> u2;
    in property <float> v2;
    width: root.f.w * 1px;
    height: root.f.h * 1px;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    stroke-line-join: round;
    stroke-line-cap: round;
    MoveTo {
        x: Tilt.x(root.f, root.u0, root.v0);
        y: Tilt.y(root.f, root.u0, root.v0);
    }

    LineTo {
        x: Tilt.x(root.f, root.u1, root.v1);
        y: Tilt.y(root.f, root.u1, root.v1);
    }

    LineTo {
        x: Tilt.x(root.f, root.u2, root.v2);
        y: Tilt.y(root.f, root.u2, root.v2);
    }
}

/// A list icon centered at (`du`, `dv`): three bullets, or the numbers 1 2 3, each before a rule.
/// (Path-drawn TRects, not Dots: a Rectangle's position snaps to whole pixels, so the bullets
/// would jump about as a resize changes the tilted position.)
component ListIcon inherits Rectangle {
    in property <Frame> f;
    in property <float> du;
    in property <float> dv;
    in property <bool> numbered: false;
    in property <color> ink;
    x: 0px;
    y: 0px;
    width: root.f.w * 1px;
    height: root.f.h * 1px;
    for k in [0, 1, 2]: TRect {
        visible: !root.numbered;
        f: root.f;
        u0: root.du - 8.5;
        v0: root.dv - 7.5 + k * 6;
        w: 3;
        h: 3;
        r: 1.5;
        fill: root.ink;
    }
    for k in [0, 1, 2]: Glyph {
        visible: root.numbered;
        f: root.f;
        du: root.du - 7.2;
        dv: root.dv - 6.1 + k * 6;
        text: "\{k + 1}";
        font-family: "Gelasio";
        font-weight: 700;
        font-size: 7.6px;
        color: root.ink;
    }
    for k in [0, 1, 2]: TRect {
        f: root.f;
        u0: root.du - 2;
        v0: root.dv - 6.65 + k * 6;
        w: 11;
        h: 1.3;
        fill: root.ink;
    }
}

/// The toolbar. It covers the whole window (it draws only its buttons); the owner gives it the
/// paper's frame: where the paper's untilted top-left corner is, its size, and its tilt.
export component Toolbar inherits Rectangle {
    /// Which formats the paragraph holding the caret has (drives the buttons' look).
    in property <bool> bold-active: false;
    in property <bool> italic-active: false;
    in property <bool> underline-active: false;
    in property <bool> strike-active: false;
    /// The list type of the paragraph holding the caret: 0 none, 1 bulleted, 2 numbered.
    in property <int> list-kind: 0;
    /// The list type a click on the list button applies (the one picked last): 1 bulleted, 2 numbered.
    in property <int> list-last: 1;
    /// The list flyout is open (the list button is filled while it is).
    in property <bool> list-menu-open: false;
    in property <bool> check-active: false;
    /// The color popover is open (the "A" button is filled while it is).
    in property <bool> picker-open: false;
    /// The selection (or the caret's character) has a color: fills the "A" button too.
    in property <bool> color-active: false;
    /// The "A" shows the ink color of the selection and its bar the marker color (transparent: none).
    in property <color> ink-color: ToolbarMetrics.ink-active;
    in property <color> marker-color: transparent;
    /// A button was clicked: 0 B, 1 I, 2 U, 3 ab, 4 A (color), 5 check, 6 image, 7 list (the buttons sit in the order
    /// B I U ab A list check image).
    callback activated(int);
    /// The list button's notch was clicked, the button right-clicked or held down: open (or close) its flyout.
    callback list-menu();
    in property <length> paper-x;
    in property <length> paper-y;
    in property <length> paper-w;
    in property <length> paper-h;
    in property <angle> tilt;
    /// True while the pointer holds one of the buttons down.
    out property <bool> any-pressed: h0.pressed || h1.pressed || h2.pressed || h3.pressed || h4.pressed || h5.pressed || h6.pressed || h7.pressed || notch.pressed;
    /// The list button opened its flyout while held down: the release that follows is no click.
    property <bool> list-held: false;
    property <bool> list-on: root.list-kind != 0 || root.list-menu-open;

    out property <Frame> f: {
        w: root.width / 1px,
        h: root.height / 1px,
        cx: (root.paper-x + root.paper-w / 2) / 1px,
        cy: (root.paper-y + root.paper-h / 2) / 1px,
        cs: Math.cos(root.tilt),
        sn: Math.sin(root.tilt),
    };
    // cell centers, from the paper's center
    property <float> cv: (root.paper-h / 2 - ToolbarMetrics.button-top-above-bottom + ToolbarMetrics.button-size / 2) / 1px;
    property <float> half: ToolbarMetrics.button-size / 2px;
    property <float> pitch: ToolbarMetrics.pitch / 1px;
    property <float> u-first: (ToolbarMetrics.first-button-x + ToolbarMetrics.button-size / 2 - root.paper-w / 2) / 1px;
    property <float> c0: root.u-first;
    property <float> c1: root.u-first + root.pitch;
    property <float> c2: root.u-first + 2 * root.pitch;
    property <float> c3: root.u-first + 3 * root.pitch;
    property <float> c4: root.u-first + 4 * root.pitch;
    property <float> c5: root.u-first + 5 * root.pitch;
    property <float> c6: root.u-first + 6 * root.pitch;
    property <float> c7: root.u-first + 7 * root.pitch;
    property <color> muted: ToolbarMetrics.ink-muted;
    property <color> ink: ToolbarMetrics.ink-active;
    property <bool> a-on: root.picker-open || root.color-active;

    // the active button's background
    for on[k] in [
        root.bold-active,
        root.italic-active,
        root.underline-active,
        root.strike-active,
        root.picker-open || root.color-active,
        root.list-on,
        root.check-active
    ]: TRect {
        visible: on;
        f: root.f;
        u0: root.u-first + k * root.pitch - root.half;
        v0: root.cv - root.half - 0.85;
        w: 2 * root.half;
        h: 2 * root.half;
        r: ToolbarMetrics.button-radius / 1px;
        fill: k == 6 ? ToolbarMetrics.check-fill : ToolbarMetrics.button-fill;
    }

    Glyph {
        f: root.f;
        du: root.c0;
        dv: root.cv;
        dx: 0.67;
        dy: 1;
        text: "B";
        font-family: "Gelasio";
        font-weight: 700;
        font-size: 23.4px;
        color: root.bold-active ? root.ink : root.muted;
    }

    Glyph {
        f: root.f;
        du: root.c1;
        dv: root.cv;
        dx: 0.85;
        dy: -1.2;
        text: "I";
        font-family: "Noto Serif";
        font-italic: true;
        font-size: 22.8px;
        color: root.italic-active ? root.ink : root.muted;
    }

    Glyph {
        f: root.f;
        du: root.c2;
        dv: root.cv;
        dx: 1;
        dy: -1;
        text: "U";
        font-family: "Noto Serif";
        font-size: 22.7px;
        color: root.underline-active ? root.ink : root.muted;
    }

    Glyph {
        f: root.f;
        du: root.c3;
        dv: root.cv;
        dx: 0.67;
        dy: 1.5;
        text: "ab";
        font-family: "Gelasio";
        font-size: 23.1px;
        color: root.strike-active ? root.ink : root.muted;
    }
    // the underline of U and the strike-through of ab are drawn, not part of the glyphs
    TRect {
        f: root.f;
        u0: root.c2 - 7.6;
        v0: root.cv + 9.3;
        w: 17.2;
        h: 1.3;
        fill: root.underline-active ? root.ink : root.muted;
    }

    TRect {
        f: root.f;
        u0: root.c3 - 11.3;
        v0: root.cv + 2;
        w: 24;
        h: 1.3;
        fill: root.strike-active ? root.ink : root.muted;
    }

    // color: an "A" in the ink color, with a bar in the marker color under it
    Glyph {
        f: root.f;
        du: root.c4;
        dv: root.cv;
        dx: 0.8;
        dy: -2.2;
        text: "A";
        font-family: "Noto Serif";
        font-size: 22.7px;
        color: root.a-on ? root.ink-color : root.muted;
    }

    TRect {
        f: root.f;
        u0: root.c4 - 8.6;
        v0: root.cv + 8.2;
        w: 17.2;
        h: 3;
        r: 1.5;
        fill: root.marker-color.alpha > 0 ? root.marker-color : (root.a-on ? root.ink-color : root.muted);
    }

    // list: the caret paragraph's list type, or (muted) the one a click applies; a notch in the
    // bottom-right corner says the button holds more than one
    ListIcon {
        f: root.f;
        du: root.c5;
        dv: root.cv;
        numbered: root.list-kind == 2 || (root.list-kind == 0 && root.list-last == 2);
        ink: root.list-on ? root.ink : root.muted;
    }

    TTri {
        f: root.f;
        u0: root.c5 + 13;
        v0: root.cv + 8;
        u1: root.c5 + 13;
        v1: root.cv + 13;
        u2: root.c5 + 8;
        v2: root.cv + 13;
        fill: root.list-on || notch.has-hover ? root.ink : root.muted;
    }

    // check: a rounded box with a tick (green on a pale green button while the paragraph is a check item)
    TRect {
        f: root.f;
        u0: root.c6 - 8;
        v0: root.cv - 8;
        w: 16;
        h: 16;
        r: 3;
        stroke: root.check-active ? ToolbarMetrics.check-green : root.muted;
        stroke-width: 1.8px;
    }

    Line3 {
        f: root.f;
        u0: root.c6 - 4;
        v0: root.cv + 0.3;
        u1: root.c6 - 1;
        v1: root.cv + 3.4;
        u2: root.c6 + 4.2;
        v2: root.cv - 3;
        stroke: root.check-active ? ToolbarMetrics.check-green : root.muted;
        stroke-width: 1.9px;
    }

    // image: frame, sun, and mountains
    TRect {
        f: root.f;
        u0: root.c7 - 7.5;
        v0: root.cv - 8.5;
        w: 17.7;
        h: 15.7;
        r: 2.5;
        stroke: root.muted;
        stroke-width: 1.6px;
    }

    Dot {
        f: root.f;
        du: root.c7 - 2.5;
        dv: root.cv - 4.5;
        d: 5px;
        border-width: 1.4px;
        border-color: root.muted;
    }

    Line5 {
        f: root.f;
        u0: root.c7 - 7;
        v0: root.cv + 6;
        u1: root.c7 - 2;
        v1: root.cv + 1;
        u2: root.c7 + 1.5;
        v2: root.cv + 4;
        u3: root.c7 + 4.5;
        v3: root.cv + 1.5;
        u4: root.c7 + 8;
        v4: root.cv + 5;
        stroke: root.muted;
        stroke-width: 1.5px;
    }

    h0 := Hit {
        f: root.f;
        du: root.c0;
        dv: root.cv;
        clicked => { root.activated(0); }
    }

    h1 := Hit {
        f: root.f;
        du: root.c1;
        dv: root.cv;
        clicked => { root.activated(1); }
    }

    h2 := Hit {
        f: root.f;
        du: root.c2;
        dv: root.cv;
        clicked => { root.activated(2); }
    }

    h3 := Hit {
        f: root.f;
        du: root.c3;
        dv: root.cv;
        clicked => { root.activated(3); }
    }

    h4 := Hit {
        f: root.f;
        du: root.c4;
        dv: root.cv;
        clicked => { root.activated(4); }
    }

    h5 := Hit {
        f: root.f;
        du: root.c6;
        dv: root.cv;
        clicked => { root.activated(5); }
    }

    h6 := Hit {
        f: root.f;
        du: root.c7;
        dv: root.cv;
        clicked => { root.activated(6); }
    }

    h7 := Hit {
        f: root.f;
        du: root.c5;
        dv: root.cv;
        accessible-role: button;
        accessible-label: root.list-kind == 2 || (root.list-kind == 0 && root.list-last == 2) ? "Numbered list" : "Bulleted list";
        accessible-action-default => { root.activated(7); }
        clicked => {
            if (root.list-held) { root.list-held = false; return; }
            root.activated(7);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.list-held = false; }
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.list-menu(); }
        }
    }

    // held down long enough, the list button opens its flyout
    Timer {
        interval: ToolbarMetrics.list-hold;
        running: h7.pressed && !root.list-held;
        triggered => {
            root.list-held = true;
            root.list-menu();
        }
    }

    // the notch: over the button's corner, so it takes the clicks there
    notch := TouchArea {
        x: Tilt.x(root.f, root.c5 + 11, root.cv + 11) * 1px - self.width / 2;
        y: Tilt.y(root.f, root.c5 + 11, root.cv + 11) * 1px - self.height / 2;
        width: 14px;
        height: 14px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "More list types";
        accessible-action-default => { root.list-menu(); }
        clicked => { root.list-menu(); }
    }
}

/// The list button's flyout: Bulleted and Numbered, side by side in a small body above the toolbar
/// band, its tail at the list button. Drawn in the paper's tilted frame like the color popover; plain
/// hit areas only, so it never takes the keyboard focus. Nothing is drawn or hit while it is not `open`.
export component ListFlyout inherits Rectangle {
    in property <bool> open: false;
    /// The list type of the caret's paragraph (0 none, 1 bulleted, 2 numbered): its choice is filled.
    in property <int> list-kind: 0;
    /// The choice the keyboard has reached: -1 none, 0 bulleted, 1 numbered.
    in property <int> focus-index: -1;
    /// A choice was picked: 1 bulleted, 2 numbered.
    callback pick(int);
    in property <length> paper-x;
    in property <length> paper-y;
    in property <length> paper-w;
    in property <length> paper-h;
    in property <angle> tilt;
    visible: root.open;

    property <Frame> f: {
        w: root.width / 1px,
        h: root.height / 1px,
        cx: (root.paper-x + root.paper-w / 2) / 1px,
        cy: (root.paper-y + root.paper-h / 2) / 1px,
        cs: Math.cos(root.tilt),
        sn: Math.sin(root.tilt),
    };
    property <float> choice: ToolbarMetrics.flyout-choice / 1px;
    property <float> pad: ToolbarMetrics.flyout-pad / 1px;
    property <float> pw: 2 * root.choice + 3 * root.pad;
    property <float> ph: root.choice + 2 * root.pad;
    // the list button's center, from the paper's center (untilted px)
    property <float> button-u: (ToolbarMetrics.first-button-x + 5 * ToolbarMetrics.pitch + ToolbarMetrics.button-size / 2 - root.paper-w / 2) / 1px;
    property <float> pl: root.button-u - root.pw / 2;
    property <float> bottom: (root.paper-h / 2 - ToolbarMetrics.band-height - ToolbarMetrics.flyout-gap) / 1px;
    property <float> top: root.bottom - root.ph;
    property <float> tail-w: ToolbarMetrics.flyout-tail-width / 1px;
    property <float> tail-h: ToolbarMetrics.flyout-tail-height / 1px;
    property <float> r: ToolbarMetrics.flyout-radius / 1px;
    property <float> cv: root.top + root.pad + root.choice / 2;
    property <float> u0: root.pl + root.pad + root.choice / 2;
    property <float> u1: root.u0 + root.choice + root.pad;

    // the shadow: layers of see-through ink (a blur cannot be tilted)
    for k in 4: TRect {
        f: root.f;
        u0: root.pl - k * 3;
        v0: root.top + 5 - k * 3;
        w: root.pw + k * 6;
        h: root.ph + k * 6 + 5;
        r: root.r + k * 3;
        fill: ToolbarMetrics.flyout-shadow;
    }
    TTri {
        f: root.f;
        u0: root.button-u - root.tail-w / 2 - 1; v0: root.bottom - 1;
        u1: root.button-u + root.tail-w / 2 + 1; v1: root.bottom - 1;
        u2: root.button-u; v2: root.bottom + root.tail-h + 1.2;
        fill: ToolbarMetrics.flyout-border;
    }
    TRect { f: root.f; u0: root.pl; v0: root.top; w: root.pw; h: root.ph; r: root.r; fill: ToolbarMetrics.flyout-border; }
    TRect { f: root.f; u0: root.pl + 1; v0: root.top + 1; w: root.pw - 2; h: root.ph - 2; r: root.r - 1; fill: ToolbarMetrics.flyout-fill; }
    TTri {
        f: root.f;
        u0: root.button-u - root.tail-w / 2 + 0.6; v0: root.bottom - 1.5;
        u1: root.button-u + root.tail-w / 2 - 0.6; v1: root.bottom - 1.5;
        u2: root.button-u; v2: root.bottom + root.tail-h - 0.2;
        fill: ToolbarMetrics.flyout-fill;
    }

    // swallows clicks on the body (and the tail) so they reach neither the text nor the dismissal
    TouchArea {
        x: Tilt.x(root.f, root.pl + root.pw / 2, root.top + (root.ph + root.tail-h) / 2) * 1px - self.width / 2;
        y: Tilt.y(root.f, root.pl + root.pw / 2, root.top + (root.ph + root.tail-h) / 2) * 1px - self.height / 2;
        width: root.pw * 1px;
        height: (root.ph + root.tail-h) * 1px;
    }

    // the chosen type is filled; the keyboard's choice has a ring
    for k in [0, 1]: TRect {
        visible: root.list-kind == k + 1;
        f: root.f;
        u0: (k == 0 ? root.u0 : root.u1) - root.choice / 2;
        v0: root.cv - root.choice / 2;
        w: root.choice;
        h: root.choice;
        r: 9;
        fill: ToolbarMetrics.button-fill;
    }
    for k in [0, 1]: TRect {
        visible: root.focus-index == k;
        f: root.f;
        u0: (k == 0 ? root.u0 : root.u1) - root.choice / 2 + 1;
        v0: root.cv - root.choice / 2 + 1;
        w: root.choice - 2;
        h: root.choice - 2;
        r: 8;
        stroke: ToolbarMetrics.focus-ring;
        stroke-width: 2px;
    }
    ListIcon { f: root.f; du: root.u0; dv: root.cv; numbered: false; ink: ToolbarMetrics.ink-active; }
    ListIcon { f: root.f; du: root.u1; dv: root.cv; numbered: true; ink: ToolbarMetrics.ink-active; }

    for k in [0, 1]: TouchArea {
        x: Tilt.x(root.f, k == 0 ? root.u0 : root.u1, root.cv) * 1px - self.width / 2;
        y: Tilt.y(root.f, k == 0 ? root.u0 : root.u1, root.cv) * 1px - self.height / 2;
        width: ToolbarMetrics.flyout-choice;
        height: ToolbarMetrics.flyout-choice;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: k == 0 ? "Bulleted list" : "Numbered list";
        accessible-action-default => { root.pick(k + 1); }
        clicked => { root.pick(k + 1); }
    }
}

/// The menu button ("...") at the top-right of the note.
export component MenuButton inherits Rectangle {
    in property <Frame> f;
    in property <float> du;
    in property <float> dv;
    in property <bool> active: false;
    callback clicked();
    out property <bool> has-hover: hit.has-hover;
    out property <bool> pressed: hit.pressed;
    out property <bool> highlighted: hit.has-hover || root.active;
    out property <length> center-x: Tilt.x(root.f, root.du, root.dv) * 1px;
    out property <length> center-y: Tilt.y(root.f, root.du, root.dv) * 1px;

    property <float> hw: (ToolbarMetrics.menu-button-width / 2) / 1px;
    property <float> hh: (ToolbarMetrics.menu-button-height / 2) / 1px;
    property <color> muted: ToolbarMetrics.ink-muted;
    property <color> ink: ToolbarMetrics.ink-active;

    // Background pill: visible on hover, pressed, or when active (dropdown open)
    TRect {
        f: root.f;
        u0: root.du - root.hw;
        v0: root.dv - root.hh;
        w: 2 * root.hw;
        h: 2 * root.hh;
        r: ToolbarMetrics.menu-button-radius / 1px;
        fill: hit.pressed ? #E0E0DE : (root.highlighted ? #EAEAE8 : transparent);
    }

    // Three horizontal dots:
    // (Path-drawn, not Rectangles: a Rectangle's position snaps to whole pixels, which nudged
    // one dot off the row at some tilts.)
    for offset in [-5.0, 0.0, 5.0]: TRect {
        f: root.f;
        u0: root.du + offset - 1.5;
        v0: root.dv - 1.5;
        w: 3.0;
        h: 3.0;
        r: 1.5;
        fill: root.highlighted ? root.ink : root.muted;
    }

    hit := TouchArea {
        x: Tilt.x(root.f, root.du, root.dv) * 1px - ToolbarMetrics.menu-button-width / 2;
        y: Tilt.y(root.f, root.du, root.dv) * 1px - ToolbarMetrics.menu-button-height / 2;
        width: ToolbarMetrics.menu-button-width;
        height: ToolbarMetrics.menu-button-height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
