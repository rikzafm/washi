// The read-only Settings pages: Shortcuts and Privacy (mockup "Setting Page" artboard). Each is laid
// out in the Paper's tilted frame `pf`; `top` is the first block's top in paper coordinates and
// `bottom` the end of the last block, which the window adds the bottom padding to.

import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { PX, PaperFrame, TapeShape, PText, PBox, PRect, PRule, SettingRow, KeyCap } from "settings-widgets.slint";

export struct ShortcutRow {
    label: string,
    keys: [string],
}

export component ShortcutsPage inherits Rectangle {
    in property <PaperFrame> pf;
    in property <TapeShape> dots;
    in property <float> top;
    in property <[ShortcutRow]> rows;

    // 11 rows of 44px and a 2px dotted rule, then the footnote 18px below (the mockup's gap).
    property <float> rows-bottom: root.top + root.rows.length * 46.0;
    out property <float> bottom: root.rows-bottom + 18.0 + note.preferred-height / 1px;
    x: 0px;
    y: 0px;
    width: root.pf.f.w * 1px;
    height: root.pf.f.h * 1px;

    for row[i] in root.rows : Rectangle {
        accessible-role: list-item;
        accessible-label: row.label;

        PText {
            pf: root.pf;
            a: 36.0;
            b: root.top + i * 46.0 + 4.5;
            width: 220px;
            height: 35px;
            text: row.label;
            font-size: 22px;
            vertical-alignment: center;
        }

        PRule {
            pf: root.pf;
            a: 36.0;
            b: root.top + i * 46.0 + 44.0;
            shape: root.dots;
        }

        HorizontalLayout {
            spacing: 4px;
            x: PX.x(root.pf, 484.0 - self.preferred-width / 2px, root.top + i * 46.0 + 22.5) - self.preferred-width / 2;
            y: PX.y(root.pf, 484.0 - self.preferred-width / 2px, root.top + i * 46.0 + 22.5) - 18px;
            width: self.preferred-width;
            height: 36px;
            for key in row.keys : KeyCap {
                text: key;
            }
        }
    }

    note := PText {
        pf: root.pf;
        a: 36.0;
        b: root.rows-bottom + 18.0;
        width: 448px;
        text: "Shortcuts use the letter your keyboard layout types, so they may not work with a non-Latin layout. The toolbar and the ⋯ menu always do.";
        font-size: 19px;
        color: #5B616B;
        wrap: word-wrap;
        line-height-factor: 30.0 / (19.0 * 1.6064);
        nudge: 3.0;
    }
}

/// One Privacy line: what, a hint under it, and its value chip on the right.
component PrivacyRow inherits SettingRow {
    in property <string> value;
    in property <bool> dark: false;

    KeyCap {
        text: root.value;
        dark: root.dark;
    }
}

export component PrivacyPage inherits Rectangle {
    in property <PaperFrame> pf;
    in property <TapeShape> dots;
    in property <float> top;

    // The lead card: 16px padding around a 32px lock and two 27.5px lines.
    property <float> card-h: 32.0 + max(32.0, 2.0 * 27.5);
    property <float> rows-y: root.top + root.card-h + 18.0;
    property <float> note-y: root.rows-y + r1.total + r2.total + r3.total + 18.0;
    out property <float> bottom: root.note-y + 28.0 + 26.0 + note-t.preferred-height / 1px;
    x: 0px;
    y: 0px;
    width: root.pf.f.w * 1px;
    height: root.pf.f.h * 1px;

    PRect {
        pf: root.pf;
        a: 36.0;
        b: root.top;
        w: 448.0;
        h: root.card-h;
        r: 10.8;
        fill: #F0F0EE;
    }

    // The lock: a 24-unit icon drawn at 32px (stroke 1.8 units).
    PBox {
        pf: root.pf;
        a: 54.0;
        b: root.top + (root.card-h - 32.0) / 2.0;
        width: 32px;
        height: 32px;

        Path {
            width: 32px;
            height: 32px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 7 11 L 17 11 A 2 2 0 0 1 19 13 L 19 18 A 2 2 0 0 1 17 20 L 7 20 A 2 2 0 0 1 5 18 L 5 13 A 2 2 0 0 1 7 11 Z M 8 11 L 8 8 A 4 4 0 0 1 16 8 L 16 11";
            stroke: #2B2F36;
            stroke-width: 1.8px;
            stroke-line-join: round;
            stroke-line-cap: round;
        }
    }

    PText {
        pf: root.pf;
        a: 100.0;
        b: root.top + 16.0;
        width: 340px;
        height: 27.5px;
        text: "Locked on disk";
        font-size: 22px;
        font-weight: 700;
        vertical-alignment: center;
    }

    PText {
        pf: root.pf;
        a: 100.0;
        b: root.top + 16.0 + 27.5;
        width: 340px;
        height: 27.5px;
        text: "Your notes are stored in an encrypted database.";
        font-size: 18px;
        color: #5B616B;
        vertical-alignment: center;
    }

    r1 := PrivacyRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.rows-y;
        label: "Unlocks with your Windows account";
        hint: "No password to remember or type";
        value: "Automatic";
        dark: true;
    }

    r2 := PrivacyRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.rows-y + r1.total;
        label: "Stays on this computer";
        hint: "Nothing is sent anywhere";
        value: "Offline";
    }

    r3 := PrivacyRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.rows-y + r1.total + r2.total;
        rule: false;
        label: "Deleted notes";
        hint: "Delete asks first, then it is final";
        value: "Permanent";
    }

    // The key note (20px on 26px lines, 14px / 18px padding): a bold lead with the first words of the
    // rest after it on the first line (one paragraph in the mockup, whose runs differ in weight and
    // colour), then the rest wrapping under it.
    PRect {
        pf: root.pf;
        a: 36.0;
        b: root.note-y;
        w: 448.0;
        h: 28.0 + 26.0 + note-t.preferred-height / 1px;
        r: 10.8;
        fill: #F0F0EE;
    }

    lead-t := PText {
        pf: root.pf;
        a: 54.0;
        b: root.note-y + 14.0;
        height: 26px;
        text: "No backup of the key.";
        font-size: 20px;
        font-weight: 700;
        vertical-alignment: center;
    }

    PText {
        pf: root.pf;
        a: 54.0 + lead-t.preferred-width / 1px + 5.0;
        b: root.note-y + 14.0;
        height: 26px;
        text: "It belongs to this Windows";
        font-size: 19px;
        color: #5B616B;
        vertical-alignment: center;
    }

    note-t := PText {
        pf: root.pf;
        a: 54.0;
        b: root.note-y + 14.0 + 26.0;
        width: 412px;
        text: "account. If the profile is reset, the notes cannot be opened. Export as Markdown to keep a copy.";
        font-size: 19px;
        color: #5B616B;
        wrap: word-wrap;
        nudge: 3.0;
        line-height-factor: 26.0 / (19.0 * 1.6064);
    }
}
