// All Notes ("Notes") in place: a sidebar to the left of the note's own window, and the bottom
// action bar that replaces the formatting toolbar while the list is open.
//
// The note window grows to the left by `AllNotesMetrics.sidebar-w`; the paper (the real editor)
// keeps its place on screen. The sidebar is drawn in the window's left strip, tilted -1deg like
// the mockup, with a slate backing so the dark text reads on any wallpaper.

import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { Frame, Tilt, TRect } from "toolbar.slint";

export global AllNotesMetrics {
    /// Width of the strip the sidebar adds to the left of the note window.
    out property <length> sidebar-w: 282px;
}

export struct AllNoteItem {
    id: int,
    title: string,
    is-open: bool,
}

/// One row (title in a pill), drawn in the tilted frame `f`; `t` is the row's top measured from the
/// panel's top edge (the frame's center is `ph / 2` below it).
component SidebarRow inherits Rectangle {
    in property <AllNoteItem> item;
    in property <bool> selected: false;
    in property <Frame> f;
    in property <float> v0;
    callback clicked();
    callback double-clicked();
    callback scrolled(length) -> EventResult;

    x: 0px;
    y: 0px;
    width: root.f.w * 1px;
    height: root.f.h * 1px;

    for growth in [6.0, 4.0, 2.0, 0.5]: TRect {
        visible: root.selected;
        f: root.f;
        u0: -123.0 - growth;
        v0: root.v0 - growth + 3.0;
        w: 246.0 + 2.0 * growth;
        h: 52.0 + 2.0 * growth;
        r: 8.0 + growth;
        fill: #00000006;
    }

    if root.selected : TRect {
        f: root.f;
        u0: -123.0;
        v0: root.v0;
        w: 246.0;
        h: 52.0;
        r: 10.8;
        fill: #FFFFFD;
    }

    Text {
        x: Tilt.x(root.f, -107.0, root.v0) * 1px;
        y: Tilt.y(root.f, -107.0, root.v0) * 1px;
        width: 214px;
        height: 52px;
        text: root.item.title;
        font-family: "Shadows Into Light";
        font-size: 22px;
        font-weight: root.selected ? 700 : 400;
        color: #2B2F36;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        x: Tilt.x(root.f, -123.0, root.v0) * 1px;
        y: Tilt.y(root.f, -123.0, root.v0) * 1px;
        width: 246px;
        height: 52px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        scroll-event(e) => { return root.scrolled(e.delta-y); }
    }
}

export component AllNotesSidebar inherits Rectangle {
    in property <int> selected-note-id: -1;
    in property <int> open-count: 0;
    in property <int> closed-count: 0;
    in property <[AllNoteItem]> open-notes: [];
    in property <[AllNoteItem]> closed-notes: [];
    in-out property <float> scroll-y: 0.0;

    callback select-note(int);
    callback open-note(int);
    callback new-note();
    /// The user pressed the sidebar itself (not a row or the button): the platform drags the window.
    callback start-move();

    // The panel, in window px: 210 wide at x = 8, as tall as the paper (the window minus the margin).
    property <float> pw: 270.0;
    property <float> ph: max(240.0, root.height / 1px - 84.0);
    property <float> pcx: 143.0;
    property <float> pcy: root.height / 1px / 2.0;
    property <float> header-h: 104.0;
    property <float> row-pitch: 54.0;

    property <float> n-open: root.open-notes.length;
    property <float> n-closed: root.closed-notes.length;
    // The list: two labels and the rows.
    property <float> content-h: 30.0 + root.n-open * root.row-pitch + 14.0 + 30.0 + root.n-closed * root.row-pitch;
    // The button follows the last row while everything fits; once it would not, it is fixed at
    // the panel's bottom and only the rows scroll above it.
    property <float> fit-h: root.ph - root.header-h - 16.0 - 44.0 - 14.0;
    property <bool> overflow: root.content-h > root.fit-h;
    property <float> vp-h: root.overflow ? root.ph - root.header-h - 16.0 - 44.0 - 10.0 : root.content-h;
    property <float> btn-t: root.overflow ? root.ph - 16.0 - 44.0 : root.header-h + root.content-h + 14.0;
    out property <float> max-scroll: root.overflow ? root.content-h - root.vp-h : 0.0;
    changed max-scroll => {
        if (root.scroll-y > root.max-scroll) {
            root.scroll-y = root.max-scroll;
        }
    }

    function scroll-by(delta-y: length) -> EventResult {
        if (root.max-scroll <= 0.0) { return reject; }
        root.scroll-y = clamp(root.scroll-y - (delta-y / 1px), 0.0, root.max-scroll);
        return accept;
    }

    // The panel's frame in window px, and the same frame in the list viewport's own coordinates.
    property <Frame> pf: {
        w: AllNotesMetrics.sidebar-w / 1px,
        h: root.height / 1px,
        cx: root.pcx,
        cy: root.pcy,
        cs: Math.cos(-1.0deg),
        sn: Math.sin(-1.0deg),
    };
    property <float> clip-y: root.pcy - root.ph / 2.0 + root.header-h - 6.0;
    property <Frame> lf: {
        w: AllNotesMetrics.sidebar-w / 1px,
        h: root.vp-h + 12.0,
        cx: root.pcx,
        cy: root.pcy - root.clip-y,
        cs: Math.cos(-1.0deg),
        sn: Math.sin(-1.0deg),
    };
    // The top of the panel from its center, for `v` values.
    property <float> top-v: -root.ph / 2.0;

    // Dragging the sidebar's empty parts moves the whole window.
    TouchArea {
        x: 0px;
        y: 0px;
        width: AllNotesMetrics.sidebar-w;
        height: root.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.start-move();
            }
        }
        scroll-event(e) => { return root.scroll-by(e.delta-y); }
    }

    // Backing: the mockup's slate desk color behind the list.
    TRect {
        f: root.pf;
        u0: -root.pw / 2.0;
        v0: root.top-v;
        w: root.pw;
        h: root.ph;
        r: 22.0;
        fill: #D6DBE2;
    }

    Text {
        x: Tilt.x(root.pf, -113.0, root.top-v + 8.0) * 1px;
        y: Tilt.y(root.pf, -113.0, root.top-v + 8.0) * 1px;
        text: "Notes";
        font-family: "Shadows Into Light";
        font-size: 44px;
        color: #2B2F36;
    }

    Text {
        x: Tilt.x(root.pf, -113.0, root.top-v + 68.0) * 1px;
        y: Tilt.y(root.pf, -113.0, root.top-v + 68.0) * 1px;
        text: root.open-count + " open · " + root.closed-count + " closed";
        font-family: "Shadows Into Light";
        font-size: 18px;
        color: #5B616B;
    }

    // The list viewport: rows scroll inside it and never over the header or the button.
    Rectangle {
        x: 0px;
        y: root.clip-y * 1px;
        width: AllNotesMetrics.sidebar-w;
        height: (root.vp-h + 12.0) * 1px;
        clip: true;

        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            scroll-event(e) => { return root.scroll-by(e.delta-y); }
        }

        Text {
            x: Tilt.x(root.lf, -119.0, root.top-v + root.header-h + 4.0 - root.scroll-y) * 1px;
            y: Tilt.y(root.lf, -119.0, root.top-v + root.header-h + 4.0 - root.scroll-y) * 1px;
            text: "OPEN";
            font-family: "Shadows Into Light";
            font-size: 18px;
            letter-spacing: 0.72px;
            color: #5B616B;
        }

        for item[i] in root.open-notes: SidebarRow {
            item: item;
            selected: item.id == root.selected-note-id;
            f: root.lf;
            v0: root.top-v + root.header-h + 30.0 + i * root.row-pitch - root.scroll-y;
            clicked => { root.select-note(item.id); }
            double-clicked => { root.open-note(item.id); }
            scrolled(dy) => { return root.scroll-by(dy); }
        }

        Text {
            x: Tilt.x(root.lf, -119.0, root.top-v + root.header-h + 30.0 + root.n-open * root.row-pitch + 18.0 - root.scroll-y) * 1px;
            y: Tilt.y(root.lf, -119.0, root.top-v + root.header-h + 30.0 + root.n-open * root.row-pitch + 18.0 - root.scroll-y) * 1px;
            text: "CLOSED";
            font-family: "Shadows Into Light";
            font-size: 18px;
            letter-spacing: 0.72px;
            color: #5B616B;
        }

        for item[j] in root.closed-notes: SidebarRow {
            item: item;
            selected: item.id == root.selected-note-id;
            f: root.lf;
            v0: root.top-v + root.header-h + 30.0 + root.n-open * root.row-pitch + 14.0 + 30.0 + j * root.row-pitch - root.scroll-y;
            clicked => { root.select-note(item.id); }
            double-clicked => { root.open-note(item.id); }
            scrolled(dy) => { return root.scroll-by(dy); }
        }
    }

    // "+ New note" button
    TRect {
        f: root.pf;
        u0: -123.0;
        v0: root.top-v + root.btn-t;
        w: 124.0;
        h: 44.0;
        r: 10.8;
        fill: #2B2F36;
    }

    Text {
        x: Tilt.x(root.pf, -123.0, root.top-v + root.btn-t) * 1px;
        y: Tilt.y(root.pf, -123.0, root.top-v + root.btn-t) * 1px;
        width: 124px;
        height: 44px;
        text: "+ New note";
        font-family: "Shadows Into Light";
        font-size: 21px;
        color: #FFFFFD;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        x: Tilt.x(root.pf, -123.0, root.top-v + root.btn-t) * 1px;
        y: Tilt.y(root.pf, -123.0, root.top-v + root.btn-t) * 1px;
        width: 124px;
        height: 44px;
        mouse-cursor: pointer;
        clicked => { root.new-note(); }
        scroll-event(e) => { return root.scroll-by(e.delta-y); }
    }
}

/// The bottom bar of the paper while the list is open: open/focus, close, export and delete, or the
/// "Delete for good?" confirmation. It sits where the formatting toolbar does, in the paper's
/// tilted frame `f` (`paper-w` x `paper-h`, in px).
export component AllNotesActionBar inherits Rectangle {
    in property <Frame> f;
    in property <float> paper-w;
    in property <float> paper-h;
    in property <bool> selected-note-open: false;
    in-out property <bool> confirming-delete: false;

    callback open-or-focus-note();
    callback close-note();
    callback export-note();
    callback request-delete();
    callback cancel-delete();
    callback confirm-delete();

    // Same cells as the formatting toolbar: first button at 23.2 px from the left edge, 32 px
    // buttons on a 42.667 px pitch, their centers 24 px above the paper's bottom.
    property <float> left: -root.paper-w / 2.0 + 23.2;
    property <float> cv: root.paper-h / 2.0 - 24.0;

    x: 0px;
    y: 0px;
    width: root.f.w * 1px;
    height: root.f.h * 1px;

    if !root.confirming-delete : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        TRect {
            f: root.f;
            u0: root.left;
            v0: root.cv - 16.0;
            w: 32.0;
            h: 32.0;
            r: 8.6;
            fill: root.selected-note-open ? #F0F0EE : (open-hit.has-hover ? #F0F0EE : transparent);
        }

        Path {
            x: Tilt.x(root.f, root.left + 16.0, root.cv) * 1px - 8px;
            y: Tilt.y(root.f, root.left + 16.0, root.cv) * 1px - 8px;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5";
            fill: transparent;
            stroke: root.selected-note-open ? #2B2F36 : #5B616B;
            stroke-width: 1.3px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        open-hit := TouchArea {
            x: Tilt.x(root.f, root.left + 16.0, root.cv) * 1px - 16px;
            y: Tilt.y(root.f, root.left + 16.0, root.cv) * 1px - 16px;
            width: 32px;
            height: 32px;
            mouse-cursor: pointer;
            clicked => { root.open-or-focus-note(); }
        }

        TRect {
            f: root.f;
            u0: root.left + 42.667;
            v0: root.cv - 16.0;
            w: 32.0;
            h: 32.0;
            r: 8.6;
            fill: close-hit.has-hover ? #F0F0EE : transparent;
        }

        Path {
            x: Tilt.x(root.f, root.left + 42.667 + 16.0, root.cv) * 1px - 7px;
            y: Tilt.y(root.f, root.left + 42.667 + 16.0, root.cv) * 1px - 7px;
            width: 14px;
            height: 14px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M6 6l12 12M18 6L6 18";
            fill: transparent;
            stroke: #5B616B;
            stroke-width: 1.35px;
            stroke-line-cap: round;
        }

        close-hit := TouchArea {
            x: Tilt.x(root.f, root.left + 42.667 + 16.0, root.cv) * 1px - 16px;
            y: Tilt.y(root.f, root.left + 42.667 + 16.0, root.cv) * 1px - 16px;
            width: 32px;
            height: 32px;
            mouse-cursor: pointer;
            clicked => { root.close-note(); }
        }

        TRect {
            f: root.f;
            u0: root.left + 2.0 * 42.667;
            v0: root.cv - 16.0;
            w: 32.0;
            h: 32.0;
            r: 8.6;
            fill: export-hit.has-hover ? #F0F0EE : transparent;
        }

        Path {
            x: Tilt.x(root.f, root.left + 2.0 * 42.667 + 16.0, root.cv) * 1px - 8px;
            y: Tilt.y(root.f, root.left + 2.0 * 42.667 + 16.0, root.cv) * 1px - 8px;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 4.5v10M8 10.5l4 4 4-4M5.5 19.5h13";
            fill: transparent;
            stroke: #5B616B;
            stroke-width: 1.35px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        export-hit := TouchArea {
            x: Tilt.x(root.f, root.left + 2.0 * 42.667 + 16.0, root.cv) * 1px - 16px;
            y: Tilt.y(root.f, root.left + 2.0 * 42.667 + 16.0, root.cv) * 1px - 16px;
            width: 32px;
            height: 32px;
            mouse-cursor: pointer;
            clicked => { root.export-note(); }
        }

        TRect {
            f: root.f;
            u0: root.left + 3.0 * 42.667;
            v0: root.cv - 16.0;
            w: 32.0;
            h: 32.0;
            r: 8.6;
            fill: del-hit.has-hover ? #F6E7E9 : transparent;
        }

        Path {
            x: Tilt.x(root.f, root.left + 3.0 * 42.667 + 16.0, root.cv) * 1px - 8px;
            y: Tilt.y(root.f, root.left + 3.0 * 42.667 + 16.0, root.cv) * 1px - 8px;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13";
            fill: transparent;
            stroke: #8A1F2B;
            stroke-width: 1.3px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        del-hit := TouchArea {
            x: Tilt.x(root.f, root.left + 3.0 * 42.667 + 16.0, root.cv) * 1px - 16px;
            y: Tilt.y(root.f, root.left + 3.0 * 42.667 + 16.0, root.cv) * 1px - 16px;
            width: 32px;
            height: 32px;
            mouse-cursor: pointer;
            clicked => {
                root.confirming-delete = true;
                root.request-delete();
            }
        }
    }

    if root.confirming-delete : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        // "Delete for good?" word by word along the paper's baseline
        Text {
            x: Tilt.x(root.f, root.left + 2.0, root.cv) * 1px;
            y: Tilt.y(root.f, root.left + 2.0, root.cv) * 1px - 11px;
            height: 22px;
            text: "Delete";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.4px;
            color: #2B2F36;
            vertical-alignment: center;
        }

        Text {
            x: Tilt.x(root.f, root.left + 36.0, root.cv) * 1px;
            y: Tilt.y(root.f, root.left + 36.0, root.cv) * 1px - 11px;
            height: 22px;
            text: "for";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.4px;
            color: #2B2F36;
            vertical-alignment: center;
        }

        Text {
            x: Tilt.x(root.f, root.left + 54.0, root.cv) * 1px;
            y: Tilt.y(root.f, root.left + 54.0, root.cv) * 1px - 11px;
            height: 22px;
            text: "good?";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.4px;
            color: #2B2F36;
            vertical-alignment: center;
        }

        // "Keep"
        TRect {
            f: root.f;
            u0: root.left + 100.0;
            v0: root.cv - 15.0;
            w: 54.0;
            h: 30.0;
            r: 7.5;
            fill: keep-hit.pressed ? #E4E4E2 : (keep-hit.has-hover ? #EAEAE8 : #F0F0EE);
        }

        Text {
            x: Tilt.x(root.f, root.left + 100.0, root.cv - 15.0) * 1px;
            y: Tilt.y(root.f, root.left + 100.0, root.cv - 15.0) * 1px;
            width: 54px;
            height: 30px;
            text: "Keep";
            font-family: "Shadows Into Light";
            font-size: 14.2px;
            color: #2B2F36;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        keep-hit := TouchArea {
            x: Tilt.x(root.f, root.left + 100.0, root.cv - 15.0) * 1px;
            y: Tilt.y(root.f, root.left + 100.0, root.cv - 15.0) * 1px;
            width: 54px;
            height: 30px;
            mouse-cursor: pointer;
            clicked => {
                root.confirming-delete = false;
                root.cancel-delete();
            }
        }

        // "Delete"
        TRect {
            f: root.f;
            u0: root.left + 160.0;
            v0: root.cv - 15.0;
            w: 60.0;
            h: 30.0;
            r: 7.5;
            fill: confirm-hit.pressed ? #721923 : (confirm-hit.has-hover ? #9B2331 : #8A1F2B);
        }

        Text {
            x: Tilt.x(root.f, root.left + 160.0, root.cv - 15.0) * 1px;
            y: Tilt.y(root.f, root.left + 160.0, root.cv - 15.0) * 1px;
            width: 60px;
            height: 30px;
            text: "Delete";
            font-family: "Shadows Into Light";
            font-size: 13.8px;
            color: #FFFFFD;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        confirm-hit := TouchArea {
            x: Tilt.x(root.f, root.left + 160.0, root.cv - 15.0) * 1px;
            y: Tilt.y(root.f, root.left + 160.0, root.cv - 15.0) * 1px;
            width: 60px;
            height: 30px;
            mouse-cursor: pointer;
            clicked => {
                root.confirm-delete();
            }
        }
    }
}
