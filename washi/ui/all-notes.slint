// All Notes ("Notes") window shell.
// Canvas: 603 x 625 logical px, desk color #D6DBE2.

import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { PaperTheme } from "paper-theme.slint";
import { PaperGeometry } from "paper.slint";
import { Frame, Tilt, TRect } from "toolbar.slint";

export struct AllNoteItem {
    id: int,
    title: string,
    is-open: bool,
}

export struct PreviewRun {
    text: string,
    u: float,
    v: float,
    dx: float,
    dy: float,
    width: float,
    size: float,
    bold: bool,
    italic: bool,
    color: color,
}

component SidebarRow inherits Rectangle {
    in property <AllNoteItem> item;
    in property <bool> selected: false;
    in property <float> row-cy;
    in property <length> text-x: 41px;
    in property <length> text-y;
    callback clicked();

    x: 0px;
    y: 0px;
    width: 603px;
    height: 625px;

    property <Frame> pill-frame: {
        w: 603.0,
        h: 625.0,
        cx: 124.0,
        cy: root.row-cy,
        cs: Math.cos(-1.0deg),
        sn: Math.sin(-1.0deg),
    };

    for growth in [6.0, 4.0, 2.0, 0.5]: TRect {
        visible: root.selected;
        f: root.pill-frame;
        u0: -94.0 - growth;
        v0: -17.5 - growth + 2.5;
        w: 188.0 + 2.0 * growth;
        h: 35.0 + 2.0 * growth;
        r: 8.0 + growth;
        fill: #00000008;
    }

    if root.selected : TRect {
        f: root.pill-frame;
        u0: -94.0;
        v0: -17.5;
        w: 188.0;
        h: 35.0;
        r: 8.0;
        fill: #FFFFFD;
    }

    Text {
        x: root.text-x;
        y: root.text-y;
        width: 170px;
        text: root.item.title;
        font-family: "Shadows Into Light";
        font-size: 15.5px;
        font-weight: root.selected ? 700 : 400;
        color: #2B2F36;
        overflow: elide;
    }

    TouchArea {
        x: 30px;
        y: (root.row-cy - 17.5) * 1px;
        width: 188px;
        height: 35px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AllNotesWindow inherits Window {
    title: "All Notes";
    width: 603px;
    height: 625px;
    no-frame: true;
    background: #D6DBE2;

    in-out property <int> selected-note-id: -1;
    in-out property <int> open-count: 0;
    in-out property <int> closed-count: 0;
    in-out property <[AllNoteItem]> open-notes: [];
    in-out property <[AllNoteItem]> closed-notes: [];
    in-out property <bool> selected-note-open: false;
    in-out property <bool> confirming-delete: false;
    in-out property <string> status-text: "";
    in-out property <[PreviewRun]> status-runs: [];
    in-out property <[PreviewRun]> preview-runs: [];

    callback close-window();
    callback select-note(int);
    callback new-note();
    callback open-or-focus-note();
    callback close-note();
    callback export-note();
    callback request-delete();
    callback cancel-delete();
    callback confirm-delete();

    property <float> closed-header-y: 217.0 + root.open-notes.length * 42.0;
    property <float> new-button-cy: root.closed-header-y + 45.5 + root.closed-notes.length * 38.0;
    property <Frame> new-button-frame: {
        w: 603.0,
        h: 625.0,
        cx: 83.5,
        cy: root.new-button-cy,
        cs: Math.cos(-1.0deg),
        sn: Math.sin(-1.0deg),
    };
    property <Frame> paper-frame: {
        w: 603.0,
        h: 625.0,
        cx: 411.4,
        cy: 311.1,
        cs: Math.cos(1.5deg),
        sn: Math.sin(1.5deg),
    };

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (root.confirming-delete) {
                    root.confirming-delete = false;
                    root.cancel-delete();
                } else {
                    root.close-window();
                }
                return accept;
            }
            reject
        }
    }

    // --- Left Sidebar ("Notes") ---
    Text {
        x: 33px;
        y: 114px;
        text: "Notes";
        font-family: "Shadows Into Light";
        font-size: 30px;
        color: #2B2F36;
    }

    Text {
        x: 33px;
        y: 161px;
        text: root.open-count + " open · " + root.closed-count + " closed";
        font-family: "Shadows Into Light";
        font-size: 13px;
        color: #5B616B;
    }

    Text {
        x: 39px;
        y: 195px;
        text: "OPEN";
        font-family: "Shadows Into Light";
        font-size: 13px;
        letter-spacing: 0.5px;
        color: #5B616B;
    }

    for item[i] in root.open-notes: SidebarRow {
        item: item;
        selected: item.id == root.selected-note-id;
        row-cy: 234.5 + i * 42.0;
        text-x: 41px;
        text-y: (222.0 + i * 42.0) * 1px;
        clicked => {
            root.confirming-delete = false;
            root.select-note(item.id);
        }
    }

    Text {
        x: 41px;
        y: root.closed-header-y * 1px;
        text: "CLOSED";
        font-family: "Shadows Into Light";
        font-size: 13px;
        letter-spacing: 0.5px;
        color: #5B616B;
    }

    for item[j] in root.closed-notes: SidebarRow {
        item: item;
        selected: item.id == root.selected-note-id;
        row-cy: root.closed-header-y + 39.5 + j * 38.0;
        text-x: 42px;
        text-y: (root.closed-header-y + 26.0 + j * 38.0) * 1px;
        clicked => {
            root.confirming-delete = false;
            root.select-note(item.id);
        }
    }

    // "+ New note" button
    TRect {
        f: root.new-button-frame;
        u0: -45.5;
        v0: -15.0;
        w: 91.0;
        h: 30.0;
        r: 8.0;
        fill: #2B2F36;
    }

    Text {
        x: (83.5 - 45.5) * 1px;
        y: (root.new-button-cy - 15.0) * 1px;
        width: 91px;
        height: 30px;
        text: "+ New note";
        font-family: "Shadows Into Light";
        font-size: 14.5px;
        color: #FFFFFD;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        x: (83.5 - 45.5) * 1px;
        y: (root.new-button-cy - 15.0) * 1px;
        width: 91px;
        height: 30px;
        mouse-cursor: pointer;
        clicked => {
            root.confirming-delete = false;
            root.new-note();
        }
    }

    // --- Right Preview Card ---
    for growth[i] in PaperTheme.shadow-growths: Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: PaperGeometry.quad(
            411.4px, 311.1px + PaperTheme.shadow-offset-y,
            167px + growth, 209px + growth);
        fill: PaperTheme.shadow-colors[i];
    }

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: PaperGeometry.quad(411.4px, 311.1px, 167px, 209px);
        fill: #FFFFFD;
    }

    for r in root.status-runs: Text {
        x: (244.4 + r.u + r.dx) * 1px;
        y: (102.1 + r.v + r.dy) * 1px;
        text: r.text;
        wrap: no-wrap;
        font-family: "Shadows Into Light";
        font-size: r.size * 1px;
        font-weight: r.bold ? 700 : 400;
        font-italic: r.italic;
        color: r.color;
    }

    for r in root.preview-runs: Text {
        x: (244.4 + r.u + r.dx) * 1px;
        y: (102.1 + r.v + r.dy) * 1px;
        text: r.text;
        wrap: no-wrap;
        font-family: "Shadows Into Light";
        font-size: r.size * 1px;
        font-weight: r.bold ? 700 : 400;
        font-italic: r.italic;
        color: r.color;
    }

    // --- Bottom Bar: Normal State (4 tilted icon buttons) ---
    if !root.confirming-delete && root.selected-note-id >= 0 : Rectangle {
        x: 0px;
        y: 0px;
        width: 603px;
        height: 625px;

        // 1. Open / Focus on desktop (u_center = 39.5, du = -127.5, dv = 181.5)
        TRect {
            f: root.paper-frame;
            u0: -127.5 - 15.5;
            v0: 181.5 - 15.5;
            w: 31.0;
            h: 31.0;
            r: 8.0;
            fill: root.selected-note-open ? #F0F0EE : (open-hit.has-hover ? #F0F0EE : transparent);
        }

        Path {
            x: Tilt.x(root.paper-frame, -127.5, 181.5) * 1px - 8px;
            y: Tilt.y(root.paper-frame, -127.5, 181.5) * 1px - 8px;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M9 9h10v10H9zM5 15H4V4h11v1";
            fill: transparent;
            stroke: root.selected-note-open ? #2B2F36 : #5B616B;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        open-hit := TouchArea {
            x: Tilt.x(root.paper-frame, -127.5, 181.5) * 1px - 15.5px;
            y: Tilt.y(root.paper-frame, -127.5, 181.5) * 1px - 15.5px;
            width: 31px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => { root.open-or-focus-note(); }
        }

        // 2. Close (×) (u_center = 76.5, du = -90.5, dv = 181.5)
        TRect {
            f: root.paper-frame;
            u0: -90.5 - 15.5;
            v0: 181.5 - 15.5;
            w: 31.0;
            h: 31.0;
            r: 8.0;
            fill: close-hit.has-hover ? #F0F0EE : transparent;
        }

        Path {
            x: Tilt.x(root.paper-frame, -90.5, 181.5) * 1px - 7px;
            y: Tilt.y(root.paper-frame, -90.5, 181.5) * 1px - 7px;
            width: 14px;
            height: 14px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M6 6l12 12M18 6L6 18";
            fill: transparent;
            stroke: #5B616B;
            stroke-width: 1.6px;
            stroke-line-cap: round;
        }

        close-hit := TouchArea {
            x: Tilt.x(root.paper-frame, -90.5, 181.5) * 1px - 15.5px;
            y: Tilt.y(root.paper-frame, -90.5, 181.5) * 1px - 15.5px;
            width: 31px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => { root.close-note(); }
        }

        // 3. Export (↓) (u_center = 112.5, du = -54.5, dv = 181.5)
        TRect {
            f: root.paper-frame;
            u0: -54.5 - 15.5;
            v0: 181.5 - 15.5;
            w: 31.0;
            h: 31.0;
            r: 8.0;
            fill: export-hit.has-hover ? #F0F0EE : transparent;
        }

        Path {
            x: Tilt.x(root.paper-frame, -54.5, 181.5) * 1px - 7.5px;
            y: Tilt.y(root.paper-frame, -54.5, 181.5) * 1px - 7.5px;
            width: 15px;
            height: 15px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 4v11M7.5 11l4.5 4.5 4.5-4.5M5 19.5h14";
            fill: transparent;
            stroke: #5B616B;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        export-hit := TouchArea {
            x: Tilt.x(root.paper-frame, -54.5, 181.5) * 1px - 15.5px;
            y: Tilt.y(root.paper-frame, -54.5, 181.5) * 1px - 15.5px;
            width: 31px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => { root.export-note(); }
        }

        // 4. Delete (🗑) (u_center = 149.0, du = -18.0, dv = 181.5)
        TRect {
            f: root.paper-frame;
            u0: -18.0 - 15.5;
            v0: 181.5 - 15.5;
            w: 31.0;
            h: 31.0;
            r: 8.0;
            fill: del-hit.has-hover ? #F6E7E9 : transparent;
        }

        Path {
            x: Tilt.x(root.paper-frame, -18.0, 181.5) * 1px - 8px;
            y: Tilt.y(root.paper-frame, -18.0, 181.5) * 1px - 8px;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13";
            fill: transparent;
            stroke: #8A1F2B;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        del-hit := TouchArea {
            x: Tilt.x(root.paper-frame, -18.0, 181.5) * 1px - 15.5px;
            y: Tilt.y(root.paper-frame, -18.0, 181.5) * 1px - 15.5px;
            width: 31px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => {
                root.confirming-delete = true;
                root.request-delete();
            }
        }
    }

    // --- Bottom Bar: Delete Confirmation State ---
    if root.confirming-delete && root.selected-note-id >= 0 : Rectangle {
        x: 0px;
        y: 0px;
        width: 603px;
        height: 625px;

        // "Delete for good?" along the 1.5deg paper baseline (u = 25px, v = 378px)
        Text {
            x: (Tilt.x(root.paper-frame, -124.0, 180.0) - 18.0) * 1px;
            y: (Tilt.y(root.paper-frame, -124.0, 180.0) - 11.0) * 1px;
            text: "Delete";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.5px;
            color: #2B2F36;
        }

        Text {
            x: (Tilt.x(root.paper-frame, -94.0, 180.0) - 8.5) * 1px;
            y: (Tilt.y(root.paper-frame, -94.0, 180.0) - 11.0) * 1px;
            text: "for";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.5px;
            color: #2B2F36;
        }

        Text {
            x: (Tilt.x(root.paper-frame, -66.0, 180.0) - 16.0) * 1px;
            y: (Tilt.y(root.paper-frame, -66.0, 180.0) - 11.0) * 1px;
            text: "good?";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.5px;
            color: #2B2F36;
        }

        // "Keep" button (u0 = 191 - 167 = 24.0, v0 = 376 - 209 = 167.0, w = 53, h = 31, r = 7.5)
        TRect {
            f: root.paper-frame;
            u0: 24.0;
            v0: 167.0;
            w: 53.0;
            h: 31.0;
            r: 7.5;
            fill: keep-hit.pressed ? #E4E4E2 : (keep-hit.has-hover ? #EAEAE8 : #F0F0EE);
        }

        Text {
            x: Tilt.x(root.paper-frame, 50.5, 182.5) * 1px - 26.5px;
            y: Tilt.y(root.paper-frame, 50.5, 182.5) * 1px - 15.5px;
            width: 53px;
            height: 31px;
            text: "Keep";
            font-family: "Shadows Into Light";
            font-size: 14.5px;
            color: #2B2F36;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        keep-hit := TouchArea {
            x: Tilt.x(root.paper-frame, 50.5, 182.5) * 1px - 26.5px;
            y: Tilt.y(root.paper-frame, 50.5, 182.5) * 1px - 15.5px;
            width: 53px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => {
                root.confirming-delete = false;
                root.cancel-delete();
            }
        }

        // "Delete" button (u0 = 251 - 167 = 84.0, v0 = 376 - 209 = 167.0, w = 58, h = 31, r = 7.5)
        TRect {
            f: root.paper-frame;
            u0: 84.0;
            v0: 167.0;
            w: 58.0;
            h: 31.0;
            r: 7.5;
            fill: confirm-hit.pressed ? #721923 : (confirm-hit.has-hover ? #9B2331 : #8A1F2B);
        }

        Text {
            x: Tilt.x(root.paper-frame, 113.0, 182.5) * 1px - 29px;
            y: Tilt.y(root.paper-frame, 113.0, 182.5) * 1px - 15.5px;
            width: 58px;
            height: 31px;
            text: "Delete";
            font-family: "Shadows Into Light";
            font-size: 14.5px;
            color: #FFFFFD;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        confirm-hit := TouchArea {
            x: Tilt.x(root.paper-frame, 113.0, 182.5) * 1px - 29px;
            y: Tilt.y(root.paper-frame, 113.0, 182.5) * 1px - 15.5px;
            width: 58px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => {
                root.confirm-delete();
            }
        }
    }

    Image {
        source: @image-url("assets/tape-pink.png");
        width: self.source.width / 3 * 1px;
        height: self.source.height / 3 * 1px;
        x: 281.2px - self.width / 2;
        y: 111.1px - self.height / 2;
    }

    Image {
        source: @image-url("assets/tape-blue.png");
        width: self.source.width / 3 * 1px;
        height: self.source.height / 3 * 1px;
        x: 545.2px - self.width / 2;
        y: 518.9px - self.height / 2;
    }
}
