// All Notes ("Notes") in-place sidebar and paper overlay components.
// Embedded inside NoteWindow (603 x 625 logical px, transparent window background).

import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { Frame, Tilt, TRect } from "toolbar.slint";

export struct AllNoteItem {
    id: int,
    title: string,
    is-open: bool,
}

export struct PreviewRun {
    text: string,
    u: float,
    v: float,
    dx: float,
    dy: float,
    width: float,
    size: float,
    bold: bool,
    italic: bool,
    color: color,
}

component SidebarRow inherits Rectangle {
    in property <AllNoteItem> item;
    in property <bool> selected: false;
    in property <float> row-cy;
    in property <length> text-x: 41px;
    in property <length> text-y;
    callback clicked();
    callback scrolled(length) -> EventResult;

    x: 0px;
    y: 0px;
    width: 603px;
    height: 625px;

    property <Frame> pill-frame: {
        w: 603.0,
        h: 625.0,
        cx: 124.8,
        cy: root.row-cy,
        cs: Math.cos(-1.0deg),
        sn: Math.sin(-1.0deg),
    };

    for growth in [6.0, 4.0, 2.0, 0.5]: TRect {
        visible: root.selected;
        f: root.pill-frame;
        u0: -94.0 - growth;
        v0: -17.5 - growth + 2.5;
        w: 188.0 + 2.0 * growth;
        h: 35.0 + 2.0 * growth;
        r: 8.0 + growth;
        fill: #00000006;
    }

    if root.selected : TRect {
        f: root.pill-frame;
        u0: -94.0;
        v0: -17.5;
        w: 188.0;
        h: 35.0;
        r: 8.0;
        fill: #FFFFFD;
    }

    Text {
        x: root.text-x;
        y: root.text-y;
        width: 170px;
        text: root.item.title;
        font-family: "Shadows Into Light";
        font-size: 15.2px;
        font-weight: root.selected ? 700 : 400;
        color: #2B2F36;
        overflow: elide;
    }

    TouchArea {
        x: 30px;
        y: (root.row-cy - 17.5) * 1px;
        width: 188px;
        height: 35px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        scroll-event(e) => { return root.scrolled(e.delta-y); }
    }
}

export component AllNotesSidebar inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 603px;
    height: 625px;

    in property <int> selected-note-id: -1;
    in property <int> open-count: 0;
    in property <int> closed-count: 0;
    in property <[AllNoteItem]> open-notes: [];
    in property <[AllNoteItem]> closed-notes: [];
    in-out property <float> scroll-y: 0.0;

    callback select-note(int);
    callback new-note();

    property <float> closed-header-y: 225.0 + root.open-notes.length * 38.0;
    property <float> new-button-cy: root.closed-header-y + 46.0 + root.closed-notes.length * 38.0;
    property <float> max-scroll: max(0.0, (root.new-button-cy + 30.0) - (root.height / 1px));
    changed max-scroll => {
        if (root.scroll-y > root.max-scroll) {
            root.scroll-y = root.max-scroll;
        }
    }

    function scroll-by(delta-y: length) -> EventResult {
        if (root.max-scroll <= 0.0) { return reject; }
        root.scroll-y = clamp(root.scroll-y - (delta-y / 1px), 0.0, root.max-scroll);
        return accept;
    }

    property <Frame> new-button-frame: {
        w: 603.0,
        h: 625.0,
        cx: 84.0,
        cy: root.new-button-cy - root.scroll-y,
        cs: Math.cos(-1.0deg),
        sn: Math.sin(-1.0deg),
    };

    if root.max-scroll > 0.0 : TouchArea {
        x: 24px;
        y: 100px;
        width: 200px;
        height: root.height - 100px;
        scroll-event(e) => { return root.scroll-by(e.delta-y); }
    }

    Text {
        x: 33.8px;
        y: (112.0 - root.scroll-y) * 1px;
        text: "Notes";
        font-family: "Shadows Into Light";
        font-size: 30px;
        color: #2B2F36;
    }

    open-count-label := Text {
        x: 33.8px;
        y: (162.0 - root.scroll-y) * 1px;
        text: root.open-count + " open · ";
        font-family: "Shadows Into Light";
        font-size: 12.6px;
        color: #5B616B;
    }

    Text {
        x: root.open-count < 10 ? 79.5px : (open-count-label.x + open-count-label.width + 2px);
        y: (161.2 - root.scroll-y) * 1px;
        text: root.closed-count + " closed";
        font-family: "Shadows Into Light";
        font-size: 12.6px;
        color: #5B616B;
    }

    Text {
        x: 39.5px;
        y: (195.0 - root.scroll-y) * 1px;
        text: "OPEN";
        font-family: "Shadows Into Light";
        font-size: 12.6px;
        letter-spacing: 0.4px;
        color: #5B616B;
    }

    for item[i] in root.open-notes: SidebarRow {
        item: item;
        selected: item.id == root.selected-note-id;
        row-cy: 234.6 + i * 38.0 - root.scroll-y;
        text-x: (40.5 + i * 0.5) * 1px;
        text-y: (223.8 + i * 38.0 - root.scroll-y) * 1px;
        clicked => { root.select-note(item.id); }
        scrolled(dy) => { return root.scroll-by(dy); }
    }

    Text {
        x: 41.5px;
        y: (root.closed-header-y - 0.5 - root.scroll-y) * 1px;
        text: "CLOSED";
        font-family: "Shadows Into Light";
        font-size: 12.6px;
        letter-spacing: 0.3px;
        color: #5B616B;
    }

    for item[j] in root.closed-notes: SidebarRow {
        item: item;
        selected: item.id == root.selected-note-id;
        row-cy: root.closed-header-y + 39.5 + j * 38.0 - root.scroll-y;
        text-x: (42.5 + j * 0.66) * 1px;
        text-y: (root.closed-header-y + 28.0 + j * 38.0 - root.scroll-y) * 1px;
        clicked => { root.select-note(item.id); }
        scrolled(dy) => { return root.scroll-by(dy); }
    }

    // "+ New note" button
    TRect {
        f: root.new-button-frame;
        u0: -45.0;
        v0: -15.5;
        w: 90.0;
        h: 31.0;
        r: 7.5;
        fill: #2B2F36;
    }

    Text {
        x: (84.0 - 45.0) * 1px;
        y: (root.new-button-cy - 15.5 - root.scroll-y) * 1px;
        width: 90px;
        height: 31px;
        text: "+ New note";
        font-family: "Shadows Into Light";
        font-size: 15.0px;
        color: #FFFFFD;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        x: (84.0 - 45.0) * 1px;
        y: (root.new-button-cy - 15.5 - root.scroll-y) * 1px;
        width: 90px;
        height: 31px;
        mouse-cursor: pointer;
        clicked => { root.new-note(); }
        scroll-event(e) => { return root.scroll-by(e.delta-y); }
    }
}

export component AllNotesPaperOverlay inherits Rectangle {
    x: 0px;
    y: 0px;
    width: 603px;
    height: 625px;

    in property <int> selected-note-id: -1;
    in property <bool> selected-note-open: false;
    in-out property <bool> confirming-delete: false;
    in property <[PreviewRun]> status-runs: [];
    in property <[PreviewRun]> preview-runs: [];
    in property <bool> show-preview-runs: true;

    callback open-or-focus-note();
    callback close-note();
    callback export-note();
    callback request-delete();
    callback cancel-delete();
    callback confirm-delete();

    property <Frame> paper-frame: {
        w: 603.0,
        h: 625.0,
        cx: 412.1,
        cy: 311.6,
        cs: Math.cos(1.5deg),
        sn: Math.sin(1.5deg),
    };

    for r in root.status-runs: Text {
        x: (244.7 + r.u + r.dx) * 1px;
        y: (104.1 + r.v + r.dy) * 1px;
        text: r.text;
        wrap: no-wrap;
        font-family: "Shadows Into Light";
        font-size: r.size * 1px;
        font-weight: r.bold ? 700 : 400;
        font-italic: r.italic;
        color: r.color;
    }

    if root.show-preview-runs : Rectangle {
        x: 0px;
        y: 0px;
        width: 603px;
        height: 625px;

        for r in root.preview-runs: Text {
            x: (244.7 + r.u + r.dx) * 1px;
            y: (102.9 + r.v + r.dy) * 1px;
            text: r.text;
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: r.size * 1px;
            font-weight: r.bold ? 700 : 400;
            font-italic: r.italic;
            color: r.color;
        }
    }

    // --- Bottom Bar: Normal State (4 tilted icon buttons) ---
    if !root.confirming-delete && root.selected-note-id >= 0 : Rectangle {
        x: 0px;
        y: 0px;
        width: 603px;
        height: 625px;

        // 1. Open / Focus on desktop (du = -127.5, dv = 181.5)
        TRect {
            f: root.paper-frame;
            u0: -127.5 - 15.2;
            v0: 181.2 - 15.2;
            w: 30.4;
            h: 30.4;
            r: 7.5;
            fill: root.selected-note-open ? #F0F0EE : (open-hit.has-hover ? #F0F0EE : transparent);
        }

        Path {
            x: Tilt.x(root.paper-frame, -127.0, 181.8) * 1px - 8px;
            y: Tilt.y(root.paper-frame, -127.0, 181.8) * 1px - 8px;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M9 9h10v10H9zM5 15H4V4h11v1";
            fill: transparent;
            stroke: root.selected-note-open ? #2B2F36 : #5B616B;
            stroke-width: 1.3px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        open-hit := TouchArea {
            x: Tilt.x(root.paper-frame, -127.5, 181.5) * 1px - 15.5px;
            y: Tilt.y(root.paper-frame, -127.5, 181.5) * 1px - 15.5px;
            width: 31px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => { root.open-or-focus-note(); }
        }

        // 2. Close (×) (du = -91.0, dv = 181.8)
        TRect {
            f: root.paper-frame;
            u0: -91.0 - 15.5;
            v0: 181.5 - 15.5;
            w: 31.0;
            h: 31.0;
            r: 8.0;
            fill: close-hit.has-hover ? #F0F0EE : transparent;
        }

        Path {
            x: Tilt.x(root.paper-frame, -91.2, 181.9) * 1px - 7px;
            y: Tilt.y(root.paper-frame, -91.2, 181.9) * 1px - 7px;
            width: 14px;
            height: 14px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M6 6l12 12M18 6L6 18";
            fill: transparent;
            stroke: #5B616B;
            stroke-width: 1.35px;
            stroke-line-cap: round;
        }

        close-hit := TouchArea {
            x: Tilt.x(root.paper-frame, -91.0, 181.5) * 1px - 15.5px;
            y: Tilt.y(root.paper-frame, -91.0, 181.5) * 1px - 15.5px;
            width: 31px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => { root.close-note(); }
        }

        // 3. Export (↓) (du = -55.0, dv = 182.0)
        TRect {
            f: root.paper-frame;
            u0: -55.0 - 15.5;
            v0: 181.5 - 15.5;
            w: 31.0;
            h: 31.0;
            r: 8.0;
            fill: export-hit.has-hover ? #F0F0EE : transparent;
        }

        Path {
            x: 344px;
            y: 483.2px;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M12 4.5v10M8 10.5l4 4 4-4M5.5 19.5h13";
            fill: transparent;
            stroke: #5B616B;
            stroke-width: 1.35px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        export-hit := TouchArea {
            x: Tilt.x(root.paper-frame, -55.0, 181.5) * 1px - 15.5px;
            y: Tilt.y(root.paper-frame, -55.0, 181.5) * 1px - 15.5px;
            width: 31px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => { root.export-note(); }
        }

        // 4. Delete (🗑) (du = -18.5, dv = 182.0)
        TRect {
            f: root.paper-frame;
            u0: -18.5 - 15.5;
            v0: 181.5 - 15.5;
            w: 31.0;
            h: 31.0;
            r: 8.0;
            fill: del-hit.has-hover ? #F6E7E9 : transparent;
        }

        Path {
            x: Tilt.x(root.paper-frame, -18.3, 182.0) * 1px - 8px;
            y: Tilt.y(root.paper-frame, -18.3, 182.0) * 1px - 8px;
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13";
            fill: transparent;
            stroke: #8A1F2B;
            stroke-width: 1.3px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }

        del-hit := TouchArea {
            x: Tilt.x(root.paper-frame, -18.5, 181.5) * 1px - 15.5px;
            y: Tilt.y(root.paper-frame, -18.5, 181.5) * 1px - 15.5px;
            width: 31px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => {
                root.confirming-delete = true;
                root.request-delete();
            }
        }
    }

    // --- Bottom Bar: Delete Confirmation State ---
    if root.confirming-delete && root.selected-note-id >= 0 : Rectangle {
        x: 0px;
        y: 0px;
        width: 603px;
        height: 625px;

        // "Delete for good?" along the 1.5deg paper baseline
        Text {
            x: (Tilt.x(root.paper-frame, -124.7, 180.0) - 18.0) * 1px;
            y: (Tilt.y(root.paper-frame, -124.7, 180.0) - 10.7) * 1px;
            text: "Delete";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.4px;
            color: #2B2F36;
        }

        Text {
            x: (Tilt.x(root.paper-frame, -90.7, 180.0) - 8.5) * 1px;
            y: (Tilt.y(root.paper-frame, -90.7, 180.0) - 11.0) * 1px;
            text: "for";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.4px;
            color: #2B2F36;
        }

        Text {
            x: (Tilt.x(root.paper-frame, -61.2, 180.0) - 16.0) * 1px;
            y: (Tilt.y(root.paper-frame, -61.2, 180.0) - 10.7) * 1px;
            text: "good?";
            wrap: no-wrap;
            font-family: "Shadows Into Light";
            font-size: 15.4px;
            color: #2B2F36;
        }

        // "Keep" button
        TRect {
            f: root.paper-frame;
            u0: 23.3;
            v0: 166.5;
            w: 54.0;
            h: 30.5;
            r: 7.5;
            fill: keep-hit.pressed ? #E4E4E2 : (keep-hit.has-hover ? #EAEAE8 : #F0F0EE);
        }

        Text {
            x: Tilt.x(root.paper-frame, 50.8, 181.2) * 1px - 27.0px;
            y: Tilt.y(root.paper-frame, 50.8, 181.2) * 1px - 15.5px;
            width: 54px;
            height: 30px;
            text: "Keep";
            font-family: "Shadows Into Light";
            font-size: 14.2px;
            color: #2B2F36;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        keep-hit := TouchArea {
            x: Tilt.x(root.paper-frame, 50.3, 181.8) * 1px - 27.0px;
            y: Tilt.y(root.paper-frame, 50.3, 181.8) * 1px - 15.2px;
            width: 54px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => {
                root.confirming-delete = false;
                root.cancel-delete();
            }
        }

        // "Delete" button
        TRect {
            f: root.paper-frame;
            u0: 83.3;
            v0: 166.5;
            w: 59.5;
            h: 30.5;
            r: 7.5;
            fill: confirm-hit.pressed ? #721923 : (confirm-hit.has-hover ? #9B2331 : #8A1F2B);
        }

        Text {
            x: Tilt.x(root.paper-frame, 112.2, 180.5) * 1px - 29.5px;
            y: Tilt.y(root.paper-frame, 112.2, 180.5) * 1px - 15.5px;
            width: 59px;
            height: 30px;
            text: "Delete";
            font-family: "Shadows Into Light";
            font-size: 13.8px;
            color: #FFFFFD;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        confirm-hit := TouchArea {
            x: Tilt.x(root.paper-frame, 113.0, 181.8) * 1px - 29.5px;
            y: Tilt.y(root.paper-frame, 113.0, 181.8) * 1px - 15.2px;
            width: 59px;
            height: 31px;
            mouse-cursor: pointer;
            clicked => {
                root.confirm-delete();
            }
        }
    }

    Image {
        source: @image-url("assets/tape-pink.png");
        x: 236px;
        y: 71px;
        width: 79px;
        height: 63px;
    }

    Image {
        source: @image-url("assets/tape-blue.png");
        x: 508px;
        y: 487px;
        width: 80px;
        height: 64px;
    }
}
