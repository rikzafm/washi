// Settings > General: Start with Windows, Always on top (the default for new notes), where notes left
// in All Notes go, the folders,
// Resource use and the Uninstall row. Laid out like the mockup's CSS: blocks 18px apart, rows with a
// 2px dotted rule, every height measured from the rows themselves (`bottom` is the end of the last
// block, in paper coordinates).

import { PaperFrame, TapeShape, PText, PRect, PRule, PBox, SettingRow, Switch, PillButton, StatTile, SectionHeading } from "settings-widgets.slint";

export component GeneralTab inherits Rectangle {
    in property <PaperFrame> pf;
    in property <TapeShape> dots;
    /// The first block's top, from the Paper's top edge.
    in property <float> top;
    in property <bool> start-with-windows;
    in property <bool> new-notes-on-top;
    in property <bool> tilted-editing;
    callback toggle-tilted-editing();
    in property <bool> park-beside;
    callback set-park-beside(bool);
    in property <string> install-dir;
    in property <string> data-dir;
    in property <string> stat-memory;
    in property <string> stat-cpu;
    in property <string> stat-db;
    in property <string> stat-notes;
    callback toggle-startup();
    callback toggle-on-top();
    callback open-install-dir();
    callback open-data-dir();
    /// An uninstaller exists beside the exe; `uninstall-confirming` shows the inline confirm step.
    /// Rust owns both: it flips `confirming` on a click and back on Cancel, tab change and open.
    in property <bool> uninstall-available;
    in property <bool> uninstall-confirming;
    callback uninstall-clicked();
    callback uninstall-cancel();
    callback uninstall-confirm();

    property <float> storage-y: root.top + toggle-1.total + toggle-2.total + toggle-3.total + park-row.total + 18.0;
    property <float> resource-y: root.storage-y + 38.0 + folder-1.total + folder-2.total + 18.0;
    property <float> tiles-y: root.resource-y + 38.0 + 10.0;
    property <float> uninstall-y: root.tiles-y + 75.6 + 18.0;
    property <float> uninstall-h: root.uninstall-confirming ? confirm-row.total : uninstall-row.total;
    out property <float> bottom: root.uninstall-y + 2.0 + root.uninstall-h;
    x: 0px;
    y: 0px;
    width: root.pf.f.w * 1px;
    height: root.pf.f.h * 1px;

    toggle-1 := SettingRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.top;
        label: "Start with Windows";
        hint: "Open notes return after you sign in. Off by default";
        Switch {
            checked: root.start-with-windows;
            accessible-name: "Start with Windows";
            toggled => { root.toggle-startup(); }
        }
    }

    toggle-2 := SettingRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.top + toggle-1.total;
        label: "Always on top";
        hint: "Keeps notes above other windows. Off by default";
        Switch {
            checked: root.new-notes-on-top;
            accessible-name: "Always on top for new notes";
            toggled => { root.toggle-on-top(); }
        }
    }

    toggle-3 := SettingRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.top + toggle-1.total + toggle-2.total;
        label: "Keep text tilted while editing";
        hint: "Off: the text settles flat while you type. On by default";
        Switch {
            checked: root.tilted-editing;
            accessible-name: "Keep text tilted while editing";
            toggled => { root.toggle-tilted-editing(); }
        }
    }

    park-row := SettingRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.top + toggle-1.total + toggle-2.total + toggle-3.total;
        rule: false;
        label: "Notes left in All Notes";
        hint: "When you switch away from a note";
        PillButton {
            text: "To the Back";
            accessible-name: "Notes left in All Notes go to the back";
            chosen: !root.park-beside;
            clicked => { root.set-park-beside(false); }
        }
        PillButton {
            text: "To the Side";
            accessible-name: "Notes left in All Notes go to the side";
            chosen: root.park-beside;
            clicked => { root.set-park-beside(true); }
        }
    }

    SectionHeading {
        pf: root.pf;
        a: 36.0;
        b: root.storage-y;
        text: "Storage";
    }

    folder-1 := SettingRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.storage-y + 38.0;
        break-all: true;
        label: "Installed folder";
        hint: root.install-dir;
        PillButton {
            text: "Open";
            accessible-name: "Open installed folder";
            clicked => { root.open-install-dir(); }
        }
    }

    folder-2 := SettingRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.storage-y + 38.0 + folder-1.total;
        rule: false;
        break-all: true;
        label: "Database folder";
        hint: root.data-dir;
        PillButton {
            text: "Open";
            accessible-name: "Open database folder";
            clicked => { root.open-data-dir(); }
        }
    }

    SectionHeading {
        pf: root.pf;
        a: 36.0;
        b: root.resource-y;
        text: "Resource use";
    }

    // Four tiles in a row (a 4-column grid, 8px apart), each placed on the tilt by its top-left corner.
    for t[i] in [
        { value: root.stat-memory, caption: "Memory" },
        { value: root.stat-cpu, caption: "CPU" },
        { value: root.stat-db, caption: "Database" },
        { value: root.stat-notes, caption: "Open notes" },
    ] : PBox {
        pf: root.pf;
        a: 36.0 + i * 114.0;
        b: root.tiles-y;
        width: 106px;
        height: 75.6px;

        StatTile {
            value: t.value;
            caption: t.caption;
        }
    }

    // The Uninstall row: a dotted rule above it, 4px of padding, then the row.
    PRule {
        pf: root.pf;
        a: 36.0;
        b: root.uninstall-y;
        shape: root.dots;
    }

    uninstall-row := SettingRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.uninstall-y + 2.0;
        pad-top: 4.0;
        rule: false;
        visible: !root.uninstall-confirming;
        label: "Uninstall Washi Note";
        hint: root.uninstall-available ? "Removes the app from this computer" : "Available when installed with the installer";
        PillButton {
            text: "Uninstall…";
            outlined: true;
            enabled: root.uninstall-available;
            accessible-name: "Uninstall Washi Note";
            clicked => { root.uninstall-clicked(); }
        }
    }

    confirm-row := SettingRow {
        pf: root.pf;
        dots: root.dots;
        row-y: root.uninstall-y + 2.0;
        pad-top: 4.0;
        rule: false;
        visible: root.uninstall-confirming;
        label-size: 21;
        lh: 25.2;
        label: "Remove Washi Note from this computer?";
        PillButton {
            text: "Cancel";
            accessible-name: "Cancel uninstall";
            clicked => { root.uninstall-cancel(); }
        }
        PillButton {
            text: "Uninstall";
            filled: true;
            accessible-name: "Confirm uninstall";
            clicked => { root.uninstall-confirm(); }
        }
    }
}
