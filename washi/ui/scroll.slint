import { ToolbarMetrics } from "toolbar.slint";
import { PaperTheme } from "paper-theme.slint";
import { PaperGeometry } from "paper.slint";
import { Theme } from "theme.slint";

// Scrolling of a note's text. The wheel moves the text inside the text area; the bar only shows
// the position (thin, ink-muted), and only while the pointer is over the note and the text overflows.
export global ScrollMetrics {
    out property <length> bar-width: 4px;
    // From the paper's right edge to the bar's right side: inside the text's right inset.
    out property <length> bar-edge: 8px;
    // From the paper's top edge to where the bar's track begins.
    out property <length> bar-top: 28px;
    // Space kept between the thumb and the ends of the track.
    out property <length> bar-pad: 4px;
    out property <length> min-thumb: 24px;
    out property <duration> fade: 120ms;
}

/// The thin bar, drawn in the paper's own frame so it runs parallel to the paper's right edge from
/// its top to the toolbar band and can never leave the paper. It fills the window (like the
/// toolbar); `paper-w` and `paper-h` are the paper's size. `view` is the text area's height,
/// `content` the text's, `offset` how far it is scrolled.
export component ScrollBar inherits Rectangle {
    in property <length> paper-w;
    in property <length> paper-h;
    in property <length> view;
    in property <length> content;
    in property <length> offset;
    in property <bool> shown: false;

    property <bool> overflowing: root.content > root.view + 0.5px;
    property <length> cx: root.width / 2;
    property <length> cy: root.height / 2;
    property <length> r: ScrollMetrics.bar-width / 2;
    // Paper-frame coordinates (from the paper's center, along its own axes).
    property <length> lx: root.paper-w / 2 - ScrollMetrics.bar-edge - root.r;
    property <length> track-top: -root.paper-h / 2 + ScrollMetrics.bar-top + ScrollMetrics.bar-pad;
    property <length> track-bottom: root.paper-h / 2 - ToolbarMetrics.band-height - Theme.text-bottom-gap - ScrollMetrics.bar-pad;
    property <length> track: max(0px, root.track-bottom - root.track-top);
    property <length> thumb: root.content > 0px ? min(root.track, max(ScrollMetrics.min-thumb, root.track * root.view / root.content)) : 0px;
    property <length> travel: max(0px, root.track - root.thumb);
    property <length> range: max(0.001px, root.content - root.view);
    property <length> ly: root.track-top + root.thumb / 2 + root.travel * clamp(root.offset / root.range, 0, 1);
    // The rounded ends sit half a thumb up and down along the paper's tilted vertical.
    property <length> half: max(0px, root.thumb / 2 - root.r);

    out property <float> bar-opacity: (root.shown && root.overflowing) ? 1 : 0;
    opacity: root.bar-opacity;
    visible: root.bar-opacity > 0;
    animate opacity { duration: ScrollMetrics.fade; easing: ease-out; }

    // The straight part of the pill: a rectangle turned by the paper's tilt.
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: PaperGeometry.quad(
            PaperGeometry.x(root.cx, root.cy, root.lx, root.ly),
            PaperGeometry.y(root.cx, root.cy, root.lx, root.ly),
            root.r, root.half);
        fill: ToolbarMetrics.ink-muted;
    }
    // A round cap at each end.
    for sign in [-1, 1]: Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        property <length> ex: PaperGeometry.x(root.cx, root.cy, root.lx, root.ly + sign * root.half);
        property <length> ey: PaperGeometry.y(root.cx, root.cy, root.lx, root.ly + sign * root.half);
        commands: "M " + ((self.ex - root.r) / 1px) + " " + (self.ey / 1px)
            + " a " + (root.r / 1px) + " " + (root.r / 1px) + " 0 1 0 " + (2 * root.r / 1px) + " 0"
            + " a " + (root.r / 1px) + " " + (root.r / 1px) + " 0 1 0 " + (-2 * root.r / 1px) + " 0 Z";
        fill: ToolbarMetrics.ink-muted;
    }
}
