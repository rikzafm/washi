// Dropdown menu window for note Quick Jump and actions.
// Floats relative to the parent note's "..." trigger button.

import "../../fonts/Gelasio-Bold.ttf";
import "../../fonts/ShadowsIntoLight.ttf";

component HeaderIconButton inherits Rectangle {
    in property <length> icon-size: 26px;
    in property <color> hover-bg: #F0F0EE;
    in property <color> press-bg: #E0E0DE;
    callback clicked();

    width: root.icon-size;
    height: root.icon-size;
    border-radius: 6px;
    background: hit.pressed ? root.press-bg : (hit.has-hover ? root.hover-bg : transparent);

    hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BottomActionButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 30px;
    border-radius: 6px;
    background: hit.pressed ? #E4E4E2 : (hit.has-hover ? #F0F0EE : transparent);

    hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DropdownMenuWindow inherits Window {
    title: "Washi Menu";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    in property <length> card-width: 268px;
    in property <length> card-height: 320px;
    in property <length> shadow-margin: 16px;

    width: card-width + 2 * shadow-margin;
    height: card-height + 2 * shadow-margin;

    callback dismiss();
    callback toggle_pin();
    callback delete_note();
    callback new_note();
    in-out property <bool> pinned: false;

    // Detect clicks outside the card (in the shadow margin) to dismiss
    background-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.dismiss();
        }
    }

    // Dismiss on Escape key
    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    // The upright card
    card := Rectangle {
        x: root.shadow-margin;
        y: root.shadow-margin;
        width: root.card-width;
        height: root.card-height;
        background: #FFFFFF;
        border-radius: 14px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000028;
        drop-shadow-offset-y: 6px;
        clip: true;

        // Absorb clicks on the card itself so they don't fall through to background-touch
        card-touch := TouchArea {
            width: 100%;
            height: 100%;
        }

        // --- Header ---
        header := Rectangle {
            x: 16px;
            y: 12px;
            width: root.card-width - 32px;
            height: 28px;

            Text {
                x: 0;
                y: 0;
                height: 100%;
                text: "JUMP TO";
                font-family: "Gelasio";
                font-size: 11px;
                font-weight: 700;
                color: #8B919A;
                vertical-alignment: center;
            }

            // Right-aligned button group: Pin and Delete
            HorizontalLayout {
                x: parent.width - self.width;
                y: 0;
                height: 100%;
                spacing: 4px;

                // Pin Button
                pin-btn := HeaderIconButton {
                    clicked => {
                        root.toggle_pin();
                    }

                    property <color> pin-color: root.pinned ? #2B2F36 : (self.hover-state ? #2B2F36 : #8B919A);
                    property <bool> hover-state: self.background != transparent;

                    // Pin head bar
                    Rectangle {
                        x: 8px;
                        y: 6px;
                        width: 10px;
                        height: 2px;
                        border-radius: 1px;
                        background: pin-btn.pin-color;
                    }
                    // Pin body cone
                    Path {
                        width: 26px;
                        height: 26px;
                        viewbox-width: 26;
                        viewbox-height: 26;
                        fill: pin-btn.pin-color;
                        MoveTo { x: 10; y: 8; }
                        LineTo { x: 16; y: 8; }
                        LineTo { x: 15; y: 13; }
                        LineTo { x: 11; y: 13; }
                        Close { }
                    }
                    // Pin rim
                    Rectangle {
                        x: 7px;
                        y: 13px;
                        width: 12px;
                        height: 2px;
                        border-radius: 0.5px;
                        background: pin-btn.pin-color;
                    }
                    // Pin needle point
                    Path {
                        width: 26px;
                        height: 26px;
                        viewbox-width: 26;
                        viewbox-height: 26;
                        stroke: pin-btn.pin-color;
                        stroke-width: 1.5px;
                        stroke-line-cap: round;
                        MoveTo { x: 13; y: 15; }
                        LineTo { x: 13; y: 20; }
                    }
                }

                // Delete Button
                trash-btn := HeaderIconButton {
                    hover-bg: #FFEBEE;
                    press-bg: #FFCDD2;
                    clicked => {
                        root.delete_note();
                    }

                    property <color> trash-color: #D32F2F;

                    // Lid handle
                    Path {
                        width: 26px;
                        height: 26px;
                        viewbox-width: 26;
                        viewbox-height: 26;
                        stroke: trash-btn.trash-color;
                        stroke-width: 1.3px;
                        stroke-line-cap: round;
                        MoveTo { x: 11; y: 6.5; }
                        LineTo { x: 11; y: 5; }
                        LineTo { x: 15; y: 5; }
                        LineTo { x: 15; y: 6.5; }
                    }
                    // Lid horizontal line
                    Rectangle {
                        x: 6.5px;
                        y: 6.5px;
                        width: 13px;
                        height: 1.5px;
                        border-radius: 0.75px;
                        background: trash-btn.trash-color;
                    }
                    // Bin outline
                    Path {
                        width: 26px;
                        height: 26px;
                        viewbox-width: 26;
                        viewbox-height: 26;
                        stroke: trash-btn.trash-color;
                        stroke-width: 1.3px;
                        stroke-line-join: round;
                        stroke-line-cap: round;
                        MoveTo { x: 8; y: 8; }
                        LineTo { x: 8.5; y: 19; }
                        LineTo { x: 17.5; y: 19; }
                        LineTo { x: 18; y: 8; }
                    }
                    // Inner slats
                    Rectangle {
                        x: 11px;
                        y: 10px;
                        width: 1.2px;
                        height: 6.5px;
                        background: trash-btn.trash-color;
                    }
                    Rectangle {
                        x: 13.8px;
                        y: 10px;
                        width: 1.2px;
                        height: 6.5px;
                        background: trash-btn.trash-color;
                    }
                }
            }
        }

        // --- Note List Area (Placeholder for ticket 04) ---
        list-area := Rectangle {
            x: 0;
            y: 44px;
            width: root.card-width;
            height: root.card-height - 44px - 44px;
            clip: true;
        }

        // --- Dotted Divider Line ---
        divider := Rectangle {
            x: 16px;
            y: root.card-height - 44px;
            width: root.card-width - 32px;
            height: 2px;

            for i in 36: Rectangle {
                x: i * 6.5px;
                y: 0px;
                width: 2px;
                height: 2px;
                border-radius: 1px;
                background: #D8DADC;
            }
        }

        // --- Bottom Action Bar ---
        action-bar := HorizontalLayout {
            x: 10px;
            y: root.card-height - 38px;
            width: root.card-width - 20px;
            height: 30px;
            spacing: 2px;
            alignment: space-between;

            // + New
            btn-new := BottomActionButton {
                width: 66px;
                clicked => {
                    root.new_note();
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    // Plus icon
                    Rectangle {
                        width: 12px;
                        height: 100%;

                        Path {
                            width: 12px;
                            height: 30px;
                            viewbox-width: 12;
                            viewbox-height: 30;
                            stroke: #2B2F36;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                            MoveTo { x: 2; y: 15; }
                            LineTo { x: 10; y: 15; }
                            MoveTo { x: 6; y: 11; }
                            LineTo { x: 6; y: 19; }
                        }
                    }

                    Text {
                        text: "New";
                        font-size: 12px;
                        font-weight: 500;
                        color: #2B2F36;
                        vertical-alignment: center;
                    }
                }
            }

            // := All notes
            btn-all := BottomActionButton {
                width: 86px;

                HorizontalLayout {
                    alignment: center;
                    spacing: 5px;

                    // List icon
                    Rectangle {
                        width: 12px;
                        height: 100%;

                        Path {
                            width: 12px;
                            height: 30px;
                            viewbox-width: 12;
                            viewbox-height: 30;
                            stroke: #2B2F36;
                            stroke-width: 1.4px;
                            stroke-line-cap: round;
                            MoveTo { x: 5; y: 12; }
                            LineTo { x: 11; y: 12; }
                            MoveTo { x: 5; y: 17; }
                            LineTo { x: 11; y: 17; }
                        }
                        Rectangle {
                            x: 1px;
                            y: 11px;
                            width: 2px;
                            height: 2px;
                            border-radius: 1px;
                            background: #2B2F36;
                        }
                        Rectangle {
                            x: 1px;
                            y: 16px;
                            width: 2px;
                            height: 2px;
                            border-radius: 1px;
                            background: #2B2F36;
                        }
                    }

                    Text {
                        text: "All notes";
                        font-size: 12px;
                        font-weight: 500;
                        color: #2B2F36;
                        vertical-alignment: center;
                    }
                }
            }

            // Sliders Settings
            btn-settings := BottomActionButton {
                width: 84px;

                HorizontalLayout {
                    alignment: center;
                    spacing: 5px;

                    // Sliders icon
                    Rectangle {
                        width: 12px;
                        height: 100%;

                        Path {
                            width: 12px;
                            height: 30px;
                            viewbox-width: 12;
                            viewbox-height: 30;
                            stroke: #2B2F36;
                            stroke-width: 1.3px;
                            stroke-line-cap: round;
                            MoveTo { x: 1; y: 12.5; }
                            LineTo { x: 11; y: 12.5; }
                            MoveTo { x: 1; y: 17.5; }
                            LineTo { x: 11; y: 17.5; }
                        }
                        Rectangle {
                            x: 3px;
                            y: 10.5px;
                            width: 2px;
                            height: 4px;
                            border-radius: 0.8px;
                            background: #2B2F36;
                        }
                        Rectangle {
                            x: 7px;
                            y: 15.5px;
                            width: 2px;
                            height: 4px;
                            border-radius: 0.8px;
                            background: #2B2F36;
                        }
                    }

                    Text {
                        text: "Settings";
                        font-size: 12px;
                        font-weight: 500;
                        color: #2B2F36;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
