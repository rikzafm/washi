// Dropdown menu window for note Quick Jump and actions.
// Floats relative to the parent note's "..." trigger button.

import "../../fonts/ShadowsIntoLight.ttf";
import { ListView } from "std-widgets.slint";

component HeaderIconButton inherits Rectangle {
    in property <length> icon-size: 22px;
    in property <color> hover-bg: #F0F0EE;
    in property <color> press-bg: #E0E0DE;
    callback clicked();

    width: root.icon-size;
    height: root.icon-size;
    border-radius: 6px;
    background: hit.pressed ? root.press-bg : (hit.has-hover ? root.hover-bg : transparent);

    hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BottomActionButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 48px;
    border-radius: 8px;
    background: hit.pressed ? #E4E4E0 : (hit.has-hover ? #F4F4F0 : transparent);

    hit := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export struct DropdownNoteItem {
    id: int,
    title: string,
    preview: string,
    timestamp: string,
    has-tape: bool,
}

export component DropdownMenuWindow inherits Window {
    title: "Washi Menu";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    in property <length> card-width: 268px;
    in property <length> card-height: 320px;
    in property <length> shadow-margin: 16px;

    width: card-width + 2 * shadow-margin;
    height: card-height + 2 * shadow-margin;

    callback dismiss();
    callback toggle_pin();
    callback delete_note();
    callback new_note();
    callback select_note(int);
    in-out property <bool> pinned: false;
    in property <[DropdownNoteItem]> notes: [];

    // Detect clicks outside the card (in the shadow margin) to dismiss
    background-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.dismiss();
        }
    }

    // Dismiss on Escape key
    focus-scope := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    // The upright card matching mockup
    card := Rectangle {
        x: root.shadow-margin;
        y: root.shadow-margin;
        width: root.card-width;
        height: root.card-height;
        background: #FFFFFF;
        border-radius: 14px;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000022;
        drop-shadow-offset-y: 6px;
        clip: true;

        // Absorb clicks on the card itself so they don't fall through to background-touch
        card-touch := TouchArea {
            width: 100%;
            height: 100%;
        }

        // --- Header ---
        header := Rectangle {
            x: 18px;
            y: 14px;
            width: root.card-width - 36px;
            height: 24px;

            Text {
                x: 0;
                y: 0;
                width: 90px;
                height: 100%;
                text: "JUMP TO";
                font-family: "Shadows Into Light";
                font-size: 16px;
                font-weight: 400;
                color: #7E8691;
                vertical-alignment: center;
            }

            // Pin button
            pin-btn := HeaderIconButton {
                x: parent.width - 50px;
                y: 1px;
                icon-size: 22px;
                clicked => {
                    root.toggle_pin();
                }

                property <color> pin-color: root.pinned ? #2B2F36 : (self.hover-state ? #2B2F36 : #4E535A);
                property <bool> hover-state: self.background != transparent;

                // Pushpin line art matching mockup
                Rectangle {
                    x: 6px;
                    y: 3px;
                    width: 10px;
                    height: 1.5px;
                    border-radius: 0.5px;
                    background: pin-btn.pin-color;
                }
                Path {
                    width: 22px;
                    height: 22px;
                    viewbox-width: 22;
                    viewbox-height: 22;
                    fill: pin-btn.pin-color;
                    MoveTo { x: 8.5; y: 4.5; }
                    LineTo { x: 13.5; y: 4.5; }
                    LineTo { x: 12.5; y: 9.5; }
                    LineTo { x: 9.5; y: 9.5; }
                    Close { }
                }
                Rectangle {
                    x: 5px;
                    y: 9.5px;
                    width: 12px;
                    height: 1.5px;
                    border-radius: 0.5px;
                    background: pin-btn.pin-color;
                }
                Rectangle {
                    x: 10.25px;
                    y: 11px;
                    width: 1.5px;
                    height: 7px;
                    border-radius: 0.5px;
                    background: pin-btn.pin-color;
                }
            }

            // Trash button
            trash-btn := HeaderIconButton {
                x: parent.width - 24px;
                y: 1px;
                icon-size: 22px;
                hover-bg: #FFEBEE;
                press-bg: #FFCDD2;
                clicked => {
                    root.delete_note();
                }

                property <color> trash-color: #D35A5A;

                Path {
                    width: 22px;
                    height: 22px;
                    viewbox-width: 22;
                    viewbox-height: 22;
                    stroke: trash-btn.trash-color;
                    stroke-width: 1.2px;
                    stroke-line-cap: round;
                    MoveTo { x: 9.5; y: 4.8; }
                    LineTo { x: 9.5; y: 3.5; }
                    LineTo { x: 12.5; y: 3.5; }
                    LineTo { x: 12.5; y: 4.8; }
                }
                Rectangle {
                    x: 4.5px;
                    y: 5px;
                    width: 13px;
                    height: 1.4px;
                    border-radius: 0.5px;
                    background: trash-btn.trash-color;
                }
                Path {
                    width: 22px;
                    height: 22px;
                    viewbox-width: 22;
                    viewbox-height: 22;
                    stroke: trash-btn.trash-color;
                    stroke-width: 1.2px;
                    stroke-line-join: round;
                    stroke-line-cap: round;
                    MoveTo { x: 6; y: 6.5; }
                    LineTo { x: 6.5; y: 16.5; }
                    LineTo { x: 15.5; y: 16.5; }
                    LineTo { x: 16; y: 6.5; }
                }
                Rectangle {
                    x: 9px;
                    y: 8px;
                    width: 1.1px;
                    height: 6px;
                    background: trash-btn.trash-color;
                }
                Rectangle {
                    x: 11.9px;
                    y: 8px;
                    width: 1.1px;
                    height: 6px;
                    background: trash-btn.trash-color;
                }
            }
        }

        // --- Note List Area ---
        list-area := Rectangle {
            x: 0;
            y: 44px;
            width: root.card-width;
            height: 212px;
            clip: true;

            if root.notes.length == 0 : Rectangle {
                width: 100%;
                height: 100%;
                Text {
                    width: 100%;
                    height: 100%;
                    text: "No other notes yet";
                    font-family: "Shadows Into Light";
                    font-size: 15px;
                    color: #8B919A;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.notes.length > 0 : ListView {
                width: 100%;
                height: 100%;
                for item in root.notes : Rectangle {
                    height: 56px;

                    item-btn := Rectangle {
                        x: 10px;
                        y: 1px;
                        width: parent.width - 20px;
                        height: 54px;
                        border-radius: 8px;
                        background: item-touch.pressed ? #ECECE8 : (item-touch.has-hover ? #F6F6F4 : transparent);

                        item-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.select_note(item.id);
                            }
                        }

                        // Left gutter for tape swatch (aligned with header JUMP TO at x=8px relative to item-btn)
                        if item.has-tape : Rectangle {
                            x: 8px;
                            y: 8px;
                            width: 22px;
                            height: 14px;
                            Image {
                                source: @image-url("assets/tape-pink-flat.png");
                                width: 22px;
                                height: 7px;
                                y: (parent.height - self.height) / 2;
                                image-fit: contain;
                            }
                        }

                        // Text content: title on top line, preview snippet and timestamp below
                        VerticalLayout {
                            x: 34px;
                            y: 3px;
                            width: parent.width - 42px;
                            height: parent.height - 6px;
                            spacing: 1px;
                            alignment: center;

                            Text {
                                text: item.title;
                                font-family: "Shadows Into Light";
                                font-size: 18px;
                                font-weight: 400;
                                color: #2B2F36;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Text {
                                text: item.preview != "" ? (item.timestamp != "" ? (item.preview + " " + item.timestamp) : item.preview) : item.timestamp;
                                font-family: "Shadows Into Light";
                                font-size: 14px;
                                font-weight: 400;
                                color: #7E8691;
                                wrap: word-wrap;
                                vertical-alignment: top;
                            }
                        }
                    }
                }
            }
        }

        // --- Dotted Divider Line ---
        divider := Rectangle {
            x: 18px;
            y: root.card-height - 58px;
            width: root.card-width - 36px;
            height: 2px;

            for i in 36: Rectangle {
                x: i * 6.5px;
                y: 0px;
                width: 2px;
                height: 1.5px;
                border-radius: 0.75px;
                background: #D8DBE0;
            }
        }

        // --- Bottom Action Bar ---
        action-bar := HorizontalLayout {
            x: 14px;
            y: root.card-height - 52px;
            width: root.card-width - 28px;
            height: 46px;
            alignment: space-between;

            // + New
            btn-new := BottomActionButton {
                width: 70px;
                clicked => {
                    root.new_note();
                }

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 2px;

                    // Plus icon
                    Rectangle {
                        height: 14px;
                        Path {
                            x: (parent.width - 12px) / 2;
                            y: 1px;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            stroke: #2B2F36;
                            stroke-width: 1.4px;
                            stroke-line-cap: round;
                            MoveTo { x: 1; y: 6; }
                            LineTo { x: 11; y: 6; }
                            MoveTo { x: 6; y: 1; }
                            LineTo { x: 6; y: 11; }
                        }
                    }

                    Text {
                        text: "New";
                        font-family: "Shadows Into Light";
                        font-size: 15px;
                        color: #2B2F36;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // := All notes
            btn-all := BottomActionButton {
                width: 76px;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 2px;

                    // List icon
                    Rectangle {
                        height: 14px;
                        for row[idx] in [2.5, 6.5, 10.5]: Rectangle {
                            x: (parent.width - 14px) / 2;
                            y: row * 1px;
                            width: 2px;
                            height: 2px;
                            border-radius: 1px;
                            background: #2B2F36;
                        }
                        for row[idx] in [2.5, 6.5, 10.5]: Rectangle {
                            x: (parent.width - 14px) / 2 + 4px;
                            y: (row + 0.5) * 1px;
                            width: 9px;
                            height: 1.2px;
                            border-radius: 0.6px;
                            background: #2B2F36;
                        }
                    }

                    Text {
                        text: "All notes";
                        font-family: "Shadows Into Light";
                        font-size: 15px;
                        color: #2B2F36;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Sliders Settings
            btn-settings := BottomActionButton {
                width: 76px;

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    alignment: center;
                    spacing: 2px;

                    // Sliders icon
                    Rectangle {
                        height: 14px;
                        property <length> ox: (parent.width - 14px) / 2;
                        Rectangle { x: ox; y: 3px; width: 14px; height: 1.2px; border-radius: 0.6px; background: #2B2F36; }
                        Rectangle { x: ox; y: 7px; width: 14px; height: 1.2px; border-radius: 0.6px; background: #2B2F36; }
                        Rectangle { x: ox; y: 11px; width: 14px; height: 1.2px; border-radius: 0.6px; background: #2B2F36; }
                        Rectangle { x: ox + 9px; y: 1.5px; width: 2px; height: 4.2px; border-radius: 0.6px; background: #2B2F36; }
                        Rectangle { x: ox + 3px; y: 5.5px; width: 2px; height: 4.2px; border-radius: 0.6px; background: #2B2F36; }
                        Rectangle { x: ox + 8px; y: 9.5px; width: 2px; height: 4.2px; border-radius: 0.6px; background: #2B2F36; }
                    }

                    Text {
                        text: "Settings";
                        font-family: "Shadows Into Light";
                        font-size: 15px;
                        color: #2B2F36;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
