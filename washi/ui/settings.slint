// The Settings page: the Paper at its Settings size with the Sidebar in the strip left of it.
// Like All notes, the content is laid out in the Paper's tilted frame (`PaperFrame`) so glyphs stay
// upright on the tilted baseline. The numbers follow the mockup ("Setting Page" artboard) 1:1.

import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { PaperTheme } from "paper-theme.slint";
import { Paper } from "paper.slint";
import { SidebarPanel } from "sidebar-panel.slint";
import { ShortcutRow, ShortcutsPage, PrivacyPage } from "settings-pages.slint";
import { GeneralTab } from "settings-general.slint";
import { StyleTab } from "style-tab.slint";
import { AppearanceTab } from "appearance-tab.slint";
import { PX, PaperFrame, TapeShape, TapePalette, PText, PRect, PShadow, VTape } from "settings-widgets.slint";
export { TapeShape }

export global SettingsMetrics {
    /// The Tabs in Sidebar order (the index is the tab number everywhere).
    out property <[string]> tabs: ["General", "Appearance", "Font & Style", "Shortcuts", "Privacy"];
    /// The strip the Sidebar adds left of the Paper (the same as All notes).
    out property <length> strip: SidebarPanel.strip;
    out property <length> paper-w: 520px;
    out property <length> paper-min-h: 600px;
    /// The Paper's padding is 38 / 36 / 44 and the title is a 52.8px line; blocks start 18px under it.
    out property <length> pad-bottom: 44px;
    out property <float> content-top: 38.0 + 52.8 + 18.0;
}

/// One tab label in the Sidebar (the mockup's `.tab`: 48px tall, 24px text, 16px left padding),
/// drawn in the panel's tilted frame `pf`; `b` is its top in the panel.
component SidebarTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <PaperFrame> pf;
    in property <float> b;
    callback clicked();

    x: 0px;
    y: 0px;
    width: root.pf.f.w * 1px;
    height: root.pf.f.h * 1px;

    if root.selected : PShadow {
        pf: root.pf;
        a: 12.0;
        b: root.b;
        w: 246.0;
        h: 48.0;
        r: 10.8;
        dy: 6;
        spread: -6;
        blur: 12;
        alpha: 0.3;
    }

    if root.selected : PRect {
        pf: root.pf;
        a: 12.0;
        b: root.b;
        w: 246.0;
        h: 48.0;
        r: 10.8;
        fill: #FFFFFD;
    }

    if !root.selected && hit.has-hover : PRect {
        pf: root.pf;
        a: 12.0;
        b: root.b;
        w: 246.0;
        h: 48.0;
        r: 10.8;
        fill: rgba(255, 255, 253, 0.55);
    }

    PText {
        pf: root.pf;
        a: 29.0;
        b: root.b;
        nudge: -1.0;
        width: 214px;
        height: 48px;
        text: root.text;
        font-size: 24px;
        font-weight: root.selected ? 700 : 400;
        vertical-alignment: center;
    }

    hit := TouchArea {
        x: PX.x(root.pf, 12.0, root.b);
        y: PX.y(root.pf, 12.0, root.b);
        width: 246px;
        height: 48px;
        mouse-cursor: pointer;
        accessible-role: tab;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

component SettingsSidebar inherits Rectangle {
    in property <int> selected-tab: 0;
    callback tab-clicked(int);
    callback close-clicked();
    /// The user pressed the Sidebar itself: the platform drags the window.
    callback start-move();

    /// Settings › Appearance › Sidebar: 0 Match note, 1 Fit content; anchor 0 Top, 1 Middle, 2 Bottom.
    in property <int> height-mode: 0;
    in property <int> anchor: 1;

    property <[string]> labels: SettingsMetrics.tabs;
    // The panel (the mockup's `nav`): the All notes Sidebar's shape (`SidebarPanel`), placed beside
    // the Paper by the Sidebar layout rule. Its content is the header and the Tabs (the last Tab's
    // bottom) and the Paper's bottom padding. Coordinates in it are `a` from its left and `b` from
    // its top.
    property <float> paper-top: PaperTheme.margin / 1px;
    property <float> paper-h: root.height / 1px - 2.0 * root.paper-top;
    out property <float> content-h: 89.0 + (root.labels.length - 1) * 50.0 + 48.0 + SettingsMetrics.pad-bottom / 1px;
    property <float> ph: SidebarPanel.panel-h(root.paper-h, root.content-h, root.height-mode);
    property <float> top: SidebarPanel.panel-top(root.paper-top, root.paper-h, root.ph, root.anchor);
    property <PaperFrame> pf: {
        f: {
            w: SettingsMetrics.strip / 1px,
            h: root.height / 1px,
            cx: SidebarPanel.cx,
            cy: root.top + root.ph / 2.0,
            cs: Math.cos(SidebarPanel.tilt),
            sn: Math.sin(SidebarPanel.tilt),
        },
        pw: SidebarPanel.width,
        ph: root.ph,
    };

    // Dragging the Sidebar's empty parts moves the whole window.
    TouchArea {
        x: 0px;
        y: 0px;
        width: SettingsMetrics.strip;
        height: root.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.start-move();
            }
        }
    }

    PRect {
        pf: root.pf;
        a: 0.0;
        b: 0.0;
        w: SidebarPanel.width;
        h: root.ph;
        r: SidebarPanel.radius;
        fill: SidebarPanel.fill;
    }

    // "Settings": 44px on its natural line, 6px in from the 12px padding, 14px down.
    PText {
        pf: root.pf;
        a: 19.0;
        b: 14.0;
        nudge: -1.0;
        width: 240px;
        height: 71px;
        text: "Settings";
        font-size: 44px;
        vertical-alignment: center;
    }

    // Close (x): a 44px button 10px in from the panel's top right corner, with a 20px icon.
    if close-hit.has-hover : PRect {
        pf: root.pf;
        a: 216.0;
        b: 10.0;
        w: 44.0;
        h: 44.0;
        r: 10.8;
        fill: rgba(255, 255, 253, 0.55);
    }

    Rectangle {
        x: PX.x(root.pf, 238.0, 32.0) - 22px;
        y: PX.y(root.pf, 238.0, 32.0) - 22px;
        width: 44px;
        height: 44px;
        accessible-role: button;
        accessible-label: "Close settings";

        Path {
            x: 17px;
            y: 17px;
            width: 10px;
            height: 10px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 0 0 L 10 10 M 10 0 L 0 10";
            stroke: #5B616B;
            stroke-width: 1.5px;
            stroke-line-cap: round;
        }

        close-hit := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close-clicked(); }
        }
    }

    // The tabs: 14 + 71 + 2 + 2 = 89px down, 50px apart.
    for label[i] in root.labels : SidebarTab {
        pf: root.pf;
        b: 89.0 + i * 50.0;
        text: label;
        selected: i == root.selected-tab;
        clicked => { root.tab-clicked(i); }
    }
}

export component SettingsWindow inherits Window {
    title: "Washi Settings";
    no-frame: true;
    background: transparent;
    in property <image> app-icon;
    icon: app-icon;
    /// Follows the host note's pin, so Settings stays where the note was in the z-order.
    in property <bool> pinned: false;
    always-on-top: root.pinned;

    /// The tab lit in the Sidebar and the one drawn on the Paper (both change on click; the new
    /// content then settles in, see `content-dy`).
    in property <int> selected-tab: 0;
    in property <int> shown-tab: 0;
    /// The Tab labels, in Sidebar order.
    out property <[string]> tab-names: SettingsMetrics.tabs;
    /// How much of the Sidebar's strip is out (0 to `SettingsMetrics.strip`): the window grows left
    /// by this much and the Sidebar slides out from behind the Paper's left edge.
    in property <length> strip: SettingsMetrics.strip;
    /// The Settings content (not the Paper or Sidebar): faded in while the note turns into the page.
    in property <float> content-opacity: 1;
    /// How far below its place the content is drawn (it settles up into place after a tab switch).
    in property <float> content-dy: 0;
    /// The page (Sidebar strip, margin and Paper) inside the window, window px. The window is a fixed
    /// canvas for the length of a transition (resizing a native window every frame is choppy), and the
    /// page moves and grows inside it. Negative sizes: the whole window.
    in property <length> page-x: 0px;
    in property <length> page-y: 0px;
    in property <length> page-w: -1px;
    in property <length> page-h: -1px;
    property <length> body-w: root.page-w >= 0px ? root.page-w : root.width;
    property <length> body-h: root.page-h >= 0px ? root.page-h : root.height;

    /// The Shortcuts tab's rows.
    in property <[ShortcutRow]> shortcuts;

    callback tab-clicked(int);
    callback close-clicked();
    callback start-move();
    /// The height the shown tab needs changed while the page was at rest (the preview note grew or
    /// shrank): Rust resizes the Paper to `paper-height-for(selected-tab)`.
    callback paper-height-changed();

    // General tab (see settings-general.slint)
    in property <bool> start-with-windows;
    in property <bool> new-notes-on-top;
    /// Notes left in All Notes go beside it (true) or behind it (false).
    in property <bool> park-beside: true;
    callback set-park-beside(bool);
    in property <string> install-dir;
    in property <string> data-dir;
    in property <string> stat-memory;
    in property <string> stat-cpu;
    in property <string> stat-db;
    in property <string> stat-notes;
    callback toggle-startup();
    callback toggle-on-top();
    callback open-install-dir();
    callback open-data-dir();
    in property <bool> uninstall-available;
    in property <bool> uninstall-confirming;
    callback uninstall-clicked();
    callback uninstall-cancel();
    callback uninstall-confirm();
    // Appearance (see appearance-tab.slint): Rust owns the values (app-wide preferences).
    /// 0 Small, 1 Medium, 2 Large.
    in property <int> ui-size: 2;
    callback set-ui-size(int);
    out property <string> ui-size-label: appearance.ui-size-label;
    /// The Sidebar group: see appearance-tab.slint. Sidebar 0 is the Settings sidebar, 1 Notes.
    in property <bool> sidebar-layout-shared: true;
    in property <int> settings-sidebar-height: 0;
    in property <int> settings-sidebar-anchor: 1;
    in property <int> notes-sidebar-height: 0;
    in property <int> notes-sidebar-anchor: 1;
    callback toggle-sidebar-layout-shared();
    callback set-sidebar-height(int, int);
    callback set-sidebar-anchor(int, int);
    in-out property <int> appearance-open-list <=> appearance.open-list;
    out property <length> appearance-lists-bottom: appearance.lists-bottom * 1px;
    public pure function appearance-hit-x(id: int) -> length {
        return root.page-x + root.strip + appearance.hit-x(id);
    }
    public pure function appearance-hit-y(id: int) -> length {
        return root.page-y + appearance.hit-y(id);
    }
    // Font & Style choices: UI only. They live here, so they reset whenever Settings opens, and
    // nothing reads them (see style-tab.slint).
    in-out property <int> style-font <=> style.font;
    in-out property <int> style-size <=> style.size;
    in-out property <int> style-tape <=> style.tape;
    in-out property <int> style-open-list <=> style.open-list;
    out property <length> style-preview-font-size: style.preview-font-size;
    /// The lowest point the open Font or Tape color list can reach, from the Paper's top edge.
    out property <length> style-lists-bottom: style.lists-bottom * 1px;
    /// The shapes of the tapes, chips and dotted rules (see `settings/tape.rs`): 0 the Paper's tape,
    /// 1 the preview's, 2 a chip, 3 the dotted rule.
    in property <[TapeShape]> preview-tapes;
    public pure function style-hit-x(id: int) -> length {
        return root.page-x + root.strip + style.hit-x(id);
    }
    public pure function style-hit-y(id: int) -> length {
        return root.page-y + style.hit-y(id);
    }

    /// Where each tab's content ends, measured from the laid-out rows (paper coordinates), and the
    /// Paper height that gives (the mockup's `min-height: 600` and 44px bottom padding). Every tab is
    /// laid out all the time (only the shown one is drawn), so a tab's height is known before it shows.
    out property <[float]> content-bottoms: [general.bottom, appearance.bottom, style.bottom, shortcuts.bottom, privacy.bottom];
    /// The lowest point each tab's dropdown lists can reach (paper coordinates; 0 for a tab without
    /// one). An open list may hang into the Paper's bottom padding and margin, but must end at least
    /// 14px inside the window (16 here, a pixel of slack each way for rounding).
    out property <[float]> list-bottoms: [0, appearance.lists-bottom, style.lists-bottom, 0, 0];
    public pure function paper-height-for(tab: int) -> length {
        return max(
            SettingsMetrics.paper-min-h,
            root.content-bottoms[tab] * 1px + SettingsMetrics.pad-bottom,
            root.list-bottoms[tab] * 1px + 16px - PaperTheme.margin);
    }
    /// The Paper height the Sidebar's lit tab needs.
    out property <length> wanted-height: root.paper-height-for(root.selected-tab);
    changed wanted-height => { root.paper-height-changed(); }

    property <length> margin: PaperTheme.margin;
    property <length> note-w: root.body-w - root.strip;
    property <length> paper-w: root.note-w - 2 * root.margin;
    property <length> paper-h: root.body-h - 2 * root.margin;
    // The Paper's tilted frame in the note area's coordinates.
    property <PaperFrame> pf: {
        f: {
            w: root.note-w / 1px,
            h: root.body-h / 1px,
            cx: (root.margin + root.paper-w / 2) / 1px,
            cy: (root.margin + root.paper-h / 2) / 1px,
            cs: Math.cos(PaperTheme.paper-tilt),
            sn: Math.sin(PaperTheme.paper-tilt),
        },
        pw: root.paper-w / 1px,
        ph: root.paper-h / 1px,
    };

    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                // An open dropdown closes first.
                if (style.open-list >= 0 || appearance.open-list >= 0) {
                    style.open-list = -1;
                    appearance.open-list = -1;
                    return accept;
                }
                root.close-clicked();
                return accept;
            }
            reject
        }
    }

    SettingsSidebar {
        x: root.page-x + root.strip - SettingsMetrics.strip;
        y: root.page-y;
        width: SettingsMetrics.strip;
        height: root.body-h;
        selected-tab: root.selected-tab;
        height-mode: root.settings-sidebar-height;
        anchor: root.settings-sidebar-anchor;
        tab-clicked(i) => { root.tab-clicked(i); }
        close-clicked => { root.close-clicked(); }
        start-move => { root.start-move(); }
    }

    // The note area: shadow, Paper and tapes, right of the strip.
    Rectangle {
        x: root.page-x + root.strip;
        y: root.page-y;
        width: root.note-w;
        height: root.body-h;

        // The mockup's `0 18px 26px -10px` and `0 2px 5px` shadows.
        PShadow {
            pf: root.pf;
            a: 0.0;
            b: 0.0;
            w: root.pf.pw;
            h: root.pf.ph;
            dy: 18;
            spread: -10;
            blur: 26;
            alpha: 0.32;
        }

        PShadow {
            pf: root.pf;
            a: 0.0;
            b: 0.0;
            w: root.pf.pw;
            h: root.pf.ph;
            dy: 2;
            blur: 5;
            alpha: 0.12;
        }

        Paper {
            width: root.note-w;
            height: root.body-h;
            cx: root.note-w / 2;
            cy: root.body-h / 2;
            paper-w: root.paper-w;
            paper-h: root.paper-h;
            shadow: false;
        }

        // The title: 48px on a 52.8px line at the padding's corner.
        PText {
            pf: root.pf;
            a: 36.0;
            b: 38.0 + root.content-dy;
            width: 448px;
            height: 52.8px;
            text: SettingsMetrics.tabs[root.shown-tab];
            opacity: root.content-opacity;
            font-size: 48px;
            vertical-alignment: center;
            line-height-factor: 1.1 / 1.6064;
        }

        general := GeneralTab {
            visible: root.shown-tab == 0;
            opacity: root.content-opacity;
            pf: root.pf;
            dots: root.preview-tapes[3];
            top: SettingsMetrics.content-top + root.content-dy;
            start-with-windows: root.start-with-windows;
            new-notes-on-top: root.new-notes-on-top;
            park-beside: root.park-beside;
            set-park-beside(b) => { root.set-park-beside(b); }
            install-dir: root.install-dir;
            data-dir: root.data-dir;
            stat-memory: root.stat-memory;
            stat-cpu: root.stat-cpu;
            stat-db: root.stat-db;
            stat-notes: root.stat-notes;
            toggle-startup => { root.toggle-startup(); }
            toggle-on-top => { root.toggle-on-top(); }
            open-install-dir => { root.open-install-dir(); }
            open-data-dir => { root.open-data-dir(); }
            uninstall-available: root.uninstall-available;
            uninstall-confirming: root.uninstall-confirming;
            uninstall-clicked => { root.uninstall-clicked(); }
            uninstall-cancel => { root.uninstall-cancel(); }
            uninstall-confirm => { root.uninstall-confirm(); }
        }

        appearance := AppearanceTab {
            visible: root.shown-tab == 1;
            opacity: root.content-opacity;
            pf: root.pf;
            dots: root.preview-tapes[3];
            top: SettingsMetrics.content-top + root.content-dy;
            ui-size: root.ui-size;
            set-ui-size(i) => { root.set-ui-size(i); }
            layout-shared: root.sidebar-layout-shared;
            settings-height: root.settings-sidebar-height;
            settings-anchor: root.settings-sidebar-anchor;
            notes-height: root.notes-sidebar-height;
            notes-anchor: root.notes-sidebar-anchor;
            toggle-layout-shared => { root.toggle-sidebar-layout-shared(); }
            set-height(s, v) => { root.set-sidebar-height(s, v); }
            set-anchor(s, v) => { root.set-sidebar-anchor(s, v); }
        }

        // Font & Style (UI only). Kept alive on every tab so the choices last until Settings closes;
        // it only draws on its own tab.
        style := StyleTab {
            visible: root.shown-tab == 2;
            opacity: root.content-opacity;
            pf: root.pf;
            top: SettingsMetrics.content-top + root.content-dy;
            tapes: root.preview-tapes;
        }

        shortcuts := ShortcutsPage {
            visible: root.shown-tab == 3;
            opacity: root.content-opacity;
            pf: root.pf;
            dots: root.preview-tapes[3];
            top: SettingsMetrics.content-top + root.content-dy;
            rows: root.shortcuts;
        }

        privacy := PrivacyPage {
            visible: root.shown-tab == 4;
            opacity: root.content-opacity;
            pf: root.pf;
            dots: root.preview-tapes[3];
            top: SettingsMetrics.content-top + root.content-dy;
        }

        // The Paper's two tapes follow the chosen Tape color (the mockup's 113 by 33 strips, pinned
        // 20px / 11px off the top left corner and 20px / 8px off the bottom right one).
        VTape {
            pf: root.pf;
            a: 36.5;
            b: 5.5;
            shape: root.preview-tapes[0];
            base: TapePalette.a-light[style.tape];
            stripe: TapePalette.a-deep[style.tape];
            // Pressing the tape drags the window, as a note's tapes do.
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.start-move();
                    }
                }
            }
        }

        VTape {
            pf: root.pf;
            a: root.pf.pw - 36.5;
            b: root.pf.ph - 8.5;
            shape: root.preview-tapes[0];
            base: TapePalette.b-light[style.tape];
            stripe: TapePalette.b-deep[style.tape];
            // Pressing the tape drags the window, as a note's tapes do.
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.start-move();
                    }
                }
            }
        }
    }
}
