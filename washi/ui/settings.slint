// The Settings page: the Paper at its Settings size with the Sidebar in the strip left of it.
// Like All notes, the content is laid out in the Paper's tilted frame (`Frame` / `Tilt` / `TRect`)
// so glyphs stay upright on the tilted baseline.

import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { PaperTheme } from "paper-theme.slint";
import { Paper, Tapes } from "paper.slint";
import { Frame, Tilt, TRect } from "toolbar.slint";
import { AllNotesMetrics } from "all-notes.slint";
import { GeneralTab } from "settings-general.slint";

export global SettingsMetrics {
    /// The strip the Sidebar adds left of the Paper (the same as All notes).
    out property <length> strip: AllNotesMetrics.sidebar-w;
    out property <length> paper-w: 520px;
    out property <length> paper-min-h: 600px;
    out property <length> pad-top: 38px;
    out property <length> pad-x: 36px;
    out property <length> pad-bottom: 44px;
    /// The title's row: a 48px title and the gap under it.
    out property <length> title-h: 58px;
    out property <length> gap: 18px;
    out property <length> row2-h: 64px;
    out property <length> heading-h: 36px;
    out property <length> tile-h: 74px;
    out property <length> note-h: 54px;
}

// Each tab's content height is a pure sum of the row metrics, so the tween target is known before the
// tab is shown. Tabs without content yet show their layout shell (nothing to add up).
export global GeneralTabMetrics {
    // 2 toggles with hints, "Storage" + 2 folder rows, "Resource use" + tiles, uninstall row.
    out property <length> content-h:
        2 * SettingsMetrics.row2-h
        + SettingsMetrics.gap + SettingsMetrics.heading-h + 2 * SettingsMetrics.row2-h
        + SettingsMetrics.gap + SettingsMetrics.heading-h + SettingsMetrics.tile-h
        + SettingsMetrics.gap + SettingsMetrics.row2-h;
}

export global StyleTabMetrics {
    out property <length> content-h: 0px;
}

export global ShortcutsTabMetrics {
    // 11 shortcut rows of 44px, a note box and the gap above it.
    out property <length> content-h: 11 * 44px + SettingsMetrics.note-h + SettingsMetrics.gap;
}

export global PrivacyTabMetrics {
    out property <length> content-h: 0px;
}

/// One tab label in the Sidebar, drawn in the panel's tilted frame `f`; `v0` is its top.
component SidebarTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <Frame> f;
    in property <float> v0;
    callback clicked();

    x: 0px;
    y: 0px;
    width: root.f.w * 1px;
    height: root.f.h * 1px;

    if root.selected : TRect {
        f: root.f;
        u0: -123.0;
        v0: root.v0;
        w: 246.0;
        h: 48.0;
        r: 10.8;
        fill: #FFFFFD;
    }

    Text {
        x: Tilt.x(root.f, -107.0, root.v0) * 1px;
        y: Tilt.y(root.f, -107.0, root.v0) * 1px;
        width: 214px;
        height: 48px;
        text: root.text;
        font-family: "Shadows Into Light";
        font-size: 24px;
        font-weight: root.selected ? 700 : 400;
        color: #2B2F36;
        vertical-alignment: center;
    }

    TouchArea {
        x: Tilt.x(root.f, 0.0, root.v0 + 24.0) * 1px - 123px;
        y: Tilt.y(root.f, 0.0, root.v0 + 24.0) * 1px - 24px;
        width: 246px;
        height: 48px;
        mouse-cursor: pointer;
        accessible-role: tab;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

component SettingsSidebar inherits Rectangle {
    in property <int> selected-tab: 0;
    callback tab-clicked(int);
    callback close-clicked();
    /// The user pressed the Sidebar itself: the platform drags the window.
    callback start-move();

    property <[string]> labels: ["General", "Font & Style", "Shortcuts", "Privacy"];
    // The panel, in window px: as All notes' (270 wide at x = 8, as tall as the Paper).
    property <float> pw: 270.0;
    property <float> ph: max(240.0, root.height / 1px - 84.0);
    property <float> top-v: -root.ph / 2.0;
    property <Frame> pf: {
        w: AllNotesMetrics.sidebar-w / 1px,
        h: root.height / 1px,
        cx: 143.0,
        cy: root.height / 1px / 2.0,
        cs: Math.cos(-1.0deg),
        sn: Math.sin(-1.0deg),
    };

    // Dragging the Sidebar's empty parts moves the whole window.
    TouchArea {
        x: 0px;
        y: 0px;
        width: AllNotesMetrics.sidebar-w;
        height: root.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.start-move();
            }
        }
    }

    TRect {
        f: root.pf;
        u0: -root.pw / 2.0;
        v0: root.top-v;
        w: root.pw;
        h: root.ph;
        r: 22.0;
        fill: #D6DBE2;
    }

    Text {
        x: Tilt.x(root.pf, -113.0, root.top-v + 8.0) * 1px;
        y: Tilt.y(root.pf, -113.0, root.top-v + 8.0) * 1px;
        text: "Settings";
        font-family: "Shadows Into Light";
        font-size: 44px;
        color: #2B2F36;
    }

    // Close (x) at the panel's top right.
    Rectangle {
        x: Tilt.x(root.pf, 91.0, root.top-v + 10.0) * 1px;
        y: Tilt.y(root.pf, 91.0, root.top-v + 10.0) * 1px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: close-hit.has-hover ? #00000012 : transparent;
        accessible-role: button;
        accessible-label: "Close settings";

        Path {
            x: 10px;
            y: 10px;
            width: 16px;
            height: 16px;
            viewbox-width: 16;
            viewbox-height: 16;
            commands: "M 2 2 L 14 14 M 14 2 L 2 14";
            stroke: #5B616B;
            stroke-width: 1.8px;
            stroke-line-cap: round;
        }

        close-hit := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close-clicked(); }
        }
    }

    for label[i] in root.labels : SidebarTab {
        f: root.pf;
        v0: root.top-v + 72.0 + i * 52.0;
        text: label;
        selected: i == root.selected-tab;
        clicked => { root.tab-clicked(i); }
    }
}

export component SettingsWindow inherits Window {
    title: "Washi Settings";
    no-frame: true;
    background: transparent;
    in property <image> app-icon;
    icon: app-icon;
    /// Follows the host note's pin, so Settings stays where the note was in the z-order.
    in property <bool> pinned: false;
    always-on-top: root.pinned;

    /// The tab lit in the Sidebar (changes on click) and the one drawn on the Paper (changes at the
    /// midpoint of the cross-fade, when the content is invisible).
    in property <int> selected-tab: 0;
    in property <int> shown-tab: 0;
    /// How much of the Sidebar's strip is out (0 to `SettingsMetrics.strip`): the window grows left
    /// by this much and the Sidebar slides out from behind the Paper's left edge.
    in property <length> strip: SettingsMetrics.strip;
    /// The Settings content (not the Paper or Sidebar): faded in while the note turns into the page.
    in property <float> content-opacity: 1;

    callback tab-clicked(int);
    callback close-clicked();
    callback start-move();

    // General tab (see settings-general.slint)
    in property <bool> start-with-windows;
    in property <bool> new-notes-on-top;
    in property <string> install-dir;
    in property <string> data-dir;
    in property <string> stat-memory;
    in property <string> stat-cpu;
    in property <string> stat-db;
    in property <string> stat-notes;
    callback toggle-startup();
    callback toggle-on-top();
    callback open-install-dir();
    callback open-data-dir();

    /// The Paper height a tab needs (Rust reads it for the tween target).
    public pure function paper-height-for(tab: int) -> length {
        return max(SettingsMetrics.paper-min-h, SettingsMetrics.pad-top + SettingsMetrics.title-h
            + (tab == 0 ? GeneralTabMetrics.content-h : tab == 1 ? StyleTabMetrics.content-h
                : tab == 2 ? ShortcutsTabMetrics.content-h : PrivacyTabMetrics.content-h)
            + SettingsMetrics.pad-bottom);
    }

    property <length> margin: PaperTheme.margin;
    property <length> note-w: root.width - root.strip;
    property <length> paper-w: root.note-w - 2 * root.margin;
    property <length> paper-h: root.height - 2 * root.margin;
    // The Paper's tilted frame in the note area's coordinates.
    property <Frame> paper-frame: {
        w: root.note-w / 1px,
        h: root.height / 1px,
        cx: (root.margin + root.paper-w / 2) / 1px,
        cy: (root.margin + root.paper-h / 2) / 1px,
        cs: Math.cos(PaperTheme.paper-tilt),
        sn: Math.sin(PaperTheme.paper-tilt),
    };

    forward-focus: fs;
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close-clicked();
                return accept;
            }
            reject
        }
    }

    SettingsSidebar {
        x: root.strip - SettingsMetrics.strip;
        y: 0px;
        width: SettingsMetrics.strip;
        height: root.height;
        selected-tab: root.selected-tab;
        tab-clicked(i) => { root.tab-clicked(i); }
        close-clicked => { root.close-clicked(); }
        start-move => { root.start-move(); }
    }

    // The note area: shadow, Paper and tapes, right of the strip.
    Rectangle {
        x: root.strip;
        y: 0px;
        width: root.note-w;
        height: root.height;

        Paper {
            width: root.note-w;
            height: root.height;
            cx: root.note-w / 2;
            cy: root.height / 2;
            paper-w: root.paper-w;
            paper-h: root.paper-h;
        }

        // General (static for now): the title and the row labels, on the tilted baseline.
        Text {
            x: Tilt.x(root.paper-frame, -root.paper-w / 2px + SettingsMetrics.pad-x / 1px, -root.paper-h / 2px + SettingsMetrics.pad-top / 1px) * 1px;
            y: Tilt.y(root.paper-frame, -root.paper-w / 2px + SettingsMetrics.pad-x / 1px, -root.paper-h / 2px + SettingsMetrics.pad-top / 1px) * 1px;
            text: ["General", "Font & Style", "Shortcuts", "Privacy"][root.shown-tab];
            opacity: root.content-opacity;
            font-family: "Shadows Into Light";
            font-size: 48px;
            color: #2B2F36;
        }

        if root.shown-tab == 0 : GeneralTab {
            f: root.paper-frame;
            pw: root.paper-w / 1px;
            ph: root.paper-h / 1px;
            top: (SettingsMetrics.pad-top + SettingsMetrics.title-h) / 1px;
            row-h: SettingsMetrics.row2-h / 1px;
            gap: SettingsMetrics.gap / 1px;
            heading-h: SettingsMetrics.heading-h / 1px;
            tile-h: SettingsMetrics.tile-h / 1px;
            opacity: root.content-opacity;
            start-with-windows: root.start-with-windows;
            new-notes-on-top: root.new-notes-on-top;
            install-dir: root.install-dir;
            data-dir: root.data-dir;
            stat-memory: root.stat-memory;
            stat-cpu: root.stat-cpu;
            stat-db: root.stat-db;
            stat-notes: root.stat-notes;
            toggle-startup => { root.toggle-startup(); }
            toggle-on-top => { root.toggle-on-top(); }
            open-install-dir => { root.open-install-dir(); }
            open-data-dir => { root.open-data-dir(); }
        }

        Tapes {
            width: root.note-w;
            height: root.height;
        }
    }
}
