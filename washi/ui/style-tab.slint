// The Font & Style tab of the Settings page (UI only).
//
// Font and Tape color update the preview note and nothing else: their state lives in properties of
// this component (bound to the Settings window, which is created fresh each time Settings opens, so
// the defaults come back). Rust never reads these properties except in tests. Letter spacing and Font
// size are the exceptions: Rust sets `spacing` and `size` from the saved choices and saves a new one
// (`set-spacing`, `set-size`), and every note follows. Dragging the size slider only moves the
// preview (`size`); the size is saved when the slider is released or the number box commits.
// Laid out like the mockup's CSS in the Paper's tilted frame `pf`: the preview card, then four rows;
// `bottom` (paper coordinates) is where the last row ends.
//
// Only Shadows Into Light is bundled, so the other fonts in the list are labels: the preview and
// every list entry are drawn in Shadows Into Light whichever one is chosen.

import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { PX, PaperFrame, TapeShape, TapePalette, TextMetrics, PText, PBox, PRect, PShadow, VTape, SettingRow, PillButton, PickerButton, ListItem, ListPanel } from "settings-widgets.slint";
import { PSlider, NumberBox } from "controls.slint";
import { Theme } from "theme.slint";

export component StyleTab inherits Rectangle {
    in property <PaperFrame> pf;
    in property <float> top;
    /// The tapes' shapes: 0 the big Paper tape, 1 the preview's mini tape, 2 a chip, 3 the dots.
    in property <[TapeShape]> tapes;

    in-out property <int> font: 0;
    /// The Font size, 12 to 40 (22 is today's look); while the slider is dragged, the one shown.
    in-out property <int> size: 22;
    callback set-size(int);
    /// What the size number box shows, and whether it has the keyboard (for tests).
    out property <string> size-text: size-box.shown;
    out property <bool> size-editing: size-box.editing;
    /// A press on a blank part of the tab: the number box under edit lets go of the keyboard.
    callback blank-pressed();
    in-out property <int> tape: 0;
    /// Letter spacing: 0 Tight, 1 Normal, 2 Loose (as `LetterSpacing` in src/storage/db.rs).
    in-out property <int> spacing: 1;
    callback set-spacing(int);
    /// -1 none, 0 the font list, 1 the tape list.
    in-out property <int> open-list: -1;
    // The preview's 24px at Font size 22, scaled like the notes' text.
    out property <length> preview-font-size: 24px * root.size / 22;
    out property <float> bottom: root.spacing-row-y + spacing-row.total;

    property <[string]> fonts: ["Shadows Into Light", "Patrick Hand", "Caveat", "Gloria Hallelujah", "Indie Flower", "Kalam"];

    // The preview card: 16px / 16px / 14px padding around the little paper (12px / 18px padding, the
    // text on 1.4 lines).
    // The card is as tall as the preview text is at Font size 22, whatever the size: the rows below
    // stay where they are while the slider is dragged, and a bigger preview is cut at the card.
    property <float> text-h: base-t.preferred-height / 1px;
    property <float> card-h: 16.0 + (24.0 + root.text-h) + 14.0;
    property <float> rows-y: root.top + root.card-h + 18.0;
    // Each plain row is 56px and its 2px rule.
    property <float> row-pitch: 58.0;
    out property <float> font-row-y: root.rows-y;
    out property <float> size-row-y: root.rows-y + root.row-pitch;
    out property <float> tape-row-y: root.rows-y + 2.0 * root.row-pitch;
    // Letter spacing comes last, under the rows the mockup has.
    out property <float> spacing-row-y: root.rows-y + 3.0 * root.row-pitch;
    /// The extra space after each letter, in em, for each choice (the values of src/storage/db.rs).
    property <[float]> spacing-em: [-0.03, 0.0, 0.08];
    /// The lowest point either open list reaches (paper coordinates): the lists hang 48px under their
    /// button, 6px of padding around six or four 42px entries.
    out property <float> lists-bottom: max(root.font-row-y + 6.0 + 48.0 + 12.0 + 6 * 42.0, root.tape-row-y + 6.0 + 48.0 + 12.0 + 4 * 42.0);

    x: 0px;
    y: 0px;
    width: root.pf.f.w * 1px;
    height: root.pf.f.h * 1px;

    /// Where the control `id` is, in the Paper frame's px, for tests: 0 font button, 1 to 6 font
    /// options, 7 the Font size number box, 100 + n the Font size slider where the value n is, 10 tape
    /// button, 11 to 14 tape options, 20 the Font size label (a
    /// blank part of the paper), 21 to 23 letter spacings.
    public pure function hit-x(id: int) -> length {
        return PX.x(root.pf, root.hit-a(id), root.hit-b(id));
    }
    public pure function hit-y(id: int) -> length {
        return PX.y(root.pf, root.hit-a(id), root.hit-b(id));
    }
    pure function hit-a(id: int) -> float {
        if (id == 7) {
            return 484.0 - 262.0 + 160.0 + 30.0;
        }
        if (id >= 100) {
            return 484.0 - 262.0 + size-slider.x-of(id - 100) / 1px;
        }
        if (id >= 21 && id <= 23) {
            return 484.0 - 226.4 + (id - 21 + 0.5) * 226.4 / 3.0;
        }
        if (id == 20) {
            return 140.0;
        }
        if ((id >= 1 && id <= 6) || (id >= 11 && id <= 14)) {
            return 484.0 - 130.0;
        }
        return 484.0 - 118.0;
    }
    pure function hit-b(id: int) -> float {
        if (id == 0) {
            return root.font-row-y + 28.0;
        }
        if (id >= 1 && id <= 6) {
            return root.font-row-y + 6.0 + 48.0 + 6.0 + (id - 1) * 42.0 + 21.0;
        }
        if (id == 7 || id == 20 || id >= 100) {
            return root.size-row-y + 28.0;
        }
        if (id >= 21 && id <= 23) {
            return root.spacing-row-y + 28.0;
        }
        if (id == 10) {
            return root.tape-row-y + 28.0;
        }
        if (id >= 11 && id <= 14) {
            return root.tape-row-y + 6.0 + 48.0 + 6.0 + (id - 11) * 42.0 + 21.0;
        }
        return root.font-row-y + 28.0;
    }

    // A press on a blank part of the tab ends an edit in the number box (it commits). The controls
    // are above it, so they get their own presses.
    TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.blank-pressed();
            }
        }
    }

    // ---- the preview card ----
    PRect {
        pf: root.pf;
        a: 36.0;
        b: root.top;
        w: 448.0;
        h: root.card-h;
        r: 10.8;
        fill: #F0F0EE;
    }

    PShadow {
        pf: root.pf;
        a: 52.0;
        b: root.top + 16.0;
        w: 416.0;
        h: 24.0 + root.text-h;
        dy: 6;
        spread: -6;
        blur: 10;
        alpha: 0.3;
    }

    PRect {
        pf: root.pf;
        a: 52.0;
        b: root.top + 16.0;
        w: 416.0;
        h: 24.0 + root.text-h;
        fill: #FFFFFD;
    }

    base-t := PText {
        pf: root.pf;
        visible: false;
        width: 380px;
        text: preview-t.text;
        font-size: 24px;
        letter-spacing: 24px * root.spacing-em[root.spacing];
        wrap: word-wrap;
        line-height-factor: 1.4 / TextMetrics.natural;
    }

    preview-t := PText {
        pf: root.pf;
        a: 70.0;
        b: root.top + 28.0;
        width: 380px;
        height: root.text-h * 1px;
        text: "Currently POG no Weapon : Ideal for him are Never Rest or White Night Nova.";
        font-size: root.preview-font-size;
        letter-spacing: root.preview-font-size * root.spacing-em[root.spacing];
        wrap: word-wrap;
        overflow: clip;
        line-height-factor: 1.4 / TextMetrics.natural;
    }

    // Mini tapes at the little paper's corners: -35 degrees in the paper, so the shapes carry the tilt.
    VTape {
        pf: root.pf;
        a: 52.0 + 14.0;
        b: root.top + 16.0 + 2.5;
        shape: root.tapes[1];
        base: TapePalette.a-light[root.tape];
        stripe: TapePalette.a-deep[root.tape];
    }

    VTape {
        pf: root.pf;
        a: 52.0 + 416.0 - 14.0;
        b: root.top + 16.0 + 24.0 + root.text-h - 6.5;
        shape: root.tapes[1];
        base: TapePalette.b-light[root.tape];
        stripe: TapePalette.b-deep[root.tape];
    }

    // ---- the rows ----
    size-row := SettingRow {
        pf: root.pf;
        dots: root.tapes[3];
        row-y: root.size-row-y;
        label: "Font size";
        // The group is 262 wide, right-aligned like the Font row's: slider, number box and "px".
        Rectangle {
            width: 262px;
            height: 44px;

            size-slider := PSlider {
                x: 0px;
                width: 150px;
                value <=> root.size;
                minimum: 12;
                maximum: 40;
                snaps: [14, 18, 22, 26, 30, 36];
                accessible-name: "Font size";
                committed(v) => { root.open-list = -1; root.set-size(v); }
            }

            size-box := NumberBox {
                x: 160px;
                value <=> root.size;
                minimum: 12;
                maximum: 40;
                accessible-name: "Font size in px";
                committed(v) => { root.set-size(v); }
            }

            Text {
                x: 228px;
                width: 34px;
                height: 44px;
                text: "px";
                font-family: Theme.handwriting;
                font-size: 19px;
                color: #5B616B;
                vertical-alignment: center;
            }
        }
    }

    spacing-row := SettingRow {
        pf: root.pf;
        dots: root.tapes[3];
        row-y: root.spacing-row-y;
        rule: false;
        label: "Letter spacing";
        for label[i] in ["Tight", "Normal", "Loose"] : PillButton {
            text: label;
            chosen: i == root.spacing;
            clicked => { root.spacing = i; root.open-list = -1; root.set-spacing(i); }
        }
    }

    // An outside click closes the open list. The Font and Tape color rows come after it, so pressing
    // the other button switches lists instead.
    if root.open-list >= 0 : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => { root.open-list = -1; }
    }

    font-row := SettingRow {
        pf: root.pf;
        dots: root.tapes[3];
        row-y: root.font-row-y;
        label: "Font";
        PickerButton {
            text: root.fonts[root.font];
            open: root.open-list == 0;
            clicked => { root.open-list = root.open-list == 0 ? -1 : 0; }
        }
    }

    tape-row := SettingRow {
        pf: root.pf;
        dots: root.tapes[3];
        row-y: root.tape-row-y;
        label: "Tape color";
        PickerButton {
            text: TapePalette.names[root.tape];
            open: root.open-list == 1;
            chips: true;
            chip-shape: root.tapes[2];
            chip-a-base: TapePalette.a-light[root.tape];
            chip-a-stripe: TapePalette.a-deep[root.tape];
            chip-b-base: TapePalette.b-light[root.tape];
            chip-b-stripe: TapePalette.b-deep[root.tape];
            clicked => { root.open-list = root.open-list == 1 ? -1 : 1; }
        }
    }

    // ---- the lists, last so they sit above the rows under them ----
    if root.open-list == 0 : PBox {
        pf: root.pf;
        a: 484.0 - 260.0;
        b: root.font-row-y + 6.0 + 48.0;
        width: 260px;
        height: 12px + 6 * 42px;

        ListPanel {
            height: parent.height;
            for name[i] in root.fonts : ListItem {
                x: 6px;
                y: 6px + i * 42px;
                width: parent.width - 12px;
                text: name;
                chosen: i == root.font;
                clicked => { root.font = i; root.open-list = -1; }
            }
        }
    }

    if root.open-list == 1 : PBox {
        pf: root.pf;
        a: 484.0 - 260.0;
        b: root.tape-row-y + 6.0 + 48.0;
        width: 260px;
        height: 12px + 4 * 42px;

        ListPanel {
            height: parent.height;
            for i in 4 : ListItem {
                x: 6px;
                y: 6px + i * 42px;
                width: parent.width - 12px;
                text: TapePalette.names[i];
                chosen: i == root.tape;
                chips: true;
                chip-shape: root.tapes[2];
                chip-a-base: TapePalette.a-light[i];
                chip-a-stripe: TapePalette.a-deep[i];
                chip-b-base: TapePalette.b-light[i];
                chip-b-stripe: TapePalette.b-deep[i];
                clicked => { root.tape = i; root.open-list = -1; }
            }
        }
    }
}
