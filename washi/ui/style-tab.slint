// The Font & Style tab of the Settings page (UI only).
//
// Every control here updates the preview note and nothing else: the state lives in properties of this
// component (bound to the Settings window, which is created fresh each time Settings opens, so the
// defaults come back), and no callback leaves it. Rust never reads these properties except in tests.
// Like the rest of Settings the content is laid out in the Paper's tilted frame `f` so glyphs stay
// upright on the tilted baseline; `u0`/`v0` is the content's top-left from the Paper's center.

import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import { Frame, Tilt } from "toolbar.slint";

/// One tape of the preview: its outline and stripes as path commands inside a `w` by `h` box
/// (computed in `settings/tape.rs`).
export struct TapeShape {
    outline: string,
    stripes: string,
    w: length,
    h: length,
}

export global StyleTabMetrics {
    /// Preview 112, gap 14, then five rows of 56.
    out property <length> content-h: 112px + 14px + 5 * 56px;
}

/// A closed dropdown: the chosen option and a chevron.
component PickerButton inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    callback clicked();
    width: 236px;
    height: 44px;
    border-radius: 10px;
    background: #FFFFFD;
    border-width: 1.5px;
    border-color: root.open ? #5B616B : #B9BFC8;

    Text {
        x: 14px;
        width: root.width - 46px;
        height: root.height;
        text: root.text;
        font-family: "Shadows Into Light";
        font-size: 22px;
        color: #2B2F36;
        vertical-alignment: center;
        overflow: elide;
    }

    Path {
        x: root.width - 28px;
        y: 17px;
        width: 14px;
        height: 10px;
        viewbox-width: 14;
        viewbox-height: 10;
        commands: root.open ? "M 2 8 L 7 2 L 12 8" : "M 2 2 L 7 8 L 12 2";
        stroke: #5B616B;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }

    TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

/// A row of connected choices.
component Segmented inherits Rectangle {
    in property <[string]> labels;
    in-out property <int> index;
    callback picked(int);
    width: 236px;
    height: 40px;
    border-radius: 10px;
    background: #E9ECF0;

    for label[i] in root.labels : Rectangle {
        x: i * root.width / root.labels.length;
        width: root.width / root.labels.length;
        height: root.height;
        border-radius: 10px;
        background: i == root.index ? #FFFFFD : transparent;
        border-width: i == root.index ? 1.5px : 0px;
        border-color: #5B616B;

        Text {
            text: label;
            font-family: "Shadows Into Light";
            font-size: 22px;
            font-weight: i == root.index ? 700 : 400;
            color: #2B2F36;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            mouse-cursor: pointer;
            accessible-role: radio-button;
            accessible-label: label;
            clicked => { root.index = i; root.picked(i); }
        }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 56px;
    height: 30px;
    border-radius: 15px;
    background: root.on ? #5B616B : #C9CED6;

    Rectangle {
        x: root.on ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: #FFFFFD;
    }

    TouchArea {
        mouse-cursor: pointer;
        accessible-role: switch;
        accessible-checked: root.on;
        clicked => { root.on = !root.on; root.toggled(root.on); }
    }
}

/// A strip of washi tape: a base-color parallelogram with diagonal stripes.
component MiniTape inherits Rectangle {
    in property <TapeShape> shape;
    in property <color> base;
    in property <color> stripe;
    width: root.shape.w;
    height: root.shape.h;

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.shape.w / 1px;
        viewbox-height: root.shape.h / 1px;
        commands: root.shape.outline;
        fill: root.base;
    }

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.shape.w / 1px;
        viewbox-height: root.shape.h / 1px;
        commands: root.shape.stripes;
        fill: root.stripe;
    }
}

/// An option of an open list.
component ListItem inherits Rectangle {
    in property <string> text;
    in property <bool> chosen;
    callback clicked();
    height: 44px;
    border-radius: 8px;
    background: item-hit.has-hover ? #E9ECF0 : transparent;

    Text {
        x: 12px;
        width: root.width - 24px;
        height: root.height;
        text: root.text;
        font-family: "Shadows Into Light";
        font-size: 22px;
        font-weight: root.chosen ? 700 : 400;
        color: #2B2F36;
        vertical-alignment: center;
    }

    item-hit := TouchArea {
        mouse-cursor: pointer;
        accessible-role: list-item;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

export component StyleTab inherits Rectangle {
    in property <Frame> f;
    in property <float> u0;
    in property <float> v0;
    in property <[TapeShape]> tapes;

    in-out property <int> font: 0;
    in-out property <int> size: 1;
    in-out property <int> tape: 0;
    in-out property <bool> fade: true;
    in-out property <int> ui-size: 0;
    /// -1 none, 0 the font list, 1 the tape list.
    in-out property <int> open-list: -1;
    out property <length> preview-font-size: [19px, 24px, 30px][root.size];

    property <[string]> fonts: ["Shadows Into Light", "Handwritten", "Typewriter", "Bookish serif"];
    property <[string]> tape-names: ["Pink + blue", "Yellow + green", "Lavender + peach", "Slate + rose"];
    property <[color]> tape-base: [#F4B6C8, #F6E08A, #C9B8EA, #8E9AAB];
    property <[color]> tape-stripe: [#8FB8E8, #9ACB8A, #F5C09A, #E7A3B0];

    // Layout, in px from the content's top-left.
    property <float> content-w: 448.0;
    property <float> ctl-u: 212.0;
    property <float> ctl-w: 236.0;

    x: 0px;
    y: 0px;
    width: root.f.w * 1px;
    height: root.f.h * 1px;

    pure function px(u: float, v: float) -> length {
        return Tilt.x(root.f, root.u0 + u, root.v0 + v) * 1px;
    }
    pure function py(u: float, v: float) -> length {
        return Tilt.y(root.f, root.u0 + u, root.v0 + v) * 1px;
    }
    /// The top of row `i` (row 0 is the Font row), under the preview.
    pure function row-top(i: int) -> float {
        return 126.0 + i * 56.0;
    }

    /// Where the control `id` is, in the window's px, for tests and accessibility checks: 0 font
    /// button, 1 to 4 font options, 5 to 7 text sizes, 8 tape button, 9 to 12 tape options, 13 the
    /// fade switch, 14 and 15 the UI sizes, 20 the Text size label (a blank part of the paper).
    public pure function hit-x(id: int) -> length {
        return root.px(root.hit-u(id), root.hit-v(id));
    }
    public pure function hit-y(id: int) -> length {
        return root.py(root.hit-u(id), root.hit-v(id));
    }
    pure function hit-u(id: int) -> float {
        if (id >= 5 && id <= 7) {
            return root.ctl-u + (id - 5 + 0.5) * root.ctl-w / 3.0;
        }
        if (id == 13) {
            return root.ctl-u + root.ctl-w - 28.0;
        }
        if (id == 14 || id == 15) {
            return root.ctl-u + (id - 14 + 0.5) * root.ctl-w / 2.0;
        }
        if (id == 20) {
            return 100.0;
        }
        return root.ctl-u + root.ctl-w / 2.0;
    }
    pure function hit-v(id: int) -> float {
        if (id == 0) {
            return root.row-top(0) + 28.0;
        }
        if (id >= 1 && id <= 4) {
            return root.row-top(0) + 58.0 + (id - 1) * 44.0 + 22.0;
        }
        if (id >= 5 && id <= 7) {
            return root.row-top(1) + 28.0;
        }
        if (id == 8) {
            return root.row-top(2) + 28.0;
        }
        if (id >= 9 && id <= 12) {
            return root.row-top(2) + 58.0 + (id - 9) * 44.0 + 22.0;
        }
        if (id == 13) {
            return root.row-top(3) + 28.0;
        }
        if (id == 14 || id == 15) {
            return root.row-top(4) + 28.0;
        }
        return root.row-top(1) + 28.0;
    }

    // ---- the preview note ----
    Rectangle {
        x: root.px(0.0, 0.0);
        y: root.py(0.0, 0.0);
        width: root.content-w * 1px;
        height: 112px;
        background: #FFFFFD;
        border-radius: 6px;
        border-width: 1px;
        border-color: #E3E0D6;
        drop-shadow-color: #00000030;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 3px;

        Rectangle {
            x: 24px;
            y: 18px;
            width: parent.width - 48px - (root.ui-size == 0 ? 30px : 22px);
            height: 80px;
            clip: true;

            Text {
                width: parent.width;
                text: "Washi keeps every note on a scrap of paper.";
                wrap: word-wrap;
                font-family: "Shadows Into Light";
                font-size: root.preview-font-size;
                color: #2B2F36;
            }
        }

        // Fade text edge: the text melts into the paper at the bottom.
        if root.fade : Rectangle {
            x: 1px;
            y: parent.height - 38px;
            width: parent.width - 2px;
            height: 36px;
            background: @linear-gradient(180deg, #FFFFFD00 0%, #FFFFFD 100%);
        }

        // The note's menu button: UI size makes it, and so the whole chrome, smaller.
        Rectangle {
            x: parent.width - self.width - 14px;
            y: 14px;
            width: root.ui-size == 0 ? 28px : 20px;
            height: self.width;
            border-radius: self.width / 2;
            background: #E9ECF0;
        }

        MiniTape {
            x: -14px;
            y: -10px;
            shape: root.tapes[0];
            base: root.tape-base[root.tape];
            stripe: root.tape-stripe[root.tape];
        }

        MiniTape {
            x: parent.width - self.width + 14px;
            y: parent.height - self.height + 8px;
            shape: root.tapes[1];
            base: root.tape-base[root.tape];
            stripe: root.tape-stripe[root.tape];
        }
    }

    // ---- row labels ----
    for label[i] in ["Font", "Text size", "Tape color", "Fade text edge", "UI size"] : Text {
        x: root.px(0.0, root.row-top(i));
        y: root.py(0.0, root.row-top(i));
        width: 200px;
        height: 56px;
        text: label;
        font-family: "Shadows Into Light";
        font-size: 26px;
        color: #2B2F36;
        vertical-alignment: center;
    }

    // ---- rows that are not dropdowns ----
    Segmented {
        x: root.px(root.ctl-u, root.row-top(1) + 8.0);
        y: root.py(root.ctl-u, root.row-top(1) + 8.0);
        labels: ["Small", "Medium", "Large"];
        index <=> root.size;
        picked(i) => { root.open-list = -1; }
    }

    Switch {
        x: root.px(root.ctl-u + root.ctl-w - 56.0, root.row-top(3) + 13.0);
        y: root.py(root.ctl-u + root.ctl-w - 56.0, root.row-top(3) + 13.0);
        on <=> root.fade;
    }

    Segmented {
        x: root.px(root.ctl-u, root.row-top(4) + 8.0);
        y: root.py(root.ctl-u, root.row-top(4) + 8.0);
        labels: ["Normal", "Small"];
        index <=> root.ui-size;
        picked(i) => { root.open-list = -1; }
    }

    // An outside click closes the open list. It sits under the dropdown buttons, so pressing the other
    // button switches lists instead.
    if root.open-list >= 0 : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        clicked => { root.open-list = -1; }
    }

    // ---- the dropdowns ----
    PickerButton {
        x: root.px(root.ctl-u, root.row-top(0) + 6.0);
        y: root.py(root.ctl-u, root.row-top(0) + 6.0);
        text: root.fonts[root.font];
        open: root.open-list == 0;
        clicked => { root.open-list = root.open-list == 0 ? -1 : 0; }
    }

    PickerButton {
        x: root.px(root.ctl-u, root.row-top(2) + 6.0);
        y: root.py(root.ctl-u, root.row-top(2) + 6.0);
        text: root.tape-names[root.tape];
        open: root.open-list == 1;
        clicked => { root.open-list = root.open-list == 1 ? -1 : 1; }
    }

    // The lists are drawn last, so they sit above the rows under them.
    if root.open-list == 0 : Rectangle {
        x: root.px(root.ctl-u, root.row-top(0) + 54.0);
        y: root.py(root.ctl-u, root.row-top(0) + 54.0);
        width: root.ctl-w * 1px;
        height: 184px;
        background: #FFFFFD;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: #B9BFC8;
        drop-shadow-color: #00000030;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 4px;

        for name[i] in root.fonts : ListItem {
            x: 4px;
            y: 4px + i * 44px;
            width: parent.width - 8px;
            text: name;
            chosen: i == root.font;
            clicked => { root.font = i; root.open-list = -1; }
        }
    }

    if root.open-list == 1 : Rectangle {
        x: root.px(root.ctl-u, root.row-top(2) + 54.0);
        y: root.py(root.ctl-u, root.row-top(2) + 54.0);
        width: root.ctl-w * 1px;
        height: 184px;
        background: #FFFFFD;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: #B9BFC8;
        drop-shadow-color: #00000030;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 4px;

        for name[i] in root.tape-names : ListItem {
            x: 4px;
            y: 4px + i * 44px;
            width: parent.width - 8px;
            text: name;
            chosen: i == root.tape;
            clicked => { root.tape = i; root.open-list = -1; }

            // Two flat chips tell the colorways apart.
            Rectangle {
                x: parent.width - 26px - 12px;
                y: 11px;
                width: 26px;
                height: 11px;
                background: root.tape-base[i];
            }

            Rectangle {
                x: parent.width - 26px - 12px;
                y: 22px;
                width: 26px;
                height: 11px;
                background: root.tape-stripe[i];
            }
        }
    }
}
