import "../../fonts/ShadowsIntoLight.ttf";
import "../../fonts/ShadowsIntoLight-Bold.ttf";
import "../../fonts/ShadowsIntoLight-Italic.ttf";
import "../../fonts/ShadowsIntoLight-BoldItalic.ttf";
// The edit fields' face: the handwriting's advances, no ink (see `caret-font` in theme.slint).
import "../../fonts/WashiCaret.ttf";
import { Theme } from "theme.slint";

export enum BlockKind { title, heading, body, list-item, check, checked, image }

export struct BlockData {
    kind: BlockKind,
    text: string,
    /// The field's face while an input method composes in it (headings: bold).
    bold: bool,
    /// An image block: the picture (empty while the note is suspended) and its size in pixels,
    /// which sets the block's height (the text-area width times the aspect ratio).
    img: image,
    /// The same picture turned by the text's tilt (Rust: the software renderer cannot turn one),
    /// on a canvas a little larger than the picture; shown at rest.
    img-turned: image,
    img-w: int,
    img-h: int,
    /// An image's shown width in percent of the text area, and its place: 0 left, 1 center, 2 right.
    img-pct: int,
    img-align: int,
    italic: bool,
}

/// One word (or a piece of one in a single style): upright, at its level place (x, y) plus the
/// offset (dx, dy) that puts it on the tilted baseline at rest.
export struct RunData {
    /// The block it belongs to.
    block: int,
    text: string,
    x: length,
    y: length,
    dx: length,
    dy: length,
    width: length,
    size: length,
    pitch: length,
    bold: bool,
    italic: bool,
    /// The empty-note hint rather than note text.
    hint: bool,
    /// The run's ink (the palette's, `Theme.ink` for the default).
    ink: color,
    /// The text of a ticked check item: drawn in `Theme.ink-done`.
    done: bool,
}

/// The box of a check item: a level box in the paper's frame (Rust lays it out, src/textflow.rs).
/// Drawn by the note on the tilted baseline at rest; a click on it ticks the item (Rust).
export struct CheckData {
    block: int,
    x: length,
    y: length,
    size: length,
    dx: length,
    dy: length,
    checked: bool,
}

/// A marker (highlight) behind one line's stretch of one color: a level box in the paper's frame
/// (Rust lays it out, src/textflow.rs). Drawn by the note on the tilted baseline at rest.
export struct MarkerData {
    x: length,
    y: length,
    width: length,
    height: length,
    color: color,
}

/// One level box of the selection wash, in the paper's frame (Rust lays them out, src/textflow.rs).
export struct SelRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

/// What the note needs to know of a key press besides its text: the modifiers held, and whether the
/// field has a selection of its own.
export struct KeyMods {
    shift: bool,
    control: bool,
    selecting: bool,
}

/// An underline, a strike-through or a list bullet: a level box plus the offset onto the tilted baseline.
export struct RuleData {
    block: int,
    x: length,
    y: length,
    dx: length,
    dy: length,
    width: length,
    height: length,
    /// Part of a ticked check item: drawn in `Theme.ink-done`.
    done: bool,
}

// One paragraph: an editable text field styled by its kind.
export component BlockView inherits Rectangle {
    in property <BlockKind> kind: body;
    in property <string> text;
    in property <bool> bold: false;
    in property <image> img;
    changed img => { }
    in property <image> img-turned;
    changed img-turned => { }
    in property <int> img-w: 0;
    in property <int> img-h: 0;
    in property <int> img-pct: 100;
    in property <int> img-align: 0;
    /// Ctrl+C: copy picture to clipboard.
    callback copy-image() -> bool;
    /// Ctrl+X: cut picture to clipboard and remove it from the note.
    callback cut-image() -> bool;
    /// Ctrl+V: true when the note took it (the clipboard held a picture).
    callback paste-image() -> bool;
    /// Ctrl+A: the note selects everything (a range from the start to the end).
    callback select-all();
    /// A key while the note's selection spans blocks (`wash` is off): true when the note took it.
    callback range-key(KeyEvent) -> bool;
    in property <bool> italic: false;
    /// Tilted editing: the note washes the selection itself, tilted, so the field's own wash is off.
    in property <bool> tilted: false;
    in property <bool> autofocus: false;
    /// Space above the block, in logical px (set by the stack from the kinds around it).
    in property <length> gap-before: 0px;
    /// The level text field is drawn only while editing; at rest the stepped words are.
    in property <bool> show-input: true;
    /// The text changed: the new text and where the caret is now.
    callback edited(string, int);
    /// A key the field did not take itself was pressed (the key's text, the modifiers, the caret's
    /// byte offset); true when the note moved the caret or edited the text (the field then does nothing).
    callback key(string, KeyMods, int) -> bool;
    /// Undo (false) or redo (true): the note keeps the history, not the field.
    callback history(bool);
    /// Make this block take the focus with the caret at `focus-offset` whenever `focus-serial` changes.
    in property <bool> wanted: false;
    in property <int> focus-serial: 0;
    in property <int> focus-offset: 0;
    /// The selection's other end when the field is focused from code; -1: none (just a caret).
    in property <int> focus-anchor: -1;
    /// The field draws its own selection (off while the note draws a selection across blocks).
    in property <bool> wash: true;
    callback focus-changed(bool);
    /// The caret of this block's field moved, or its selection changed: the caret's byte offset
    /// and the selection's other end (the same offset when nothing is selected).
    callback caret-moved(int, int);
    /// An input method started (true) or ended composing in the field. While it composes, the
    /// field shows its own text (the words drawn by the note cannot show what is being composed).
    callback composing-changed(bool);
    out property <bool> composing: input.preedit-text != "";
    changed composing => { root.composing-changed(root.composing); }
    /// Bumped to make the field state its focus again (after a suspension).
    in property <int> resync: 0;
    changed resync => { root.focus-changed(input.has-focus); }

    property <length> size: kind == BlockKind.title ? Theme.title-size
        : kind == BlockKind.heading ? Theme.heading-size : Theme.body-size;
    /// The caret (the note's layout: x and line box in the text layer, where its text starts at
    /// `Theme.text-inset-left`), whether this block is the note's focused one and holds it, and a
    /// counter that changes whenever it moves. It is drawn here, not by the field (see TextLayer),
    /// and kept while the note is suspended, like the rest of its look.
    in property <SelRect> caret;
    in property <bool> caret-here: false;
    in property <int> caret-serial: 0;
    /// The blink: lit for half a second, dark for half a second, lit anew whenever the caret moves.
    /// It flips only while the field has the focus right now: the window going inactive stops it at
    /// once, before the note hears of the focus loss, so a note about to be suspended stays as drawn.
    property <bool> caret-lit: true;
    caret-blink := Timer {
        interval: 500ms;
        running: root.caret-here && input.has-focus && root.show-input && !root.composing;
        triggered => { if (input.has-focus) { root.caret-lit = !root.caret-lit; } }
    }
    changed caret-serial => { root.caret-lit = true; caret-blink.restart(); }
    /// The window's scale factor. The lines step by whole physical pixels: the pitch is snapped to
    /// them here and in src/textflow.rs, so the field's caret and selection stay on the words.
    in property <float> pitch-scale: 1;
    property <length> pitch: Math.round((kind == BlockKind.title ? Theme.title-pitch
        : kind == BlockKind.heading ? Theme.heading-pitch : Theme.body-pitch) / 1px * root.pitch-scale) / root.pitch-scale * 1px;
    /// The field's lines. The field itself reports its height rounded up to a whole logical px,
    /// which at a fractional scale is more than its lines take (a 28.8 px line counts as 29): with
    /// that height every block would start a fraction of a pixel lower than the words the app lays
    /// out, and the caret would sink further below its line with every paragraph. So the block's
    /// height is counted in lines.
    property <int> lines: max(1, Math.round(input.preferred-height / root.pitch));

    property <bool> focused: input.has-focus || image-focus.has-focus;
    property <bool> reported: false;
    // Tell the layer about focus changes, once each (Slint raises no change for the initial state).
    function report() {
        if (root.focused != root.reported) {
            root.reported = root.focused;
            root.focus-changed(root.reported);
            // the caret is in this field now: where it is and what is selected
            if (root.reported) { root.caret-moved(root.kind == BlockKind.image ? 0 : input.cursor-position-byte-offset, root.kind == BlockKind.image ? 0 : input.anchor-position-byte-offset); }
        }
    }
    changed focused => { root.report(); root.drop-selection(); if (input.has-focus) { root.caret-lit = true; } }
    changed wanted => { root.drop-selection(); }
    // Slint keeps a field's selection when the focus moves to another field from code; the note's
    // selection is somewhere else now, so nothing may stay selected here (it would be washed twice).
    function drop-selection() {
        if (!root.focused && !root.wanted && root.kind != BlockKind.image) {
            input.set-selection-offsets(input.cursor-position-byte-offset, input.cursor-position-byte-offset);
        }
    }

    property <length> image-width: root.width * root.img-pct / 100;
    property <length> image-height: root.img-w > 0 ? root.image-width * root.img-h / root.img-w : 0px;
    preferred-height: root.gap-before + (root.kind == BlockKind.image ? root.image-height : root.lines * root.pitch);

    // A selected picture has no text field: this takes the keyboard focus instead, so Backspace and
    // Delete remove the picture, Ctrl+C / Ctrl+X copy/cut it, and the arrows leave it.
    image-focus := FocusScope {
        enabled: root.kind == BlockKind.image;
        key-pressed(e) => {
            if (e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && !e.modifiers.shift) {
                if (e.text == "c" || e.text == "\u{3}") {
                    return root.copy-image() ? accept : reject;
                }
                if (e.text == "x" || e.text == "\u{18}") {
                    return root.cut-image() ? accept : reject;
                }
            }
            if (e.modifiers.alt || e.modifiers.meta) { return reject; }
            root.key(e.text, { shift: e.modifiers.shift, control: e.modifiers.control, selecting: false }, 0) ? accept : reject
        }
    }

    /// How much of the paper's tilt a picture still carries (1 at rest, 0 while editing), and what
    /// it needs to turn about the paper's center like the words do (see text.slint).
    in property <float> tilt-scale: 0;
    in property <length> paper-w: 0px;
    in property <length> paper-h: 0px;
    in property <angle> tilt: 0deg;
    in property <length> scroll-y: 0px;
    in property <length> shift-x: 0px;
    in property <length> shift-y: 0px;

    // The paper's tilted top edge in TextLayer coordinates, matching text.slint.
    pure function edge-y(x: length) -> length {
        return (x - root.paper-w / 2 - root.paper-h / 2 * root.tilt.sin()) * root.tilt.tan()
            + root.paper-h / 2 * (1 - root.tilt.cos()) + root.scroll-y;
    }

    property <length> image-x: root.img-align == 0 ? 0px : root.img-align == 1 ? (root.width - root.image-width) / 2 : root.width - root.image-width;
    // the picture's center in the text layer, and how far the paper's tilt moves it
    property <length> center-x: Theme.text-inset-left + root.image-x + root.image-width / 2 - root.paper-w / 2;
    property <length> center-y: Theme.text-inset-top + root.y + root.gap-before + root.image-height / 2 - root.paper-h / 2;
    property <length> tilt-dx: root.center-x * (Theme.text-tilt.cos() - 1) - root.center-y * Theme.text-tilt.sin();
    property <length> tilt-dy: root.center-x * Theme.text-tilt.sin() + root.center-y * (Theme.text-tilt.cos() - 1);

    // Level while editing (like the words); at rest the turned copy, its center where the paper's
    // tilt puts the picture's center. They swap halfway through the settle.
    property <bool> turned: root.tilt-scale > 0.5 && root.img-turned.width > 0;
    // The level picture (editing, or the first half of the settle) is cut along the paper's tilted
    // top edge too: while editing the paper stays tilted but the picture is level, so scrolled
    // under the top it would stick out of the paper at the high end of the edge.
    property <length> level-x: root.image-x + (root.tilt-dx + root.shift-x) * root.tilt-scale;
    property <length> level-y: root.gap-before + (root.tilt-dy + root.shift-y) * root.tilt-scale;
    property <bool> level-clipped: root.level-y < root.edge-y(Theme.text-inset-left + root.level-x + root.image-width) - Theme.text-inset-top - root.y
        || root.level-y < root.edge-y(Theme.text-inset-left + root.level-x) - Theme.text-inset-top - root.y;
    if root.kind == BlockKind.image && !root.turned && !root.level-clipped: Image {
        x: root.level-x;
        y: root.level-y;
        width: root.image-width;
        height: root.image-height;
        source: root.img;
        image-fit: fill;
        // Evaluated as soon as it changes (the event loop runs change handlers right after the
        // timer that suspended the app), so freed pixels are let go at once, not at the next redraw,
        // which a minimized window never gets.
        changed source => { }
    }

    if root.kind == BlockKind.image && !root.turned && root.level-clipped: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        for col in 64: Rectangle {
            property <length> strip-w: root.image-width / 64;
            property <length> local-edge: root.edge-y(Theme.text-inset-left + root.level-x + (col + 0.5) * self.strip-w) - Theme.text-inset-top - root.y;
            property <length> cut: max(root.level-y, self.local-edge);

            x: root.level-x + col * self.strip-w;
            y: self.cut;
            width: self.strip-w + 0.5px;
            height: max(0px, root.level-y + root.image-height - self.cut);
            clip: true;

            Image {
                x: -col * parent.strip-w;
                y: root.level-y - parent.cut;
                width: root.image-width;
                height: root.image-height;
                source: root.img;
                image-fit: fill;
                changed source => { }
            }
        }
    }

    // At rest, the turned picture is cut along the paper's tilted edge in narrow vertical strips
    // (stepping along edge-y, like stepped text). This keeps the top cut parallel to the tilted picture
    // so the border stays even as it scrolls off the top of the paper.
    // When fully below the top edge, a single Image is drawn to keep rendering lightweight.
    property <float> k: root.img-w > 0 ? root.image-width / 1px / root.img-w : 0;
    property <length> turned-w: root.k > 0 ? root.img-turned.width * root.k * 1px : 0px;
    property <length> turned-h: root.k > 0 ? root.img-turned.height * root.k * 1px : 0px;
    property <length> turned-x: root.image-x + (root.image-width - self.turned-w) / 2 + (root.tilt-dx + root.shift-x) * root.tilt-scale;
    property <length> turned-y: root.gap-before + (root.image-height - self.turned-h) / 2 + (root.tilt-dy + root.shift-y) * root.tilt-scale;
    property <bool> top-clipped: root.turned-y < root.edge-y(Theme.text-inset-left + root.turned-x + root.turned-w) - Theme.text-inset-top - root.y;

    if root.kind == BlockKind.image && root.turned && !root.top-clipped: Image {
        x: root.turned-x;
        y: root.turned-y;
        width: root.turned-w;
        height: root.turned-h;
        source: root.img-turned;
        image-fit: fill;
        changed source => { }
    }

    if root.kind == BlockKind.image && root.turned && root.top-clipped: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        for col in 64: Rectangle {
            property <length> strip-w: root.turned-w / 64;
            property <length> strip-cx: root.turned-x + (col + 0.5) * self.strip-w;
            property <length> local-edge: root.edge-y(Theme.text-inset-left + self.strip-cx) - Theme.text-inset-top - root.y;
            property <length> cut: max(root.turned-y, self.local-edge);

            x: root.turned-x + col * self.strip-w;
            y: self.cut;
            width: self.strip-w + 0.5px;
            height: max(0px, root.turned-y + root.turned-h - self.cut);
            clip: true;

            Image {
                x: -col * parent.strip-w;
                y: root.turned-y - parent.cut;
                width: root.turned-w;
                height: root.turned-h;
                source: root.img-turned;
                image-fit: fill;
                changed source => { }
            }
        }
    }

    input := TextInput {
        // a check item's text is indented to leave room for its box (src/textflow.rs CHECK_INDENT)
        x: root.kind == BlockKind.check || root.kind == BlockKind.checked ? Theme.check-indent : 0px;
        y: root.gap-before;
        width: parent.width - self.x;
        height: root.lines * root.pitch;
        wrap: word-wrap;
        single-line: false;
        text: root.text;
        // The words (each in its own style) are drawn by the note from its own layout; the field
        // lays its text out in a blank face with the same advances, so its caret and selection
        // sit on those words. While an input method composes it shows its own text instead.
        font-family: root.composing ? Theme.handwriting : Theme.caret-font;
        font-size: root.size;
        font-weight: root.composing && root.bold ? 700 : 400;
        font-italic: root.composing && root.italic;
        // the same spacing as the words, or the field would break its lines elsewhere
        letter-spacing: root.size * Theme.letter-spacing-em;
        // the factor is of the face's own line height, and the two faces differ in it
        line-height-factor: root.pitch / (root.size * (root.composing ? Theme.handwriting-line-em : Theme.caret-line-em));
        color: Theme.ink;
        // the note draws the caret (see TextLayer); the field's own shows only inside the text an
        // input method is composing
        text-cursor-width: root.composing ? max(Theme.caret-width, 1phx) : 0px;
        // see-through: the words under it stay readable
        selection-background-color: root.wash && !root.tilted ? Theme.selection-over : transparent;
        selection-foreground-color: Theme.ink;
        // hidden, not removed: a click still lands in the field and starts editing
        opacity: root.show-input ? 1 : 0;
        // an image has no text field
        visible: root.kind != BlockKind.image;
        edited => { root.edited(self.text, self.cursor-position-byte-offset); }
        changed cursor-position-byte-offset => {
            if (self.has-focus) { root.caret-moved(self.cursor-position-byte-offset, self.anchor-position-byte-offset); }
        }
        changed anchor-position-byte-offset => {
            if (self.has-focus) { root.caret-moved(self.cursor-position-byte-offset, self.anchor-position-byte-offset); }
        }
        key-pressed(e) => {
            if (e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && (e.text == "v" || e.text == "\u{16}") && root.paste-image()) {
                return accept;
            }
            if (!root.wash && root.range-key(e)) {
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && !e.modifiers.meta && (e.text == "a" || e.text == "\u{1}")) {
                root.select-all();
                return accept;
            }
            // Ctrl+Z undoes, Ctrl+Y (or Ctrl+Shift+Z) redoes: the note keeps the history, not the field
            if (e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                if (!e.modifiers.shift && (e.text == "z" || e.text == "\u{1a}")) {
                    root.history(false);
                    return accept;
                }
                if ((!e.modifiers.shift && (e.text == "y" || e.text == "\u{19}"))
                    || (e.modifiers.shift && (e.text == "z" || e.text == "Z" || e.text == "\u{1a}"))) {
                    root.history(true);
                    return accept;
                }
            }
            // Every other key goes to the note, which knows which ones it moves or edits with
            if (e.modifiers.alt || e.modifiers.meta) { return reject; }
            root.key(e.text, {
                shift: e.modifiers.shift,
                control: e.modifiers.control,
                selecting: self.cursor-position-byte-offset != self.anchor-position-byte-offset,
            }, self.cursor-position-byte-offset) ? accept : reject
        }
    }

    // the caret: the box of its line, over the field, cut along the paper's tilted top edge like the
    // wash. Nothing is drawn while an input method composes (the field shows its own caret then).
    // The tilt moves the caret like the words (by `tilt-scale`, the offset of the caret's center): it
    // stays an upright bar, a 1.45 degree lean over a line is under a pixel.
    property <length> caret-cx: root.caret.x - root.paper-w / 2;
    property <length> caret-cy: root.caret.y + root.caret.height / 2 - root.paper-h / 2;
    property <length> caret-dx: (root.caret-cx * (Theme.text-tilt.cos() - 1) - root.caret-cy * Theme.text-tilt.sin() + root.shift-x) * root.tilt-scale;
    property <length> caret-dy: (root.caret-cx * Theme.text-tilt.sin() + root.caret-cy * (Theme.text-tilt.cos() - 1) + root.shift-y) * root.tilt-scale;

    if root.caret-here && root.show-input && !root.composing && root.caret-lit: Rectangle {
        property <length> x0: root.caret.x + root.caret-dx - Theme.text-inset-left;
        property <length> y0: root.caret.y + root.caret-dy - Theme.text-inset-top - root.y;
        property <length> cut: max(self.y0, root.edge-y(Theme.text-inset-left + self.x0) - Theme.text-inset-top - root.y);
        x: self.x0;
        y: self.cut;
        // never thinner than a screen pixel: below 100% a 1px bar covers no pixel centre at some x and is not drawn
        width: max(Theme.caret-width, 1phx);
        height: max(0px, self.y0 + root.caret.height - self.cut);
        background: Theme.ink;
    }

    // Rust changed the text (a merge, a paste): the field shows it.
    changed text => {
        if (input.text != root.text) { input.text = root.text; }
    }

    function take-focus() {
        if (root.kind == BlockKind.image) { image-focus.focus(); return; }
        input.focus();
        input.set-selection-offsets(root.focus-anchor >= 0 ? root.focus-anchor : root.focus-offset, root.focus-offset);
    }
    changed focus-serial => { if (root.wanted) { root.take-focus(); } }

    init => {
        if (root.wanted && root.focus-serial > 0) { root.take-focus(); } else if (root.autofocus) { input.focus(); }
        root.report();
    }
}
