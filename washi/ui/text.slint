import { Theme } from "theme.slint";
import { BlockData, BlockKind, BlockView, MarkerData, RuleData, RunData, SelRect } from "block.slint";

// A marker: a rounded rectangle (radius 3) of one line's stretch. At rest the paper is tilted and
// the renderer cannot rotate elements, so it is one Path whose corners are moved onto the tilted
// baseline (like the toolbar's shapes): one shape for the whole stretch, so no seams between the
// pieces the words are drawn in. `ts` is how much of the tilt is still on (1 at rest, 0 editing).
component MarkerShape inherits Path {
    in property <MarkerData> m;
    in property <float> ts;
    in property <length> shift-x;
    in property <length> shift-y;
    in property <length> paper-w;
    in property <length> paper-h;
    property <float> r: 3;
    property <float> sn: Theme.text-tilt.sin();
    property <float> cs: Theme.text-tilt.cos();
    property <float> u0: root.m.x / 1px;
    property <float> v0: root.m.y / 1px;
    property <float> u1: (root.m.x + root.m.width) / 1px;
    property <float> v1: (root.m.y + root.m.height) / 1px;
    // the point (u, v) of the level layout on the (partly) tilted baseline
    pure function px(u: float, v: float) -> float {
        return u + ((u - root.paper-w / 2px) * (root.cs - 1) - (v - root.paper-h / 2px) * root.sn + root.shift-x / 1px) * root.ts;
    }
    pure function py(u: float, v: float) -> float {
        return v + ((u - root.paper-w / 2px) * root.sn + (v - root.paper-h / 2px) * (root.cs - 1) + root.shift-y / 1px) * root.ts;
    }
    // the shape's own box: around the tilted rectangle (it is as high as the rectangle plus the
    // drop along its width), so the Path is only as big as the marker
    property <float> ox: px(root.u0, root.v0) - 6;
    property <float> oy: py(root.u0, root.v0) - 6;
    x: root.ox * 1px;
    y: root.oy * 1px;
    width: (root.u1 - root.u0 + 12) * 1px;
    height: (root.v1 - root.v0 + (root.u1 - root.u0) * root.sn + 12) * 1px;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    fill: root.m.color;
    MoveTo { x: px(root.u0 + root.r, root.v0) - root.ox; y: py(root.u0 + root.r, root.v0) - root.oy; }
    LineTo { x: px(root.u1 - root.r, root.v0) - root.ox; y: py(root.u1 - root.r, root.v0) - root.oy; }
    ArcTo { radius-x: root.r; radius-y: root.r; sweep: true; x: px(root.u1, root.v0 + root.r) - root.ox; y: py(root.u1, root.v0 + root.r) - root.oy; }
    LineTo { x: px(root.u1, root.v1 - root.r) - root.ox; y: py(root.u1, root.v1 - root.r) - root.oy; }
    ArcTo { radius-x: root.r; radius-y: root.r; sweep: true; x: px(root.u1 - root.r, root.v1) - root.ox; y: py(root.u1 - root.r, root.v1) - root.oy; }
    LineTo { x: px(root.u0 + root.r, root.v1) - root.ox; y: py(root.u0 + root.r, root.v1) - root.oy; }
    ArcTo { radius-x: root.r; radius-y: root.r; sweep: true; x: px(root.u0, root.v1 - root.r) - root.ox; y: py(root.u0, root.v1 - root.r) - root.oy; }
    LineTo { x: px(root.u0, root.v0 + root.r) - root.ox; y: py(root.u0, root.v0 + root.r) - root.oy; }
    ArcTo { radius-x: root.r; radius-y: root.r; sweep: true; x: px(root.u0 + root.r, root.v0) - root.ox; y: py(root.u0 + root.r, root.v0) - root.oy; }
    Close { }
}

// The note's text, in the paper's frame (fixed insets, not proportions of the size). `width` and
// `height` are the paper's.
//
// The mockup text is tilted with the paper but the software renderer cannot rotate text
// (slint#6068). At rest every word is therefore its own upright Text on the tilted baseline
// (`runs`, laid out by src/textflow.rs). While a field has the focus the words' offsets settle to
// 0 and the stock level TextInputs lie over them: their text is in a blank face with the same
// advances, so they only show the caret and the selection (caret, selection and IME stay Slint's),
// and every word keeps its own style (bold, italic...) while editing too.
export component TextLayer inherits Rectangle {
    in property <[BlockData]> blocks;
    in property <[RunData]> runs;
    in property <[RuleData]> rules;
    /// Highlights behind the words, and the boxes where the selection's wash meets them (Rust).
    in property <[MarkerData]> markers;
    in property <[SelRect]> marker-wash;
    /// A field took the focus: the caret is in this block now.
    callback focus-entered(int);
    /// While the note is suspended (covered, minimized) losing the focus does not change its look.
    in property <bool> suspended: false;
    in property <int> resync: 0;
    in property <float> pitch-scale: 1;
    /// What the paper's tilted top edge needs to cut the resting words along it: the paper's own
    /// size, its tilt and how far the note is scrolled (this layer sits at -scroll-y in the paper).
    in property <length> paper-w: root.width;
    in property <length> paper-h: root.height;
    in property <angle> tilt: 0deg;
    in property <length> scroll-y: 0px;
    callback block-edited(int, string, int);
    callback block-key(int, string, int) -> bool;
    /// The caret moved or the selection changed: block, caret byte offset, the selection's other end.
    callback caret-moved(int, int, int);
    /// The block whose field an input method is composing in (-1 none): it shows its own text.
    property <int> composing-block: -1;
    /// Rust asks for the focus: block, caret offset, and a counter that changes with each request.
    in property <int> focus-block: -1;
    in property <int> focus-offset: 0;
    in property <int> focus-serial: 0;
    /// With the request: the selection's other end (-1: none), and whether the fields draw their own
    /// selection (false while the note draws a selection across blocks).
    in property <int> focus-anchor: -1;
    in property <bool> wash: true;
    /// The note owns the pointer (Rust makes the selection): a left press (in this layer's
    /// frame, with Shift held or not), a drag with the button down, and the release.
    callback pointer-down(length, length, bool);
    callback pointer-drag(length, length);
    callback pointer-up();
    /// The overlay takes every pointer event, so what the paper listens to is forwarded.
    callback right-click(length, length);
    callback pointer-moved();
    /// Ctrl+V in a field: true when the note took it (a picture on the clipboard).
    callback paste-image() -> bool;
    /// The wash of the note's selection (Rust): one level box per line the selection touches.
    in property <[SelRect]> sel-rects;
    /// Ctrl+A: the note selects everything.
    callback select-all();
    /// The selection across blocks as plain lines (Rust), for copying.
    callback range-text() -> string;
    /// Replace the selection across blocks by this text (typing, pasting, cutting).
    callback range-replace(string);
    /// A key over a selection across blocks, as its text and whether Shift is held (Rust): 1 taken
    /// without a change (a modifier key alone, an arrow that collapses the selection), 2 the key
    /// replaced the selection, 0 any other key.
    callback range-key(string, bool) -> int;
    // The clipboard goes through a field of Slint's, so no platform code is needed.
    clipboard := TextInput {
        visible: false;
        single-line: false;
        width: 10px;
        height: 10px;
    }
    /// The block that last had the focus (-1 none yet): where the image button inserts.
    in-out property <int> last-focused: -1;

    // The block whose field has the focus, -1 for none. (Not a count: blocks that vanish with the
    // model never report losing the focus.)
    in-out property <int> focused-block: -1;
    // 0 at rest, 1 while editing
    property <float> flat: focused-block >= 0 ? 1 : 0;
    animate flat { duration: Theme.settle; easing: ease-in-out; }
    /// How much of the resting tilt the words still carry: 1 at rest, 0 while editing.
    out property <float> tilt-scale: 1 - flat;
    /// A field has the focus: the level inputs show instead of the tilted words.
    out property <bool> editing: root.focused-block >= 0;

    // The words' offsets (dx, dy) turn the layout about the paper's center, but the layout runs
    // down the whole note while the paper only shows a window of it: measured from the layout's
    // top, deep text would drift sideways (0.025 px per px of depth). Measured from the window
    // (the scroll position), every line sits where the tilted paper puts it.
    property <length> shift-x: root.scroll-y * Theme.text-tilt.sin();
    property <length> shift-y: root.scroll-y * (1 - Theme.text-tilt.cos());

    // The paper's tilted top edge (the paper turns clockwise around its center), as a y in this
    // layer at the given x. The level clip of the note's text view cannot follow it.
    pure function edge-y(x: length) -> length {
        return (x - root.paper-w / 2 - root.paper-h / 2 * root.tilt.sin()) * root.tilt.tan()
            + root.paper-h / 2 * (1 - root.tilt.cos()) + root.scroll-y;
    }

    // the selection wash, level (a selection can only be made while editing), under the words
    for s in root.sel-rects: Rectangle {
        x: s.x;
        y: s.y;
        width: s.width;
        height: s.height;
        background: Theme.selection;
    }

    // the markers: over the paper (and the opaque wash of a selection across blocks), under the words
    for m in root.markers: MarkerShape {
        m: m;
        ts: root.tilt-scale;
        shift-x: root.shift-x;
        shift-y: root.shift-y;
        paper-w: root.paper-w;
        paper-h: root.paper-h;
        visible: self.y + self.height >= root.edge-y(self.x + self.width / 2);
    }

    // where the selection across blocks meets a marker: the wash again, see-through, so the marker
    // shows tinted (a selection inside one field is washed by the field over the marker anyway)
    for s in root.marker-wash: Rectangle {
        x: s.x;
        y: s.y;
        width: s.width;
        height: s.height;
        background: Theme.selection-over;
    }

    // Each resting word is cut along that edge on its own (they are at most a few pixels wide per
    // step, so the cut follows the tilt within a pixel).
    for r in root.runs: Rectangle {
        property <length> pad: 4px;
        property <length> top: r.y + (r.dy + root.shift-y) * root.tilt-scale - self.pad;
        property <length> cut: max(self.top, root.edge-y(r.x + (r.dx + root.shift-x) * root.tilt-scale + r.width / 2));
        visible: r.block != root.composing-block;
        clip: true;
        x: r.x + (r.dx + root.shift-x) * root.tilt-scale - self.pad;
        y: self.cut;
        width: r.width + 2 * self.pad;
        height: max(0px, r.pitch + 2 * self.pad - (self.cut - self.top));

        Text {
            x: parent.pad;
            y: parent.top - parent.cut + parent.pad;
            text: r.text;
            wrap: no-wrap;
            font-family: Theme.handwriting;
            font-size: r.size;
            font-weight: r.bold ? 700 : 400;
            font-italic: r.italic;
            line-height-factor: r.pitch / (r.size * Theme.handwriting-line-em);
            color: r.hint ? Theme.ink-hint : r.ink;
        }
    }

    // underlines, strike-throughs and list bullets: drawn by the app, level while editing
    for r in root.rules: Rectangle {
        x: r.x + (r.dx + root.shift-x) * root.tilt-scale;
        y: r.y + (r.dy + root.shift-y) * root.tilt-scale;
        visible: r.block != root.composing-block && self.y >= root.edge-y(self.x + self.width / 2);
        width: r.width;
        height: r.height;
        border-radius: min(r.width, r.height) / 2;
        background: Theme.ink;
    }

    /// Where the edit fields actually end (the bottom of the last one), in this layer. The note
    /// scrolls at least this far, even if the app's own layout counted fewer lines.
    out property <length> fields-bottom: stack.y + stack.preferred-height;

    stack := VerticalLayout {
        x: Theme.text-inset-left;
        y: Theme.text-inset-top;
        width: root.width - Theme.text-inset-left - Theme.text-inset-right;
        // its own height, never the layer's: a layer too short would squeeze the fields together
        height: self.preferred-height;
        alignment: start;
        for b[i] in root.blocks: BlockView {
            kind: b.kind;
            text: b.text;
            bold: b.bold;
            img: b.img;
            img-w: b.img-w;
            img-h: b.img-h;
            paste-image => { return root.paste-image(); }
            pitch-scale: root.pitch-scale;
            select-all => { root.select-all(); }
            range-key(e) => {
                if (e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && !e.modifiers.shift) {
                    if (e.text == "a" || e.text == "\u{1}") { root.select-all(); return true; }
                    if (e.text == "c" || e.text == "\u{3}" || e.text == "x" || e.text == "\u{18}") {
                        clipboard.text = root.range-text();
                        clipboard.select-all();
                        clipboard.copy();
                        if (e.text == "x" || e.text == "\u{18}") { root.range-replace(""); }
                        return true;
                    }
                    if (e.text == "v" || e.text == "\u{16}") {
                        clipboard.text = "";
                        clipboard.paste();
                        root.range-replace(clipboard.text);
                        return true;
                    }
                }
                if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) {
                    // undo or redo, a format, a new note: not ours; the selection stays
                    return false;
                }
                return root.range-key(e.text, e.modifiers.shift) != 0;
            }
            italic: b.italic;
            autofocus: i == 0;
            show-input: root.flat >= 1;
            resync: root.resync;
            // A run of the same kind is one rhythm (line pitch); a change of kind opens a gap.
            gap-before: i == 0 || root.blocks[i - 1].kind == b.kind || (root.blocks[i - 1].kind == BlockKind.list-item && b.kind == BlockKind.body) || (root.blocks[i - 1].kind == BlockKind.body && b.kind == BlockKind.list-item) ? 0px
                : b.kind == BlockKind.heading ? Theme.heading-gap : Theme.body-gap;
            wanted: i == root.focus-block;
            focus-serial: root.focus-serial;
            focus-offset: root.focus-offset;
            focus-anchor: root.focus-anchor;
            wash: root.wash;
            edited(t, c) => { root.block-edited(i, t, c); }
            key(k, o) => { return root.block-key(i, k, o); }
            caret-moved(o, a) => { root.caret-moved(i, o, a); }
            composing-changed(c) => {
                if (c) { root.composing-block = i; } else if (root.composing-block == i) { root.composing-block = -1; }
            }
            focus-changed(f) => {
                if (f) { root.focused-block = i; root.last-focused = i; root.focus-entered(i); } else if (!root.suspended && root.focused-block == i) { root.focused-block = -1; }
            }
        }
    }

    // The note owns the pointer: transparent, over the fields (which no longer see the mouse).
    TouchArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.pointer-moved(); }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.pointer-down(self.mouse-x, self.mouse-y, e.modifiers.shift);
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                root.pointer-up();
            }
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.right-click(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) { root.pointer-drag(self.mouse-x, self.mouse-y); }
        }
    }
}
